# Release-specific values for the key windows. Copy this file to ~/daemonarchy-builder-vm/key-windows.env on the key host
# and edit it for the release (or point KEYWINDOW_ENV at another file). Nothing here is secret: only labels, paths and hashes.
# A window refuses to run when a value it needs is missing; there are no defaults to carry over from the last release.
# Hashes of the key files are recorded when the keys are created or moved; the windows compare against them.

RELEASE=1.5.0                                                  # the release label (X.Y.Z)
WORK=/usr/daemonarchy/rev2-20261030                            # the release working directory on the build VM

# --- Secure Boot (boot-relabel-window.sh, boot-full-window.sh)
BOOT_KEY_SHA256=29bbdc12b754788a4577bded0127ca8fd44c7945fe33448bcdc341e184efc7cf   # sha256 of the boot signing key file
CERT_LOCAL=$HOME/daemon-local-evac/usr/daemonarchy/boot-replacement-candidate-public-20261024/daemonarchy-1.3.1.pem   # public release certificate on the key host
CERT_SHA256=26009db078d352318c06f1ea5cf7b5650dfd32137518f3a6fecd20802de2fb79        # its sha256
RELABEL_PRIOR=/usr/daemonarchy/sb16/daemonarchy-1.4.2-boot.txz                       # relabel: a bundle already signed from the current boot tree
BOOT_PRODUCT=/usr/daemonarchy/sb16/product-1e1b56d4            # full re-sign: the commit's secureboot/, scripts/import-apple-*, overlay brand lua, staged on the VM
INV_SHA256=c507dfa734d0cf90205396127a5c0dadcf87949add8c4280eb802256fad0174d          # full re-sign: sha256 of the module inventory the previous bundle was signed with
KMOD_SHA256=c784ccde397db3772206ba27809c25715aa00f86babdadcf20ad26af44427492         # full re-sign: sha256 of a kernel module the inventory must list

# --- Package feeds and extensions (feeds-arm64-window.sh, extensions-window.sh); the pinned public key is the installer's trust anchor
PIN_PUB_VM=/usr/daemonarchy/rev2-20261030/product-567870bbee41/keys/pkg-repo-1.3.1.pub   # keys/pkg-repo-1.3.1.pub on the VM
PIN_PUB_SHA256=08bfcbb3da71c63f054aa72c4c3cbc13f721fb3cd7557222dcbcbc887b79d938           # sha256 of that file
PIN_PUB_DER_SHA256=67986b400f28a49e99df0f1f3368f60aca8064d5dc00094700ba1a17d8474ef7      # sha256 of its public key in DER form
ARM_TAG=150                                                    # feeds-arm64: the arm64-ingest.sh destination tag (WORK/arm64-TAG)
EXT_DIR=ext-150                                                # extensions: staged unsigned feeds under WORK
EXT_TOOL=/usr/daemonarchy/rev2-20261030/ext-tool               # extensions: checkout with scripts/extension-bundle.py and daemonarchy_visual
EXT_REUSE=reusable-1.4.1-signatures                            # extensions: directory under EXT_DIR with earlier signatures of unchanged bundles
CHK_ARM_TAG=150r2                                              # checkout-arm64: the arm64-ingest.sh destination tag of the rebuilt checkout feed (WORK/arm64-TAG)
CHK_TAG=checkouts-16-aarch64-1.5.0-r2                          # checkout-arm64: the release tag that feed is published under (checkouts.json must name it)
