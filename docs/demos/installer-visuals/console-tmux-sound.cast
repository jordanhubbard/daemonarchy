[30.621, "o", "\u001b[32m\u001b[1m\u2588\u2588\u2588\u2588\u001b(B\u001b[m \u001b[32m\u001b[1m\u2588\u2588\u2588\u2588\u001b(B\u001b[m \u001b[32m\u001b[1m\u2588\u2588\u2588\u2588\u001b(B\u001b[m \u001b[32m\u001b[1m\u2588\u2588\u2588\u2588\u001b(B\u001b[m \u001b[32m\u001b[1m\u2588\u2588\u2588\u2588\u001b(B\u001b[m \u001b[32m\u001b[1m    \u001b(B\u001b[m          \u001b[33m\u001b[1m\u2502\u001b(B\u001b[m \u001b[34m\u001b[1m\u2502\u001b(B\u001b[m                                               \u001b[33m\u2880\u2840\u001b[39m           \u001b[33m\u28c0\u001b[30;102H\u28e4\u28f6\u001b[39m                    \u001b[33m\u28c0\u28ff\u28f8\u28c7\u001b[39m          \u001b[33m\u2880\u28ff\u001b[31;91H\u001b[1m\u28a4\u28c0\u2864\u28fc\u28c7\u28f8\u28c7\u28c0\u28c0\u28e4\u28e4\u2847\u2838\u28c4\u28e4\u28f8\u28a7\u28c0\u28e4\u28f8\u28b9\u28e0\u28c4\u28e0\u28c4\u28c0\u28c0\u28f0\u2836\u28e6\u28c4\u28c0\u28e0\u2807\u001b(B\u001b[m  \u001b[33m\u001b[1m\u28b8\u2876\u28a4\u28e4\u28c0\u28c0\u28e4\u28c0\u2874\u28c6\u28c0\u28f8\u001b(B\u001b[m \u001b[33;24H\u001b[33m\u001b[1m3.3 MB/s\u001b[34m  read \u001b[33m380.2 KB/s\u001b[37m  111\u001b[34;21H\u001b[36m2.6\u001b[35;15H\u001b[37m15%\u001b[34m   Memory \u001b[37m5.9 of 7.1 GiB\u001b[34m   ARC 3.1\u001b[37;23H\u001b[37m\u001b[44m \u263c 950 packages \u263c \u001b(B\u001b[m\u001b[34mamd-3.3.5  \u00b7 \u001b[1m suitesparse-ccolamd-3.3.\u001b(B\u001b[m\u001b[37m5  \u00b7  suitesparse-colamd-3.3.5  \u00b7  suitesparse-ch\u001b[1molmod-5.3.5\u001b(B\u001b[m"]
