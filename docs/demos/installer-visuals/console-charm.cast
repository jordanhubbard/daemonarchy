[68.715, "o", "\u28f6\u28c0\u28c0\u28e0\u28c4\u28c0\u28e4\u28f8\u28c7\u28c0\u28c0\u28e0\u28c4\u28c0\u28e0\u28c4\u28ff\u28c0\u001b[0m\u001b[32;24H\u001b[0;1;33m3.2 MB/s\u001b[0;94m  read \u001b[0;93m    0 B/s\u001b[0;97m  151\u001b[0m\u001b[33;21H\u001b[0;1;96m  0\u001b[0m\u001b[34;15H\u001b[0;97m14\u001b[0m"]
[68.801, "o", "\u001b[14;48H\u001b[0;33m \u001b[0m\u001b[16;37H\u001b[0m \u001b[0;33m \u001b[0;1;34m\u00b7\u001b[0;33m \u001b[0m\u001b[17;37H\u001b[0;1;34m\u00b7\u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;1;34m\u00b7\u001b[0;33m\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m      \u001b[0;1;33m*\u001b[0m \u001b[0;1;33m+\u001b[0m\u001b[18;83H\u001b[0;1;33m*+\u001b[0m  \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m \u001b[0;1;33m+\u001b[0m\u001b[19;20H\u001b[0;93m     \u001b[0m\u001b[20;33H\u001b[0;93m    \u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m  \u001b[0m\u001b[21;20H\u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;1;34m\u00b7\u001b[0;93m    \u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m  \u001b[0;1;34m\u00b7\u001b[0m\u001b[22;35H\u001b[0;93m  \u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m   \u001b[0;1;33m+\u001b[0m  \u001b[0;1;33m+\u001b[0m \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m \u001b[0m\u001b[23;34H\u001b[0;1;34m\u00b7\u001b[0;93m  \u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;1;34m\u00b7\u001b[0;93m    \u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m      \u001b[0;1;33m+\u001b[0m \u001b[0;93m\u2502\u001b[0;1;33m*\u001b[0;94m\u2502\u001b[0;1;33m+\u001b[0m\u001b[24;36H\u001b[0;93m \u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m\u