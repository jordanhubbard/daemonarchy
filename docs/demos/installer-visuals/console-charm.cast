[25.23, "o", "\u001b[1;18H\u001b[0;1;35mC\u001b[0;1;37m \u001b[0;1;97mH\u001b[0;1;37m \u001b[0;1;94mY\u001b[0;1;94m \u001b[0m                                                                                                                             \u001b[0;1;91m \u25b2     \u25b2 \u001b[0;1;93m \u001b[0m\u001b[2;158H\u001b[0;1;93m \u03a8\u001b[0m\u001b[3;158H\u001b[0;1;93m \u2502\u001b[0m\u001b[4;158H\u001b[0;1;93m\u2500\u2518\u001b[0m\u001b[9;103H\u001b[0;97m1.4\u001b[0m\u001b[10;122H\u001b[0;95m\u28b0\u2846\u287f\u28a4\u28c0\u2880\u28c0\u28c0\u28c0\u2880\u28c0\u28c0\u2840\u2880\u28c0\u2840\u28e0\u28c4\u28e0\u28b6\u28c0\u28c0\u28c0\u2840\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u2840\u2880\u001b[0m\u001b[11;122H\u001b[0;95m\u281a\u28e7\u2807\u2808\u28b9\u28b8\u2809\u001b[0m \u001b[0;95m\u28b8\u28b8\u001b[0m \u001b[0;95m\u281b\u28b3\u28f8\u001b[0m \u001b[0;95m\u2819\u2803\u2818\u2803\u001b[0m    \u001b[0;95m\u28b9\u2847\u2809\u2809\u001b[0m  \u001b[0;95m\u2808\u2801\u001b[0m \u001b[0;95m\u2809\u2833\u28fc\u001b[0m \u001b[0m\u001b[12;123H\u001b[0;94m\u281b\u001b[0m  \u001b[0;94m\u28b8\u284f\u001b[0m  \u001b[0;94m\u2808\u283f\u001b[0m  \u001b[0;94m\u28b8\u2847\u001b[0m         \u001b[0;94m\u28b8\u2847\u001b[0m\u001b[13;126H\u001b[0;94m\u28b8\u2847\u001b[0m      \u001b[0;94m\u28b8\u2847\u001b[0m         \u001b[0;94m\u28b8\u2847\u001b[0m\u001b[14;62H\u001b[0;33m\u2582\u2582\u2582\u2582\u2582\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                    \u001b[0;94m\u28b8\u2847\u001b[0m      \u001b[0;94m\u28b8\u2847\u001b[0m         \u001b[0;94m\u2808\u2801\u001b[0m\u001b[15;126H\u001b[0;94m\u28b8\u2847\u001b[0m      \u001b[0;94m\u28b8\u2847\u001b[0m\u001b[16;126H\u001b[0;94m\u28b8\u2847\u001b[0m      \u001b[0;94m\u2808\u2801\u001b[0m\u001b[17;126H\u001b[0;94m\u28b8\u2847\u001b[0m\u001b[18;126H\u001b[0;96m\u28b8\u2847\u001b[0m\u001b[19;126H\u001b[0;96m\u2838\