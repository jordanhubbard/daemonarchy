[28.333, "o", "\u001b[1;11H\u001b[0;1;95m \u001b[0;1;37mN\u001b[0;1;97m \u001b[0;1;37mA\u001b[0m\u001b[10;50H\u001b[0;91m\u2586\u2586\u2586\u2586\u2586\u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0;97mdisk write 113\u001b[0m\u001b[11;117H\u001b[0;95m\u28b0\u2846\u287f\u28a4\u28c0\u2880\u28c0\u28c0\u28c0\u2880\u28c0\u28c0\u2840\u2880\u28c0\u2840\u28e0\u28c4\u28e0\u28b6\u28c0\u28c0\u28c0\u2840\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u2840\u2880\u001b[0m\u001b[12;117H\u001b[0;95m\u281a\u28e7\u2807\u2808\u28b9\u28b8\u2809\u001b[0m \u001b[0;95m\u28b8\u28b8\u001b[0m \u001b[0;95m\u281b\u28b3\u28f8\u001b[0m \u001b[0;95m\u2819\u2803\u2818\u2803\u001b[0m    \u001b[0;95m\u28b9\u2847\u2809\u2809\u001b[0m  \u001b[0;95m\u2808\u2801\u001b[0m \u001b[0;95m\u2809\u2833\u28fc\u001b[0m    \u001b[0;95m\u2808\u2801\u001b[0m\u001b[13;118H\u001b[0;94m\u281b\u001b[0m  \u001b[0;94m\u28b8\u284f\u001b[0m  \u001b[0;94m\u2808\u283f\u001b[0m  \u001b[0;94m\u28b8\u2847\u001b[0m         \u001b[0;94m\u28b8\u2847\u001b[0m\u001b[14;121H\u001b[0;94m\u28b8\u2847\u001b[0m      \u001b[0;94m\u28b8\u2847\u001b[0m         \u001b[0;94m\u28b8\u2847\u001b[0m\u001b[15;62H\u001b[0;33m\u2587\u2587\u2587\u2587\u2587\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                               \u001b[0;94m\u28b8\u2847\u001b[0m      \u001b[0;94m\u28b8\u2847\u001b[0m         \u001b[0;94m\u2808\u2801\u001b[0m\u001b[16;121H\u001b[0;94m\u28b8\u2847\u001b[0m      \u001b[0;94m\u28b8\u2847\u001b[0m\u001b[17;121H\u001b[0;94m\u28b8\u2847\u001b[0m      \u001b[0;94m\u2808\u2801\u001b[0m\u001b[18;121H\u001b[0;94m\u28b8\u2847\u001b[0m\u001b[19;121H\u001b[0;96m\u28b8\u2847\u001b[0m\u001b[20;121H\u001b[0;96m\u2838\u2807\u001b[0m\u001b[21;101H\u001b[0;97m1\u001b[0m\u001b[27;118H\u001b[0;33m\u28ff\u001b[0m \u001b[