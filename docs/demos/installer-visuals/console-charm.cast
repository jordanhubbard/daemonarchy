[74.264, "o", "\u001b[1;9H\u001b[0;1;91m \u001b[0;1;37mO\u001b[0;1;97m \u001b[0;1;37mN\u001b[0m\u001b[9;105H\u001b[0;97m6\u001b[0m\u001b[10;93H\u001b[0;95m\u28c4\u2864\u2824\u28a4\u2864\u2824\u2824\u2824\u2824\u28a4\u28a0\u28e4\u283f\u28f4\u2826\u28e4\u28a4\u28a0\u2834\u28f6\u2826\u28a4\u28e4\u2864\u2824\u2824\u2844\u2864\u2824\u2824\u2824\u2824\u2824\u2844\u2880\u28e0\u2824\u2824\u2824\u28a4\u2864\u28a4\u2864\u28a4\u2864\u2824\u2836\u28e4\u2824\u28e4\u2824\u2824\u2824\u28e4\u2824\u2824\u28e4\u2824\u2824\u2824\u2824\u2824\u2824\u28c4\u2864\u001b[0m\u001b[11;93H\u001b[0;95m\u281b\u001b[0m  \u001b[0;95m\u2808\u2801\u001b[0m    \u001b[0;95m\u2808\u281b\u001b[0m  \u001b[0;95m\u28ff\u001b[0m \u001b[0;95m\u2809\u28b8\u284f\u001b[0m   \u001b[0;95m\u2808\u2801\u001b[0m   \u001b[0;95m\u28ff\u2801\u001b[0m     \u001b[0;95m\u28b3\u28f8\u001b[0m        \u001b[0;95m\u2838\u2807\u001b[0m    \u001b[0;95m\u2809\u001b[0m   \u001b[0;95m\u28ff\u001b[0m  \u001b[0;95m\u2809\u001b[0m      \u001b[0;95m\u28ff\u001b[0m \u001b[0m\u001b[12;106H\u001b[0;94m\u28ff\u001b[0m  \u001b[0;94m\u2818\u2803\u001b[0m               \u001b[0;94m\u28b8\u2847\u001b[0m                  \u001b[0;94m\u283f\u001b[0m         \u001b[0;94m\u2809\u001b[0m \u001b[0m\u001b[13;106H\u001b[0;94m\u281b\u001b[0m                   \u001b[0;94m\u28b8\u2847\u001b[0m\u001b[14;126H\u001b[0;94m\u28b8\u2847\u001b[0m\u001b[15;62H\u001b[0;33m\u2585\u2585\u2585\u2585\u2585\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                    \u001b[0;94m\u28b8\u2847\u001b[0m\u001b[16;126H\u001b[0;94m\u28b8\u2847\u001b[0m\u001b[17;73H\u001b[0m \u001b[0;1;34m\u00b7\u001b[0;33m    \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                    \u001b[0;94m\u2808\u2801\u001b[0m\u001b[20;57H\u001b[0;93m    \u001b[0m \u001b[0;93m\u2588\u2588\u2588\u001b[0;1;95m\u2502 \u001b[0;1;97m\u263c Daemonarchy is installed \u263c\u001b[0;1;95m \u2502\u001b[0;97m in 0 B/s\u001b[0m  \u001b[0m\u001b[21;55H\u001b[0m \u001b[0m\u001b[22;54H\u001b[0;1;34m\u00b7\u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;1;34m\u00b7\u001b[0m\u001b[25;2H\u001b[0;33m     \u001b[0m\u001b[26;2H\u001b[0;33m\u2584\u2584\u2584\u2584\u2584\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m\u2587\u2587\u2587\u2587\u2587\u001b[0m \u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m \u001b[0;33m     \u001b[0m\u001b[27;26H\u001b[0;92m\u2585\u2585\u2585\u2585\u2585\u001b[0m \u001b[0;92m\u2587\u2587\u2587\u2587\u2587\u001b[0m \u001b[0;92m\u2582\u2582\u2582\u2582\u2582\u001b[0m \u001b[0;92m     \u001b[0m\u001b[28;44H\u001b[0;92m\u2585\u2585\u2585\u2585\u2585\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m\u2588\u2588\u2588\u001b[0m\u001b[29;57H\u001b[0;92m\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2588\u2588\u001b[0;1;34m\u00b7\u001b[0;92m\u2588\u2588\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m      \u001b[0;33m\u28c0\u001b[0m                                                           \u001b[0;33m\u28ff\u001b[0m \u001b[0m\u001b[30;91H\u001b[0;"]
