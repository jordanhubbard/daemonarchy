[11.015, "o", "\u001b[1;2H\u001b[0;1;91mD\u001b[0;1;37m \u001b[0;1;97mA\u001b[0;1;37m \u001b[0;1;91mE \u001b[0;1;91mM \u001b[0;1;95mO \u001b[0;1;95mN\u001b[0;1;35m A\u001b[0;1;35m R\u001b[0;1;35m C\u001b[0;1;94m H\u001b[0;1;94m Y\u001b[0;1;94m \u001b[0m                                                                                                                             \u001b[0;1;91m \u25b2     \u25b2 \u001b[0;1;93m\u03a8\u001b[0m\u001b[2;158H\u001b[0;1;93m\u2502 \u001b[0m\u001b[3;158H\u001b[0;1;93m\u2502 \u001b[0m\u001b[4;158H\u001b[0;1;93m\u2518 \u001b[0m\u001b[20;20H\u001b[0;93m     \u001b[0m\u001b[22;20H\u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m\u001b[24;8H\u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m\u001b[25;8H\u001b[0;33m\u2584\u2584\u2584\u2584\u2584\u001b[0m \u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m \u001b[0;33m     \u001b[0m\u001b[26;2H\u001b[0;33m     \u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m\u2582\u2582\u2582\u2582\u2582\u001b[0m \u001b[0;33m\u2586\u2586\u2586\u2586\u2586\u001b[0m \u001b[0;33m\u2581\u2581\u2581\u2581\u2581\u001b[0m\u001b[27;2H\u001b[0;92m\u2587\u2587\u2587\u2587\u2587\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2587\u2587\u2587\u2587\u2587\u001b[0m \u001b[0;92m\u2587\u2587\u2587\u2587\u2587\u001b[0m\u001b[29;68H\u001b[0;92m\u2583\u2583\u2583\u2583\u2583\u001b[0m"]
