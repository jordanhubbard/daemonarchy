[32.964, "o", "\u001b[1;17H\u001b[0;1;35m \u001b[0;1;37mC\u001b[0;1;97m \u001b[0;1;37mH\u001b[0m\u001b[10;50H\u001b[0;91m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0;97mdisk write 114.0\u001b[0m\u001b[11;110H\u001b[0;95m\u28f6\u28b8\u2827\u28c4\u2840\u28c0\u28c0\u28c0\u2840\u28c0\u28c0\u28c0\u001b[0m \u001b[0;95m\u28c0\u28c0\u2880\u28e4\u28c0\u2874\u28c6\u28c0\u28c0\u28c0\u2880\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u001b[0m \u001b[0;95m\u28c0\u001b[0m\u001b[12;109H\u001b[0;95m\u2810\u28bb\u287c\u001b[0m \u001b[0;95m\u2809\u2847\u284f\u2801\u001b[0m \u001b[0;95m\u2847\u2847\u2818\u281b\u28c6\u2847\u2808\u281b\u001b[0m \u001b[0;95m\u281b\u001b[0m    \u001b[0;95m\u2808\u28ff\u2808\u2809\u2801\u001b[0m  \u001b[0;95m\u2809\u001b[0m \u001b[0;95m\u2808\u2819\u28a6\u2847\u001b[0m    \u001b[0;95m\u2809\u001b[0m   \u001b[0;95m\u283f\u001b[0m  \u001b[0;95m\u2808\u2801\u001b[0m\u001b[13;110H\u001b[0;94m\u2818\u2803\u001b[0m  \u001b[0;94m\u28ff\u2801\u001b[0m  \u001b[0;94m\u2839\u2807\u001b[0m  \u001b[0;94m\u28ff\u001b[0m          \u001b[0;94m\u28ff\u001b[0m \u001b[0m\u001b[14;114H\u001b[0;94m\u28ff\u001b[0m       \u001b[0;94m\u28ff\u001b[0m          \u001b[0;94m\u28ff\u001b[0m \u001b[0m\u001b[15;114H\u001b[0;94m\u28ff\u001b[0m       \u001b[0;94m\u28ff\u001b[0m          \u001b[0;94m\u2809\u001b[0m \u001b[0m\u001b[16;62H\u001b[0;33m\u2587\u2587\u2587\u2587\u2587\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                        \u001b[0;94m\u28ff\u001b[0m       \u001b[0;94m\u28ff\u001b[0m \u001b[0m\u001b[17;114H\u001b[0;94m\u28ff\u001b[0m       \u001b[0;94m\u2809\u001b[0m \u001b[0m\u001b[18;114H\u001b[0;94m\u28ff\u001b[0m \u001b[0m\u001b[19;114H\u001b[0;96m\u28ff\u001b[0m \u001b[0m\u001b[20;114H\u001b[0;96m\u283f\u001b[0m