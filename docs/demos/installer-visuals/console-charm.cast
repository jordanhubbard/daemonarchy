[34.199, "o", "\u001b[1;158H\u001b[0;1;93m \u001b[0m\u001b[2;158H\u001b[0;1;93m \u03a8\u001b[0m\u001b[3;158H\u001b[0;1;93m \u2502\u001b[0m\u001b[4;37H\u001b[0;94m4\u001b[0m                                                                                                               \u001b[0;1;94m\u2590\u2588  \u001b[0;1;97m\u25bc\u001b[0;1;94m  \u2588\u258c\u001b[0;1;93m\u2500\u2518\u001b[0m\u001b[10;50H\u001b[0;91m\u2587\u2587\u2587\u2587\u2587\u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0;97mdisk write 111.8\u001b[0m\u001b[11;108H\u001b[0;95m\u28f6\u28b8\u2827\u28c4\u2840\u28c0\u28c0\u28c0\u2840\u28c0\u28c0\u28c0\u001b[0m \u001b[0;95m\u28c0\u28c0\u2880\u28e4\u28c0\u2874\u28c6\u28c0\u28c0\u28c0\u2880\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u001b[0m \u001b[0;95m\u28c0\u001b[0m\u001b[12;107H\u001b[0;95m\u2810\u28bb\u287c\u001b[0m \u001b[0;95m\u2809\u2847\u284f\u2801\u001b[0m \u001b[0;95m\u2847\u2847\u2818\u281b\u28c6\u2847\u2808\u281b\u001b[0m \u001b[0;95m\u281b\u001b[0m    \u001b[0;95m\u2808\u28ff\u2808\u2809\u2801\u001b[0m  \u001b[0;95m\u2809\u001b[0m \u001b[0;95m\u2808\u2819\u28a6\u2847\u001b[0m    \u001b[0;95m\u2809\u001b[0m   \u001b[0;95m\u283f\u001b[0m  \u001b[0;95m\u2808\u2801\u001b[0m\u001b[13;108H\u001b[0;94m\u2818\u2803\u001b[0m  \u001b[0;94m\u28ff\u2801\u001b[0m  \u001b[0;94m\u2839\u2807\u001b[0m  \u001b[0;94m\u28ff\u001b[0m          \u001b[0;94m\u28ff\u001b[0m \u001b[0m\u001b[14;112H\u001b[0;94m\u28ff\u001b[0m       \u001b[0;94m\u28ff\u001b[0m          \u001b[0;94m\u28ff\u001b[0m \u001b[0m\u001b[15;112H\u001b[0;94m\u28ff\u001b[0m       \u001b[0;94m\u28ff\u001b[0m          \u001b[0;94m\u2809\u001b[0m \u001b[0m\u001b[16;112H\u001b[0;94m\u28ff\u001b[0m       \u001b[0;94m\u28ff\u001b[0m \u001b[0m\u001b[17;112H\u001b[0;94m\u28ff\u001b[0m       \u001b[0;94m\u2809\u001b[0m \u001b[0m\u001b[18;112H\u001b[0;94m\u28ff\u00