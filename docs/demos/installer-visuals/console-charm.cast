m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0;97mnetwork in 584 B/s\u001b[0m \u001b[0m\u001b[24;8H\u001b[0;93m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m \u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m \u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m \u001b[0;93m     \u001b[0m\u001b[25;2H\u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m\u2584\u2584\u2584\u2584\u2584\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m\u2587\u2587\u2587\u2587\u2587\u001b[0m\u001b[26;2H\u001b[0;33m\u2583\u2583\u2583\u2583\u2583\u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m\u2583\u2583\u2583\u2583\u2583\u001b[0m \u001b[0;33m\u2583\u2583\u2583\u2583\u2583\u001b[0m \u001b[0;33m\u2585\u2585\u2585\u2585\u2585\u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m\u2586\u2586\u2586\u2586\u2586\u001b[0m "]
