[70.829, "o", "\u001b[1;14H\u001b[0;1;35mA\u001b[0;1;37m \u001b[0;1;97mR\u001b[0;1;37m \u001b[0m\u001b[9;50H\u001b[0;91m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;91m  \u001b[0;1;33m+\u001b[0m\u001b[10;57H\u001b[0;91m    \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0;95m\u2824\u2824\u2824\u2824\u28a4\u2864\u2824\u2824\u28a4\u28e0\u2824\u2824\u28e4\u2824\u2824\u2824\u2824\u2824\u2844\u28e4\u287c\u28a7\u2876\u28a4\u2864\u2844\u2864\u28b6\u2876\u2824\u28e4\u28e4\u2824\u2824\u28a4\u28a0\u2824\u2824\u2824\u2824\u2824\u28a4\u001b[0m \u001b[0;95m\u28c0\u2864\u2824\u2824\u2824\u28e4\u2824\u28e4\u2824\u28e4\u2824\u2834\u28a6\u2864\u28a4\u2864\u2824\u2824\u28a4\u2864\u2824\u28a4\u2864\u001b[0m\u001b[11;47H\u001b[0;1;34m\u00b7\u001b[0;91m \u001b[0m \u001b[0;91m\u2588\u2588\u001b[0;1;34m\u00b7\u001b[0;91m\u2588\u001b[0;1;33m+\u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m        \u001b[0;95m\u2818\u2803\u001b[0m  \u001b[0;95m\u2809\u001b[0m     \u001b[0;95m\u2819\u2803\u001b[0m \u001b[0;95m\u28b8\u2847\u2808\u2801\u28ff\u2801\u001b[0m   \u001b[0;95m\u2809\u001b[0m   \u001b[0;95m\u28b8\u284f\u001b[0m     \u001b[0;95m\u2818\u28c6\u2847\u001b[0m        \u001b[0;95m\u283f\u001b[0m    \u001b[0;95m\u2808\u2801\u001b[0m  \u001b[0;95m\u28b8\u2847\u001b[0m \u001b[0;95m\u2808\u2801\u001b[0m\u001b[12;44H\u001b[0;1;33m+\u001b[0;33m    \u001b[0m \u001b[0;33m\u2588\u001b[0;1;33m+\u001b[0;33m\u2588\u2588\u2588\u001b[0m \u001b[0;33m  \u001b[0;1;33m+\u001b[0;33m  \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                     \u001b[0;94m\u28b8\u2847\u001b[0m  \u001b[0;94m\u281b\u001b[0m                \u001b[0;94m\u28ff\u001b[0m                 