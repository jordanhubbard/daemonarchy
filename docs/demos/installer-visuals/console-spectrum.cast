[54.34, "o", "\u001b[10;90H\u001b[0;95m\u28a4\u001b[0m \u001b[0;95m\u28f6\u28e4\u001b[0m \u001b[0;95m\u2880\u28e0\u2844\u28ff\u28f6\u001b[0m \u001b[0;95m\u28e4\u28b0\u2846\u28a0\u28a4\u28b0\u28a6\u001b[0m  \u001b[0;95m\u28e4\u28e4\u2840\u28b0\u28a6\u287c\u28c7\u28f6\u001b[0m \u001b[0;95m\u28e4\u28f8\u2847\u001b[0m \u001b[0;95m\u2856\u28c6\u287f\u28a4\u001b[0m \u001b[0m\u001b[11;90H\u001b[0;95m\u28b8\u001b[0m \u001b[0;95m\u28ff\u284f\u2847\u28b8\u001b[0m \u001b[0;95m\u2819\u280b\u28b9\u2840\u28ff\u284f\u2847\u28b8\u2808\u281b\u2838\u2844\u001b[0m \u001b[0;95m\u28ff\u2847\u2847\u285e\u28b8\u2847\u2838\u28bf\u001b[0m \u001b[0;95m\u2847\u28ff\u2847\u001b[0m \u001b[0;95m\u2847\u2818\u2803\u28b8\u001b[0m \u001b[0m\u001b[12;90H\u001b[0;94m\u28b8\u001b[0m \u001b[0;94m\u28ff\u2847\u2847\u28b8\u001b[0m    \u001b[0;94m\u2847\u287f\u2807\u2847\u28b8\u001b[0m   \u001b[0;94m\u2847\u28b0\u28bb\u2847\u2847\u2847\u2808\u2801\u001b[0m \u001b[0;94m\u28b8\u001b[0m \u001b[0;94m\u2847\u2809\u2847\u001b[0m \u001b[0;94m\u2847\u001b[0m  \u001b[0;94m\u28b8\u001b[0m \u001b[0m\u001b[13;90H\u001b[0;94m\u28b8\u001b[0m \u001b[0;94m\u2847\u001b[0m \u001b[0;94m\u2847\u28b8\u001b[0m    \u001b[0;94m\u2847\u2847\u001b[0m \u001b[0;94m\u2847\u284f\u001b[0m   \u001b[0;94m\u2847\u28b8\u2818\u2803\u2847\u2847\u001b[0m   \u001b[0;94m\u28b8\u001b[0m \u001b[0;94m\u2847\u001b[0m \u001b[0;94m\u28b9\u28a0\u2807\u001b[0m  \u001b[0;94m\u28b8\u001b[0m \u001b[0m\u001b[14;90H\u001b[0;94m\u28b8\u001b[0m \u001b[0;94m\u2847\u001b[0m \u001b[0;94m\u2847\u28b8\u001b[0m    \u001b[0;94m\u2847\u2847\u001b[0m \u001b[0;94m\u2847\u2847\u001b[0m   \u001b[0;94m\u2847\u28b8\u001b[0m  \u001b[0;94m\u2847\u2847\u001b[0m   \u001b[0;94m\u28b8\u001b[0m \u001b[0;94m\u2847\u001b[0m \u001b[0;94m\u28b8\u28b8\u001b[0m   \u001b[0;94m\u28b8\u001b[0m \u001b[0m\u001b[15;90H\u001b[0;94m\u28b8\u28a0\u2807\u001b[0m \u001b[0;94m\u2847\u28b8\u001b[0m    \u001b[0;94m\u2847\u2847\u001b[0m \u001b[0;94m\u2847\u2847\u001b[0m   \u001b[0;94m\u2847\u28b8\u001