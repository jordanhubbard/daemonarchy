[28.579, "o", "\u2588\u2588\u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m\u001b[24;2H\u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m\u001b[25;2H\u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m\u001b[26;2H\u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                        \u001b[0;33m\u28b2