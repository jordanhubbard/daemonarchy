[6.274, "o", "\u001b[9;101H\u001b[0;97m56.1 MB/s\u001b[0m\u001b[10;151H\u001b[0;95m\u28b8\u2847\u28ff\u001b[0m \u001b[0;95m\u28b0\u2836\u28e6\u2844\u001b[0m\u001b[11;151H\u001b[0;95m\u28b8\u28e7\u28bf\u001b[0m \u001b[0;95m\u287c\u001b[0m \u001b[0;95m\u28ff\u2847\u28a0\u001b[0m\u001b[12;151H\u001b[0;94m\u284f\u28ff\u28b8\u001b[0m \u001b[0;94m\u2847\u001b[0m \u001b[0;94m\u28ff\u28b3\u28b8\u001b[0m\u001b[13;50H\u001b[0;33m\u2587\u2587\u2587\u2587\u2587\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                                             \u001b[0;94m\u2847\u001b[0m \u001b[0;94m\u2808\u2847\u2847\u001b[0m \u001b[0;94m\u28ff\u28b8\u28b8\u001b[0m\u001b[14;50H\u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                                             \u001b[0;94m\u2847\u001b[0m  \u001b[0;94m\u2847\u2847\u001b[0m \u001b[0;94m\u28ff\u28b8\u28b8\u001b[0m\u001b[15;2H\u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                                             \u001b[0;94m\u2847\u001b[0m  \u001b[0;94m\u2847\u2847\u001b[0m \u001b[0;94m\u28ff\u28b8\u28b8\u001b[0m\u001b[16;2H\u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \