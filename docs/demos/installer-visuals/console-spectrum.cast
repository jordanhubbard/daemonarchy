[53.722, "o", "\u001b[0;96m\u2847\u2847\u001b[0m   \u001b[0;96m\u2847\u28b8\u001b[0m  \u001b[0;96m\u2847\u2847\u001b[0m   \u001b[0;96m\u28b8\u001b[0m \u001b[0;96m\u2847\u001b[0m \u001b[0;96m\u28b8\u28b8\u001b[0m   \u001b[0;96m\u28b8\u001b[0m      \u001b[0;96m\u28ff\u001b[0m      \u001b[0;96m\u28b8\u2847\u001b[0m      \u001b[0;96m\u28b8\u2847\u001b[0m      \u001b[0;96m\u28b8\u2847\u001b[0m\u001b[19;92H\u001b[0;96m\u28ff\u001b[0m  \u001b[0;96m\u28a7\u28f8\u001b[0m    \u001b[0;96m\u28c7\u2847\u001b[0m \u001b[0;96m\u28a7\u2847\u001b[0m   \u001b[0;96m\u28a7\u28f8\u001b[0m  \u001b[0;96m\u28a7\u2847\u001b[0m   \u001b[0;96m\u2838\u28c4\u2847\u001b[0m \u001b[0;96m\u28b8\u28f8\u001b[0m   \u001b[0;96m\u2838\u28c4\u28c0\u28c0\u28c0\u28c0\u28c0\u28ff\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28f8\u28c7\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28f8\u28c7\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28f8\u28c7\u001b[0m\u001b[20;101H\u001b[0;97m188 B/s\u001b[0m\u001b[27;50H\u001b[0;92m     \u001b[0m\u001b[28;44H\u001b[0;92m\u2584\u2584\u2584\u2584\u2584\u001b[0m \u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m  \u001b[0;33m\u28e4\u001b[0m \u001b[0m\u001b[29;26H\u001b[0;92m\u2582\u2582\u2582\u2582\u2582\u001b[0m \u001b[0;92m\u2584\u2584\u2584\u2584\u2584\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m \u001b[0;33m\u28b8\u28b9\u28c0\u001b[0m    \u001b[0;33m\u28b0\u2846\u001b[0m      \u001b[0;33m\u28a0\u2844\u001b[0m\u001b[30;90H\u001b[0;93m\u28b9\u2