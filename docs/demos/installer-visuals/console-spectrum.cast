[1.924, "o", "\u001b[8;62H\u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0;97mdisk write 62.5\u001b[0m\u001b[9;62H\u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                                                    \u001b[0;95m\u28b8\u2847\u001b[0m\u001b[10;62H\u001b[0;91m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                                                    \u001b[0;95m\u28f8\u28e7\u001b[0m\u001b[11;50H\u001b[0;33m\u2582\u2582\u2582\u2582\u2582\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                                                    \u001b[0;94m\u2847\u28ff\u001b[0m\u001b[12;50H\u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                                                    \u001b[0;94m\u2847\u001b[0m\u001b[13;50H\u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                                                    \u001b[0;94m\u2847\u001b[0m\u001b[14;158H\u001b[0;94m\u2847\u001b[0m\u001b[15;158H\u001b[0;94m\u2847\u001b[0m\u001b[16;20H\u001b[0;33m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u00