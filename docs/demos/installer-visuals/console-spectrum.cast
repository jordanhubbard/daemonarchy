[54.039, "o", "\u28b8\u2847\u001b[0m      \u001b[0;96m\u28ff\u001b[0m       \u001b[0;96m\u28ff\u001b[0m       \u001b[0;96m\u28ff\u001b[0m \u001b[0m\u001b[19;91H\u001b[0;96m\u28b8\u2847\u001b[0m \u001b[0;96m\u2838\u28c4\u2847\u001b[0m   \u001b[0;96m\u28b8\u28f8\u001b[0m \u001b[0;96m\u2838\u28fc\u001b[0m   \u001b[0;96m\u2838\u28c4\u2847\u001b[0m \u001b[0;96m\u2838\u28fc\u001b[0m    \u001b[0;96m\u28a7\u28f8\u001b[0m  \u001b[0;96m\u28c7\u2847\u001b[0m   \u001b[0;96m\u28a7\u28c0\u28c0\u28c0\u28c0\u28c0\u28f8\u28c7\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28ff\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28ff\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28ff\u28c0\u001b[0m\u001b[21;62H\u001b[0;93m     \u001b[0m\u001b[22;62H\u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m\u001b[28;32H\u001b[0;92m\u2584\u2584\u2584\u2584\u2584\u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m \u001b[0;33m\u28a0\u2844\u001b[0m\u001b[29;32H\u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2587\u2587\u2587\u2587\u2587\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m \u001b[0;33m\u284f\u28c7\u2840\u001b[0m    \u001b[0;33m\u28f6\u001b[0m       \u001b[0;33m\u28e4\u001b[0m \u001b[0m\u001b[30;90H\u001b[0;93m\u28f8\u2801\u001b[0m \u001b[0;93m\u28c7\u28c0\u28c0\u28e4\u28c0\u28ff\u28c0\u28e4\u28ff\u28c0\u28e0\u28c4\u28c0\u28ff\u28e4\u28e4\u28c0\u28c0\u28c0\u28c0\u28c0\u2874\u28e6\u28c4\u28c0\u28c0\u28c0\u28c0\u28f8\u2837\u2826\u28