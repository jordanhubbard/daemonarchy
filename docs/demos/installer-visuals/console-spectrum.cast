[20.494, "o", "\u001b[8;62H\u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0;97mdisk write 61.9\u001b[0m\u001b[9;50H\u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                      \u001b[0;95m\u28b8\u2847\u28ff\u001b[0m \u001b[0;95m\u28b0\u2836\u28e6\u2844\u001b[0m \u001b[0;95m\u28c0\u28e4\u001b[0m  \u001b[0;95m\u28e0\u2844\u28e4\u2840\u28a0\u28e4\u2844\u001b[0m \u001b[0;95m\u28c0\u28e4\u28b0\u28e6\u2844\u2880\u2840\u28e4\u001b[0m \u001b[0;95m\u28e4\u2840\u001b[0m\u001b[10;50H\u001b[0;91m\u2585\u2585\u2585\u2585\u2585\u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                      \u001b[0;95m\u28b8\u28e7\u28bf\u001b[0m \u001b[0;95m\u287c\u001b[0m \u001b[0;95m\u28ff\u2847\u28a0\u28bf\u285f\u2846\u28b8\u2801\u2839\u2807\u2847\u28b8\u28ff\u28b9\u001b[0m \u001b[0;95m\u284f\u2819\u283e\u281b\u2847\u28b8\u28ff\u28b9\u001b[0m \u001b[0;95m\u2847\u2839\u001b[0m\u001b[11;62H\u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                      \u001b[0;94m\u284f\u28ff\u28b8\u001b[0m \u001b[0;94m\u2847\u001b[0m \u001b[0;94m\u28ff\u28b3\u28b8\u001b[0m  \u001b[0;94m\u2847\u28b8\u001b[0m   \u001b[0;94m\u2847\u28b8\u28ff\u28b8\u001b[0m \u001b[0;94m\u2847\u001b[0m   \u001b[0;94m\u28b9\u28b8\u283f\u28b8\u001b[0m \u001b[0;94m\u2847\u001b[0m\u001b[12;62H\u001b[0;33m\u2585\u2585\u2585\u2585\u2585\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                      \u001b[0;94m\u2847\u001b[0m \u001b[0;94m\u2808\u2847\u2847\u001b[0m \u001b[0;94m\u28ff\u28b8\u28b8\u001b[0m  \u001b[0;94m\u2847\u28b8\u001b[0m   \u001b[0;94m\u2847\u28b8\u2809\u28b8\u001b[0m \u001b[0;94m\u2847\u001b[0m   \u001b[0;94m\u28b8\u28b8\u001b[0m \u001b[0;94m\u28b8\u28b8\u2801\u001b[0m\u001b[13;128H\u001b[0;94m\u2847\u001b[0m  \u001b[0;94m\u2847\u2847\u001b[0m \u001b[0;94m\u28ff\u28b8\u28b8\u001b[0m  \u001b[0;94m\u2847\u28b8\u001b[0m   \u001b[0;94m\u2847\u28b8\u001b[0m \u001b[0;94m\u28b8\u001b[0m \u001b[0;94m\u2847\u001b[0m   \u001b[0;94m\u28b8\u28b8\u001b[0m \u001b[0;94m\u28b8\u28b8\u001b[0m \u001b[0m\u001b[14;128H\u001b[0;94m\u2847\u001b[0m  \u001b[0;94m\u2847\u2847\u001b[0m \u001b[0;94m\u28ff\u28b8\u28b8\u001b[0m  \u001b[0;94m\u2847\u28b8\u001b[0m   \u001b[0;94m\u2847\u287c\u001b[0m \u001b[0;94m\u28b8\u001b[0m \u001b[0;94m\u2847\u001b[0m   \u001b[0;94m\u28b8\u28b8\u001b[0m \u001b[0;94m\u28b8\u28b8\u001b[0m \u001b[0m\u001b[15;32H\u001b[0;33m\u2586\u2586\u2586\u2586\u2586\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                      \u001b[0;94m\u2847\u001b[0m  \u001b[0;94m\u2847\u2847\u001b[0m "]
[20.511, "o", "\u001b[0;94m\u28ff\u28b8\u28b8\u001b[0m  \u001b[0;94m\u2847\u28b8\u001b[0m   \u001b[0;94m\u28c7\u2847\u001b[0m \u001b[0;94m\u28b8\u001b[0m \u001b[0;94m\u2847\u001b[0m   \u001b[0;94m\u28b8\u28b8\u001b[0m \u001b[0;94m\u28b8\u28b8\u001b[0m \u001b[0m\u001b[16;20H\u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m\u2587\u2587\u2587\u2587\u2587\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                      \u001b[0;94m\u2847\u001b[0m  \u001b[0;94m\u2847\u2847\u001b[0m \u001b[0;94m\u28ff\u28b8\u28b8\u001b[0m  \u001b[0;94m\u2847\u28b8\u001b[0m   \u001b[0;94m\u28b8\u2847\u001b[0m \u001b[0;94m\u28b8\u001b[0m \u001b[0;94m\u2847\u001b[0m   \u001b[0;94m\u28b8\u28b8\u001b[0m \u001b[0;94m\u28b8\u28b8\u001b[0m \u001b[0m\u001b[17;20H\u001b[0;33m\u2582\u2582\u2582\u2582\u2582\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                      \u001b[0;96m\u2847\u001b[0m  \u001b[0;96m\u2847\u2847\u001b[0m \u001b[0;96m\u28ff\u28b8\u28b8\u001b[0m  \u001b[0;96m\u2847\u28b8\u001b[0m   \u001b[0;96m\u28b8\u2847\u001b[0m \u001b[0;96m\u28b8\u001b[0m \u001b[0;96m\u2847\u001b[0m   \u001b[0;96m\u28b8\u28b8\u001b[0m \u001b[0;96m\u28b8\u28b8\u001b[0m \u001b[0m\u001b[18;20H\u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u