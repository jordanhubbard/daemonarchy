[28.58, "o", "\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                        \u001b[0;33m\u28b8\u001b[0m                \u001b[0;33m\u284f\u28c7\u2840\u001b[0m    \u001b[0;33m\u28f6\u001b[0m       \u001b[0;33m\u28e4\u001b[0m \u001b[0m\u001b[30;114H\u001b[0;93m\u28b8\u28e4\u28c0\u28f0\u28c6\u28e0\u28c4\u2874\u28c6\u28c0\u28c0\u28c0\u28c0\u28e0\u28c4\u28f8\u28ff\u2801\u001b[0m \u001b[0;93m\u28c7\u28c0\u28c0\u28e4\u28c0\u28ff\u28c0\u28e4\u28ff\u28c0\u28e0\u28c4\u28c0\u28ff\u28e4\u28e4\u28c0\u28c0\u28c0\u28c0\u28c0\u2874\u28e6\u28c4\u001b[0m\u001b[32;23H\u001b[0;1;33m94.6 MB/s\u001b[0;94m  read \u001b[0;93m    0 B/s\u001b[0;97m  124 IO/s\u001b[0m\u001b[33;21H\u001b[0;1;96m196\u001b[0m\u001b[34;15H\u001b[0;97m59%\u001b[0;94m   Memory \u001b[0;97m6.7 of 7.1 GiB\u001b[0;94m   ARC \u001b[0;94m4.1\u001b[0m"]
