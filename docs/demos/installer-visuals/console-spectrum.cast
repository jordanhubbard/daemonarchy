[21.443, "o", "\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                    \u001b[0;33m\u2847\u001b[0m                \u001b[0;33m\u28e4\u001b[0m \u001b[0m\u001b[28;126H\u001b[0;33m\u2847\u001b[0m               \u001b[0;33m\u28b8\u28b9\u28c0\u001b[0m    \u001b[0;33m\u28b0\u2846\u001b[0m      \u001b[0;33m\u28a0\u2844\u001b[0m\u001b[29;126H\u001b[0;93m\u28e7\u28c4\u28c0\u28f6\u28c0\u28e4\u28e0\u28b6\u28c0\u28c0\u28c0\u28c0\u28c0\u28e4\u28c0\u28ff\u284f\u001b[0m \u001b[0;93m\u28b8\u28c0\u28c0\u28e0\u28c4\u28f8\u28c7\u28e0\u28fc\u28c7\u28c0\u28e4\u28c0\u28f8\u28e7\u001b[0m\u001b[31;22H\u001b[0;1;33m 51.6 MB/s\u001b[0;94m  read \u001b[0;93m    0 B/s\u001b[0;97m  220\u001b[0m\u001b[32;21H\u001b[0;1;96m389\u001b[0m\u001b[33;16H\u001b[0;97m7\u001b[0m"]
[21.531, "o", "\u001b[9;50H\u001b[0;91m     \u001b[0m\u001b[10;50H\u001b[0;91m\u2582\u2582\u2582\u2582\u2582\u001b[0m\u001b[15;32H\u001b[0;33m     \u001b[0m\u001b[16;32H\u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m \u001b[0;33m     \u001b[0m\u001b[17;20H\u001b[0;33m     \u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m\u001b[18;20H\u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m\u001b[20;8H\u001b[0;93m     \u001b[0m\u001b[21;8H\u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m\u001b[23;8H\u001b[0;93m     \u001b[0m\u001b[24;8H\u001b[0;33m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m\u001b[25;2H\u001b[0;33m     \u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m\u001b[26;2H\u001b[0;92m\u2583\u2583\u2583\u2583\u2583\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2582\u2582\u2582\u2582\u2582\u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m\u2586\u2586\u2586\u2586\u2586\u001b[0m \u001b[0;92m\u2583\u2583\u2583\u2583\u2583\u001b[0m\u001b[27;20H\u001b[0;92m\u2583\u2583\u2583\u2583\u2583\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2582\u2582\u2582\u2582\u2582\u001b[0m"]
[21.632, "o", "\u001b[10;50H\u001b[0;91m     \u001b[0m\u001b[11;50H\u001b[0;33m\u2587\u2587\u2587\u2587\u2587\u001b[0m\u001b[16;32H\u001b[0;33m     \u001b[0m\u001b[17;32H\u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m \u001b[0;33m     \u001b[0m\u001b[18;20H\u001b[0;93m     \u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m\u001b[20;20H\u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m\u001b[21;8H\u001b[0;93m     \u001b[0m\u001b[23;8H\u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m\u001b[24;8H\u001b[0;33m     \u001b[0m\u001b[25;8H\u001b[0;33m\u2584\u2584\u2584\u2584\u2584\u001b[0m\u001b[26;2H\u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m\u2582\u2582\u2582\u2582\u2582\u001b[0m\u001b[27;14H\u001b[0;92m\u2586\u2586\u2586\u2586\u2586\u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m\u2586\u2586\u2586\u2586\u2586\u001b[0m\u001b[28;20H\u001b[0;92m\u2586\u2586\u2586\u2586\u2586\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2587\u2587\u2587\u2587\u2587\u001b[0m"]
