[52.442, "o", "\u2847\u2847\u001b[0m   \u001b[0;94m\u2847\u28b8\u001b[0m  \u001b[0;94m\u2847\u2847\u001b[0m   \u001b[0;94m\u28b8\u001b[0m \u001b[0;94m\u2847\u001b[0m \u001b[0;94m\u28b8\u28b8\u001b[0m   \u001b[0;94m\u28b8\u001b[0m      \u001b[0;94m\u28ff\u001b[0m      \u001b[0;94m\u28b8\u2847\u001b[0m      \u001b[0;94m\u28b8\u2847\u001b[0m      \u001b[0;94m\u28b8\u001b[0m\u001b[18;62H\u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m    \u001b[0;96m\u28ff\u001b[0m  \u001b[0;96m\u2847\u28b8\u001b[0m    \u001b[0;96m\u2847\u2847\u001b[0m \u001b[0;96m\u2847\u2847\u001b[0m   \u001b[0;96m\u2847\u28b8\u001b[0m  \u001b[0;96m\u2847\u2847\u001b[0m   \u001b[0;96m\u28b8\u001b[0m \u001b[0;96m\u2847\u001b[0m \u001b[0;96m\u28b8\u28b8\u001b[0m   \u001b[0;96m\u28b8\u001b[0m      \u001b[0;96m\u28ff\u001b[0m      \u001b[0;96m\u28b8\u2847\u001b[0m      \u001b[0;96m\u28b8\u2847\u001b[0m      \u001b[0;96m\u28b8\u001b[0m\u001b[19;62H\u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m    \u001b[0;96m\u28ff\u001b[0m  \u001b[0;96m\u28a7\u28f8\u001b[0m    \u001b[0;96m\u28c7\u2847\u001b[0m \u001b[0;96m\u28a7\u2847\u001b[0m   \u001b[0;96m\u28a7\u28f8\u001b[0m  \u001b[0;96m\u28a7\u2847\u001b[0m   \u001b[0;96m\u2838\u28c4\u2847\u001b[0m \u001b[0;96m\u28b8\u28f8\u001b[0m   \u001b[0;96m\u2838\u28c4\u28c0\u28c0\u28c0\u28c0\u28c0\u28ff\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28f8\u28c7\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28f8\u28c7\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28f8\u001b[0m\u001b[20;62H\u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0;97mnetwork in 187 B/s\u001b[0m\u001b[21;62H\u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m\u001b[22;62H\u001b[0;