[55.634, "o", "\u001b[0;96m\u2838\u28c4\u28c0\u28c0\u28c0\u28c0\u28c0\u28ff\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28f8\u28c7\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28f8\u28c7\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28f8\u28c7\u001b[0m\u001b[21;101H\u001b[0;97m0 B/s\u001b[0m  \u001b[0m\u001b[29;14H\u001b[0;92m     \u001b[0m\u001b[30;14H\u001b[0;92m\u2586\u2586\u2586\u2586\u2586\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2583\u2583\u2583\u2583\u2583\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0;33m\u28c0\u001b[0m    \u001b[0;33m\u28b0\u2846\u001b[0m      \u001b[0;33m\u28a0\u2844\u001b[0m\u001b[31;90H\u001b[0;93m\u28b8\u28c0\u28c0\u28e0\u28c4\u28f8\u28c7\u28e0\u28fc\u28c7\u28c0\u28e4\u28c0\u28f8\u28e7\u28e4\u28c4\u28c0\u28c0\u28c0\u28c0\u28e0\u28b6\u28e4\u28c0\u28c0\u28c0\u28c0\u28c0\u287f\u2836\u2834\u28e6\u28a4\u28e4\u28e0\u28c4\u28f6\u28e4\u28e0\u28c4\u28c0\u28e0\u28c4\u28c0\u28f6\u28c0\u28c0\u28e0\u28c4\u28c0\u28c0\u28c0\u28f0\u28c6\u28c0\u28c0\u28c0\u28c0\u28c0\u28f0\u28a6\u28e4\u28e0\u28c4\u28e4\u28c0\u28c0\u28f0\u28c6\u001b[0m\u001b[34;21H\u001b[0;1;96m  0\u001b[0m\u001b[35;16H\u001b[0;97m0\u001b[0m"]
