[8.77, "o", "       \u001b[0;33m\u28b8\u001b[0m \u001b[0m\u001b[28;2H\u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                                        \u001b[0;33m\u28b8\u001b[0m \u001b[0m\u001b[29;2H\u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                                        \u001b[0;33m\u28b8\u001b[0m \u001b[0m\u001b[30;146H\u001b[0;93m\u28b8\u28e4\u28c0\u28f0\u28c6\u28e0\u28c4\u2874\u28c6\u28c0\u28c0\u28c0\u28c0\u28e0\u001b[0m\u001b[32;23H\u001b[0;1;33m82.6 MB/s\u001b[0;94m  read \u001b[0;93m    0 B/s\u001b[0;97m  108 IO/s\u001b[0m\u001b[33;21H\u001b[0;1;96m393\u001b[0m\u001b[34;15H\u001b[0;97m47\u001b[0m"]
