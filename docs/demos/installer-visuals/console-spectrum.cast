[8.153, "o", "\u2588\u2588\u2588\u2588\u2588\u001b[0m\u001b[23;20H\u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m\u001b[24;20H\u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m\u001b[25;20H\u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m\u001b[26;50H\u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m\u2582\u2582\u2582\u2582\u2582\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                                         \u001b[0;33m\u28b2\u001b[0m \u001b[0m\u001b[27;14H\u001b[0;92m     \u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                                         \u001b[0;33m\u28b8\u001b[0m \u001b[0m\u001b[28;2H\u001b[0;92m     \u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2585\u2585\u2585\u2585\u2585\u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m\u2583\u2583\u2583\u2583\u2583\u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m     \u001b[0m \u001b[0;92m\u2588\u2588\