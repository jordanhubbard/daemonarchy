[9.999, "o", "\u2580\u2580\u2580\u2580\u2580\u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                                       \u001b[0;96m\u2847\u001b[0m  \u001b[0;96m\u2847\u2847\u001b[0m \u001b[0;96m\u28ff\u28b8\u28b8\u001b[0m  \u001b[0;96m\u2847\u28b8\u001b[0m \u001b[0m\u001b[18;2H\u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                                      \u001b[0;96m\u28c0\u2847\u001b[0m  \u001b[0;96m\u28a7\u2847\u001b[0m \u001b[0;96m\u283f\u28b8\u28f8\u001b[0m  \u001b[0;96m\u28a7\u28f8\u001b[0m \u001b[0m\u001b[19;2H\u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;93m     \u001b[0m \u001b[0;93m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0;97mnetwork in 1.9 KB/s\u001b[0m                                                  \u001b[0m\u001b[20;2H\u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m \u001b[0;