[55.955, "o", "\u28b8\u28f8\u001b[0m \u001b[0;96m\u2838\u28fc\u001b[0m   \u001b[0;96m\u2838\u28c4\u2847\u001b[0m \u001b[0;96m\u2838\u28fc\u001b[0m    \u001b[0;96m\u28a7\u28f8\u001b[0m  \u001b[0;96m\u28c7\u2847\u001b[0m   \u001b[0;96m\u28a7\u28c0\u28c0\u28c0\u28c0\u28c0\u28f8\u28c7\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28ff\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28ff\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u28ff\u28c0\u001b[0m\u001b[21;101H\u001b[0;97m561 B/s\u001b[0m\u001b[29;14H\u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m\u001b[30;14H\u001b[0;92m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2584\u2584\u2584\u2584\u2584\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;92m\u2582\u2582\u2582\u2582\u2582\u001b[0m \u001b[0;92m\u2581\u2581\u2581\u2581\u2581\u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m     \u001b[0;33m\u28f6\u001b[0m       \u001b[0;33m\u28e4\u001b[0m \u001b[0m\u001b[31;90H\u001b[0;93m\u28c0\u28c0\u28c0\u28e4\u28c0\u28ff\u28c0\u28e4\u28ff\u28c0\u28e0\u28c4\u28c0\u28ff\u28e4\u28e4\u28c0\u28c0\u28c0\u28c0\u28c0\u2874\u28e6\u28c4\u28c0\u28c0\u28c0\u28c0\u28f8\u2837\u2826\u28b6\u2864\u28e4\u28c4\u28e4\u28f0\u28e6\u28c4\u28e4\u28c0\u28c0\u28e4\u28c0\u28f0\u28c6\u28c0\u28c0\u28e4\u28c0\u28c0\u28c0\u28c0\u28f6\u28c0\u28c0\u28c0\u28c0\u28c0\u28c0\u2876\u28e4\u28c4\u28e4\u28e0\u28c4\u28c0\u28c0\u28f6\u28e0\u001b[0m\u001b[34;21H\u001b[0;1;96m561\u001b[0m\u001b[35;16H\u001b[0;97m1\u001b[0m"]
