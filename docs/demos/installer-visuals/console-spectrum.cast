[9.058, "o", "\u001b[9;101H\u001b[0;97m91.4\u001b[0m\u001b[10;50H\u001b[0;91m\u2581\u2581\u2581\u2581\u2581\u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                                         \u001b[0;95m\u28ff\u28b8\u2847\u001b[0m \u001b[0;95m\u2876\u28b6\u28e4\u001b[0m \u001b[0;95m\u2880\u28e0\u2844\u001b[0m \u001b[0;95m\u2880\u001b[0m\u001b[11;8H\u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m \u001b[0;91m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                                         \u001b[0;95m\u28ff\u287c\u2847\u28a0\u2807\u28b8\u28ff\u001b[0m \u001b[0;95m\u287c\u28ff\u28b3\u001b[0m \u001b[0;95m\u284f\u001b[0m\u001b[12;8H\u001b[0;97m\u2580\u2580\u2580\u2580\u2580\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m\u2588\u2588\u2588\u2588\u2588\u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m \u001b[0;33m     \u001b[0m        \u001b[0;93m\u2502\u001b[0m \u001b[0;94m\u2502\u001b[0m                                                        \u001b[0;94m\u28b8\u28b9\u2847\u2847\u28b8\u001b[0m \u001b[0;94m\u28b8\u285f\u2846\u2847\u001b[0m \u001b[0;94m\u28b8\u001b[0m \u001b[0;94m\u2847\u001b[0m\u001b[13;146H\u001b[0;94m\u28b8\u001b[0m  \u001b[0;94m\u28b9\u28b8\u001b[0m \u001b[0;94m\u28b8\u2847\u2847\u2847\u001b[0m \u001b[0;94m\u28b8\u001b[0m \u001b[0;94m\u2847\u001b[0m\u001b[14;146H\u001b[0;94m\u28b8\u001b[0m  \u001b[0;94m\u28b8\u