[53.382, "o", "\u001b[10;90H\u001b[0m \u001b[0;95m\u2876\u2844\u28b0\u28e6\u2844\u001b[0m \u001b[0;95m\u28c0\u28e4\u28b8\u28f7\u2846\u28a0\u2844\u28f6\u001b[0m \u001b[0;95m\u2864\u2844\u2876\u2844\u001b[0m \u001b[0;95m\u28a0\u28e4\u28c4\u001b[0m \u001b[0;95m\u2876\u28e4\u28bf\u28f0\u2846\u28a0\u28c4\u28ff\u001b[0m \u001b[0;95m\u28b0\u28b2\u28f8\u2827\u2844\u001b[0m\u001b[11;90H\u001b[0;95m\u2819\u2803\u2847\u28b8\u28ff\u28b9\u001b[0m \u001b[0;95m\u2847\u2808\u281b\u2809\u28c7\u28b8\u28ff\u28b9\u001b[0m \u001b[0;95m\u2847\u2819\u2803\u28a7\u001b[0m \u001b[0;95m\u28b8\u28ff\u28b8\u28b0\u2803\u28ff\u001b[0m \u001b[0;95m\u283f\u2847\u28b8\u28b8\u28ff\u001b[0m \u001b[0;95m\u28b8\u001b[0m \u001b[0;95m\u281b\u001b[0m \u001b[0;95m\u2847\u001b[0m\u001b[12;92H\u001b[0;94m\u2847\u28b8\u28ff\u28b8\u001b[0m \u001b[0;94m\u2847\u001b[0m   \u001b[0;94m\u28b8\u28b8\u283f\u28b8\u001b[0m \u001b[0;94m\u2847\u001b[0m  \u001b[0;94m\u28b8\u001b[0m \u001b[0;94m\u285e\u28ff\u28b8\u28b8\u001b[0m \u001b[0;94m\u2809\u001b[0m  \u001b[0;94m\u2847\u28b8\u2808\u28b9\u001b[0m \u001b[0;94m\u28b8\u001b[0m   \u001b[0;94m\u2847\u001b[0m\u001b[13;92H\u001b[0;94m\u2847\u28b8\u001b[0m \u001b[0;94m\u28b8\u001b[0m \u001b[0;94m\u2847\u001b[0m   \u001b[0;94m\u28b8\u28b8\u001b[0m \u001b[0;94m\u28b8\u28b8\u2801\u001b[0m  \u001b[0;94m\u28b8\u001b[0m \u001b[0;94m\u2847\u281b\u28b8\u28b8\u001b[0m    \u001b[0;94m\u2847\u28b8\u001b[0m \u001b[0;94m\u2808\u2847\u287c\u001b[0m   \u001b[0;94m\u2847\u001b[0m\u001b[14;92H\u001b[0;94m\u2847\u28b8\u001b[0m \u001b[0;94m\u28b8\u001b[0m \u001b[0;94m\u2847\u001b[0m   \u001b[0;94m\u28b8\u28b8\u001b[0m \u001b[0;94m\u28b8\u28b8\u001b[0m   \u001b[0;94m\u28b8\u001b[0m \u001b[0;94m\u2847\u001b[0m \u001b[0;94m\u28b8\u28b8\u001b[0m    \u001b[0;94m\u2847\u28b8\u001b[0m  \u001b[0;94m\u2847\u2847\u001b[0m   \u001b[0;94m\u2847\u001b[0m\u001b[15;92H\u001b[0;94m\u2847\u287c\u001b[0m \u001b[0;94m\u28b8\u001b[0m \u001b[0;94m\u2847\u001b[0m   \u001b[0;94m\u28b8\u28b8\u001b[0m \u001b[0;94m\u28b8