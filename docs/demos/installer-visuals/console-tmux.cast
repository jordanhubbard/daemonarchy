[18.205, "o", "\u001b[1m\u2588\u2588\u001b(B\u001b[m \u001b[33m\u001b[1m\u2588\u2588\u001b(B\u001b[m \u001b[33m\u001b[1m\u2588\u2588\u001b(B\u001b[m \u001b[33m\u001b[1m\u2588\u2588\u001b(B\u001b[m    \u001b[33m\u001b[1m\u2588\u2588\u001b(B\u001b[m         \u001b[33m\u001b[1m\u2502\u001b(B\u001b[m \u001b[34m\u001b[1m\u2502\u001b(B\u001b[m\u001b[34X\u001b[34m\u001b[1m\u001b[34C\u2502\u001b(B\u001b[m\u001b[33m\u001b[1m\r\n\u2502\u001b(B\u001b[m\u001b[33m\u2588\u2588\u001b[39m \u001b[33m\u2588\u2588\u001b[39m \u001b[33m\u2588\u2588\u001b[39m \u001b[33m\u2588\u2588\u001b[39m \u001b[33m\u2588\u2588\u001b[39m \u001b[33m\u2588\u2588\u001b[39m \u001b[33m\u2588\u2588\u001b[39m \u001b[33m\u2588\u2588\u001b[39m \u001b[33m\u2588\u2588\u001b[39m    \u001b[33m\u2588\u2588\u001b[39m         \u001b[33m\u001b[1m\u2502\u001b(B\u001b[m \u001b[34m\u001b[1m\u2502\u001b(B\u001b[m\u001b[34X\u001b[34m\u001b[1m\u001b[34C\u2502\u001b(B\u001b[m\u001b[33m\u001b[1m\r\n\u2502\u001b(B\u001b[m\u001b[33m\u2588\u2588\u001b[39m \u001b[33m\u2588\u2588\u001b[39m \u001b[33m\u2588\u2588\u001b[39m \u001b[33m\u2588\u2588\u001b[39m \u001b[33m\u2588\u2588\u001b[39m \u001b[33m\u2588\u2588\u001b[39m \u001b[33m\u2588\u2588\u001b[39m \u001b[33m\u2588\u2588\u001b[39m \u001b[33m\u2588\u2588\u001b[39m    \u001b[33m\u2588\u2588\u001b[39m         \u001b[33m\u001b[1m\u2502\u001b(B\u001b[m \u001b[34m\u001b[1m\u2502\u001b(B\u001b[m     \u001b[33m\u2810\u2846\u001b[39m\u001b[27X\u001b[34m\u001b[1m\u001b[27C\u2502\u001b(B\u001b[m\u001b[33m\u001b[1m\r\n\u2502\u001b[32m\u2588\u2588\u001b(B\u001b[m \u001b[32m\u001b[1m\u2588\u2588\u001b(B\u001b[m \u001b[32m\u001b[1m\u2588\u2588\u001b(B\u001b[m \u001b[32m\u001b[1m\u2588\u2588\u001b(B\u001b[m \u001b[32m\u001b[1m\u2588\u2588\u001b(B\u001b[m \u001b[32m\u001b[1m\u2588\u2588\u001b(B\u001b[m \u001b[32m\u001b[1m\u2588\u2588\u001b(B\u001b[m \u001b[32m\u001b[1m\u2588\u2588\u001b(B\u001b[m \u001b[32m\u001b[1m\u2588\u2588\u001b(B\u001b[m    \u001b[32m\u001b[1m\u2588\u2588\u001b(B\u001b[m 