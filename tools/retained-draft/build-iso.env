# DRAFT environment mapping for build-iso.sh under a retained run.
#
# Sourced by run-build-iso.sh with `set -a`.  Every value follows scripts/master-release.sh
# `step_iso` (and its defaults) for RELEASE=1.5.0 on the mudflap builder; the retained
# profile cannot pass environment variables, so this file is the reviewable record.
#
# Grounded:   the variable names and the shape of the mapping (master-release.sh step_iso),
#             JAIL/PTREE/WORK/SET_CACHE_DIR defaults (master-release.sh), the 1.5.0 tag and
#             secure-boot artifact names (RELEASE=1.5.0 default), file existence on mudflap.
# UNKNOWN:    whether the 1.5.0 ISO (out-5dd9da334d93, state file 2026-11-01) was built with
#             exactly these JAIL/PTREE/CHECKOUT_CATALOG values: the config file passed to
#             master-release.sh for that run was not found on the worker.
# Not set here (and never to be): SIGN_KEY and every private key path.  build-iso.sh takes
#             only public, already signed secure-boot artifacts.
WORK=/usr/daemonarchy/rev2-20261030
ARCH=amd64
JAIL=16r2303b36
PTREE=daports141
POUDRIERE_ETC=$WORK/poudriere-etc
POUDRIERE_DATA=$WORK/poudriere-data
PACKAGES_DIR=$POUDRIERE_DATA/packages/$JAIL-$PTREE
SET_CACHE_DIR=$WORK/inputs/source-sets
CHECKOUT_CATALOG=$WORK/checkout-feed-1.5.0/checkouts.json
PACKAGE_REPOSITORY_TAG=packages-16-amd64-1.5.0
PACKAGE_MIRROR_URLS=https://github.com/jordanhubbard/daemonarchy/releases/download/packages-16-amd64-1.4.1-upstream
REQUIRE_PACKAGE_MIRROR=yes
SECUREBOOT_BUNDLE=/usr/daemonarchy/sb16/daemonarchy-1.5.0-boot.txz
SECUREBOOT_SIGNATURE=$SECUREBOOT_BUNDLE.sig
SECUREBOOT_CERTIFICATE=/usr/daemonarchy/boot-replacement-candidate-public-20261024/daemonarchy-1.3.1.pem
