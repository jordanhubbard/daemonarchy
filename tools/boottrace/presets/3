# MSI Raider diagnostics: keep the kernel away from legacy ISA devices,
# print every startup step, and never auto-reboot after a panic.
hw.atrtc.enabled="0"
hint.atkbdc.0.disabled="1"
hint.atkbd.0.disabled="1"
hint.psm.0.disabled="1"
hint.sc.0.disabled="1"
hint.vga.0.disabled="1"
hint.uart.0.disabled="1"
hint.uart.1.disabled="1"
hint.ppc.0.disabled="1"
boot_verbose="YES"
debug.verbose_sysinit="1"
kern.panic_reboot_wait_time="-1"
debug.trace_on_panic="1"
autoboot_delay="NO"
# Variant 3: single CPU and no HPET
hint.hpet.0.disabled="1"
kern.smp.disabled="1"
