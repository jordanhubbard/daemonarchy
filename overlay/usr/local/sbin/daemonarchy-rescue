#!/bin/sh
# ttyv0 fallback. Privileged actions pass through login before execution.
state_dir=/var/db/daemonarchy/install
rescue_log=/var/log/daemonarchy-rescue.log
startup_wait=60
failure_wait=15
poll_seconds=1
boot_quiet_wait=15
boot_quiet_seconds=2
debug_state=/var/db/daemonarchy/remote-debug
debug_command=/usr/local/sbin/daemonarchy-debug
graphics_nodriver=/var/run/daemonarchy-graphics.nodriver

rescue_record() {
  umask 077
  mkdir -p "$state_dir"
  {
    date -u '+%Y-%m-%dT%H:%M:%SZ'
    rescue_reason || echo 'Graphical login or desktop process unavailable.'
  } >>"$rescue_log"
  dmesg -a >"$state_dir/rescue-kernel.log" 2>&1 || true
}

rescue_font() {
  [ "$(tty)" = /dev/ttyv0 ] || return 0
  dimensions=$(stty size </dev/tty 2>/dev/null) || return 0
  columns=${dimensions##* }
  case $columns in ''|*[!0-9]*) return 0 ;; esac
  if [ "$columns" -gt 200 ] && [ -r /usr/share/vt/fonts/terminus-b32.fnt ]; then
    vidcontrol -f terminus-b32 </dev/tty >/dev/tty 2>&1 || true
  fi
}

rescue_wait_boot_output() {
  [ "$(tty)" = /dev/ttyv0 ] || return 0
  echo 'Preparing rescue menu; waiting for boot messages to finish.'
  previous=$(dmesg -a 2>/dev/null | cksum)
  remaining=$boot_quiet_wait
  quiet=0
  while [ "$remaining" -gt 0 ] && [ "$quiet" -lt "$boot_quiet_seconds" ]; do
    sleep 1
    current=$(dmesg -a 2>/dev/null | cksum)
    if [ "$current" = "$previous" ]; then
      quiet=$((quiet + 1))
    else
      quiet=0
      previous=$current
    fi
    remaining=$((remaining - 1))
  done
}

desktop_ready() {
  pgrep -x sddm >/dev/null 2>&1 || return 1
  pgrep -x Hyprland >/dev/null 2>&1 ||
    pgrep -f '^/usr/local/bin/sddm-greeter(-qt[56])?([[:space:]]|$)' >/dev/null 2>&1
}

rescue_reason() {
  if [ "$(cat "$state_dir/status" 2>/dev/null)" != complete ]; then
    printf 'Installation did not complete. Last recorded stage: %s\n' \
      "$(cat "$state_dir/phase" 2>/dev/null || echo unknown)"
    return 0
  fi
  if [ -e "$graphics_nodriver" ]; then
    echo 'No supported desktop graphics driver was found for this display, so the'
    echo 'graphical desktop is off. Virtual machines need a virtio-gpu (QEMU) display;'
    echo 'VirtualBox and QEMU standard VGA or QXL adapters are not supported.'
    return 0
  fi
  return 1
}

# One timestamped line per event, so a boot where the listener did not come back
# leaves evidence (this runs in the background with its output in the rescue log).
rescue_note() {
  printf '%s rescue-debug: %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*"
}

rescue_resume_debug() {
  [ -x "$debug_command" ] || { rescue_note "no $debug_command; remote debugging cannot resume"; return 0; }
  remaining=60
  attempts=0
  healthy=no
  had_grant=no
  if [ -f "$debug_state/active" ]; then
    had_grant=yes
    rescue_note 'approved grant found; resuming the listener when networking is ready'
  else
    rescue_note 'no approved grant; nothing to resume'
  fi
  "$debug_command" publish-status || true
  # USB Ethernet and DHCP can become ready after the recovery console starts.
  # Retry in the background so a retained grant resumes without console input.
  while [ -f "$debug_state/active" ]; do
    "$debug_command" publish-status || true
    if "$debug_command" status >/dev/null 2>&1; then
      # Do not spawn another listener while the approved one is healthy.
      [ "$healthy" = yes ] || rescue_note "listener is up after $attempts resume attempt(s)"
      healthy=yes
      remaining=60
      sleep 5
      continue
    fi
    [ "$healthy" != yes ] || rescue_note 'listener went away; resuming it'
    healthy=no
    attempts=$((attempts + 1))
    "$debug_command" resume || true
    if "$debug_command" status >/dev/null 2>&1; then
      # The listener can exit after a successful start. Keep watching until
      # explicit stop or Unpair removes the grant, then resume it unattended.
      rescue_note "resume attempt $attempts succeeded"
      healthy=yes
      remaining=60
      sleep 5
      continue
    fi
    # The first few failures, then about one a minute, so the log stays small
    # but shows whether networking or the listener is what never came up.
    if [ "$attempts" -le 5 ] || [ $((attempts % 12)) -eq 0 ]; then
      rescue_note "resume attempt $attempts: no listener yet (addresses: $(ifconfig -a inet 2>/dev/null | awk '/inet /{printf "%s ", $2}'))"
    fi
    if [ "$remaining" -gt 0 ]; then
      remaining=$((remaining - 1))
      sleep 1
    else
      # A slow USB/network bring-up must not discard an approved grant.
      sleep 5
    fi
  done
  [ "$had_grant" != yes ] || rescue_note 'grant removed (explicit stop or Unpair); not resuming'
}

monitor_desktop() {
  rescue_reason && return 0
  remaining=$startup_wait
  while :; do
    if desktop_ready; then
      remaining=$failure_wait
    elif [ "$remaining" -le 0 ]; then
      echo 'The graphical login or desktop is not running.'
      return 0
    else
      remaining=$((remaining - poll_seconds))
    fi
    sleep "$poll_seconds"
  done
}

rescue_logs() {
  echo '=== Installation state ==='
  for name in status phase requested-user ssh-requested exit-code started-utc updated-utc; do
    [ ! -f "$state_dir/$name" ] || { printf '%s: ' "$name"; cat "$state_dir/$name"; }
  done
  echo '=== Rescue log (last 20 lines) ==='
  tail -n 20 "$rescue_log" 2>/dev/null || true
  echo '=== Installer log (last 100 lines) ==='
  tail -n 100 /var/log/daemonarchy-install.log 2>/dev/null || true
  echo '=== Current kernel messages (last 80 lines) ==='
  dmesg -a | tail -n 80
  echo '=== System log (last 80 lines) ==='
  tail -n 80 /var/log/messages 2>/dev/null || true
}

rescue_action() {
  case $1 in
    shell) exec /bin/sh -i ;;
    remote|unpair)
      if [ ! -x /usr/local/bin/bash ]; then
        echo 'Remote pairing needs bash, which was not installed before the interruption.'
        echo 'Use the local shell or boot the installer USB for remote debugging.'
        return 1
      fi
      if [ "$1" = unpair ]; then "$debug_command" unpair; else "$debug_command" listen; fi
      ;;
    logs) rescue_logs; printf '\nPress Return for the rescue menu. '; read -r unused ;;
    desktop)
      if [ "$(cat "$state_dir/status" 2>/dev/null)" != complete ]; then
        echo 'Installation is incomplete. Inspect the logs before completing setup.'
        return 1
      fi
      if [ -x /usr/local/etc/rc.d/daemonarchy-graphics ]; then
        service daemonarchy-graphics start || return
      fi
      service sddm restart || return
      monitor_desktop
      ;;
    reboot) sync; shutdown -r now ;;
    *) return 1 ;;
  esac
}

rescue_menu() {
  authenticated=$1
  rescue_font
  while :; do
    # Font changes and late device probes can leave the first menu offscreen.
    # Position it explicitly instead of relying on a Return key to redraw it.
    if [ "$(tty)" = /dev/ttyv0 ]; then printf '\033[2J\033[H'; fi
    remote_action=remote
    remote_label='Pair a remote debugging agent'
    if [ -e "$debug_state" ] || [ -L "$debug_state" ]; then
      remote_label='Resume remote debugging agent'
      if "$debug_command" status >/dev/null 2>&1; then
        remote_action=unpair
        remote_label='Unpair remote debugging agent'
      fi
    fi
    # Keep the reason on screen: the clear above would otherwise erase it.
    rescue_reason || true
    cat <<MENU

Daemonarchy rescue
  1. Open a local debugging shell
  2. $remote_label
  3. View installation and boot logs
  4. Try the graphical login again
  5. Reboot
MENU
    if [ "$authenticated" != yes ]; then
      echo 'Actions require root login with the password chosen during installation.'
    fi
    printf 'Choose [1-5]: '
    read -r choice || return 0
    case $choice in
      1) action=shell ;; 2) action=$remote_action ;; 3) action=logs ;;
      4) action=desktop ;; 5) action=reboot ;; *) continue ;;
    esac
    if [ "$authenticated" = yes ]; then
      rescue_action "$action" || true
    else
      # login -p carries only the requested action into root's profile.
      # It still authenticates root; getty's initial autologin cannot bypass it.
      DAEMONARCHY_RESCUE_ACTION=$action
      export DAEMONARCHY_RESCUE_ACTION
      exec /usr/bin/login -p root
    fi
  done
}

rescue_main() {
  [ "$(id -u)" = 0 ] || { echo 'Run daemonarchy-rescue as root.' >&2; return 1; }
  case ${1:-monitor} in
    monitor)
      # This grant was approved at the root console before the preceding reboot.
      # Resume it before waiting for a desktop, without deleting crash evidence.
      rescue_resume_debug </dev/null >>"$rescue_log" 2>&1 &
      echo 'Waiting for graphical login; this console shows recovery options if it fails.'
      monitor_desktop
      rescue_wait_boot_output
      rescue_record
      rescue_menu no
      ;;
    authenticated)
      rescue_action "${2:-logs}" || true
      rescue_menu yes
      ;;
    menu) rescue_menu yes ;;
    *) echo 'Usage: daemonarchy-rescue [monitor | menu]' >&2; return 1 ;;
  esac
}

if [ "${1-}" != --library ]; then rescue_main "$@"; fi
