#!/usr/local/bin/bash
# Sourced by install. Never retain the answers file: it contains credentials.
diagnostics_active=false
diagnostics_ready=false

diagnostics_write() {
  local name=$1 value=$2 temporary
  temporary=$(mktemp "$diagnostics_dir/.$name.XXXXXX") || return
  printf '%s\n' "$value" >"$temporary" || return
  mv -f "$temporary" "$diagnostics_dir/$name"
}

diagnostics_begin() {
  local target=$1 requested_user=$2 requested_ssh=$3 live_log=$4
  diagnostics_dir=$target/var/db/daemonarchy/install
  install -d -m 700 "$diagnostics_dir"
  rm -f "$diagnostics_dir/exit-code" "$diagnostics_dir/updated-utc"
  diagnostics_write status in-progress
  diagnostics_write phase base
  diagnostics_write requested-user "$requested_user"
  diagnostics_write ssh-requested "$requested_ssh"
  diagnostics_write started-utc "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  diagnostics_log=$target/var/log/daemonarchy-install.log
  if [[ -f $live_log ]]; then cp "$live_log" "$diagnostics_log"; else : >"$diagnostics_log"; fi
  chmod 600 "$diagnostics_log"
  exec {diagnostics_stdout}>&1 {diagnostics_stderr}>&2
  exec > >(tee -a "$diagnostics_log") 2>&1
  diagnostics_pid=$!
  diagnostics_active=true diagnostics_ready=true
  sync
}

diagnostics_phase() {
  $diagnostics_ready || return 0
  diagnostics_write phase "$1"
  # Preserve kernel output before package traffic can wrap the live ring.
  dmesg -a >"$diagnostics_dir/kernel-$1.log" 2>&1 || true
  sync
}

diagnostics_result() {
  $diagnostics_ready || return 0
  diagnostics_write status "$1"
  diagnostics_write exit-code "$2"
  diagnostics_write updated-utc "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  sync
}

diagnostics_stop() {
  $diagnostics_active || return 0
  # Close both pipe writers and wait for tee before exporting the ZFS pool.
  exec 1>&"$diagnostics_stdout" 2>&"$diagnostics_stderr"
  exec {diagnostics_stdout}>&- {diagnostics_stderr}>&-
  diagnostics_active=false
  wait "$diagnostics_pid"
}
