#!/usr/local/bin/bash
# Verified Apple recovery firmware stays in a private live stage until install.
# This file is sourced by the configurator and installer.

if [[ -z ${apple_firmware_stage:-${APPLE_FIRMWARE_STAGE:-}} &&
      -f ${ISO_SHARE:-}/private-apple-stage/provenance.json ]]; then
  APPLE_FIRMWARE_STAGE=$ISO_SHARE/private-apple-stage
else
  APPLE_FIRMWARE_STAGE=${apple_firmware_stage:-${APPLE_FIRMWARE_STAGE:-/tmp/daemonarchy-apple-firmware-stage}}
fi
APPLE_FIRMWARE_IMPORTER=${APPLE_FIRMWARE_IMPORTER:-$ISO_SHARE/import-apple-bcm4364-firmware.py}
APPLE_FIRMWARE_NAMES=(
  brcmfmac4364b3-pcie.bin
  brcmfmac4364b3-pcie.txt
  brcmfmac4364b3-pcie.clm_blob
  brcmfmac4364b3-pcie.txcap_blob
)

apple_firmware_hardware() {
  [[ $(kenv smbios.system.product 2>/dev/null || true) == MacBookPro16,1 ]] || return 1
  pciconf -l | awk '
    (/vendor=0x14e4/ && /device=0x4464/ && /subvendor=0x106b/ && /subdevice=0x07bf/) ||
    (/chip=0x446414e4/ && /card=0x07bf106b/) { found=1 }
    END { exit !found }'
}

apple_firmware_preloaded() {
  "$APPLE_FIRMWARE_IMPORTER" --verify-files --model MacBookPro16,1 \
    --destination /boot/firmware >/dev/null 2>&1
}

apple_firmware_verify_live() {
  local name
  "$APPLE_FIRMWARE_IMPORTER" --verify-stage --model MacBookPro16,1 \
    --destination "$APPLE_FIRMWARE_STAGE" || return
  for name in "${APPLE_FIRMWARE_NAMES[@]}"; do
    cmp -s "$APPLE_FIRMWARE_STAGE/$name" "/boot/firmware/$name" || return 1
  done
}

apple_firmware_radio_attached() {
  local devices
  devices=$(sysctl -n net.wlan.devices 2>/dev/null) || return 1
  [[ " $devices " == *" brcmfmac0 "* ]]
}

apple_firmware_prepare() {
  local source=$1 image=${2:-} name attempt
  if [[ -d $APPLE_FIRMWARE_STAGE ]]; then
    "$APPLE_FIRMWARE_IMPORTER" --verify-stage --model MacBookPro16,1 \
      --destination "$APPLE_FIRMWARE_STAGE" || return
    if apple_firmware_verify_live && apple_firmware_radio_attached; then
      return 0
    fi
  else
    case $source in
      download)
        "$APPLE_FIRMWARE_IMPORTER" --download --model MacBookPro16,1 \
          --destination "$APPLE_FIRMWARE_STAGE" || return
        ;;
      image)
        [[ -n $image ]] || return 1
        "$APPLE_FIRMWARE_IMPORTER" --image "$image" --model MacBookPro16,1 \
          --destination "$APPLE_FIRMWARE_STAGE" || return
        ;;
      internal)
        # The importer opens the APFS device read-only through 7-Zip; nothing
        # mounts or writes the Mac's internal disk.
        [[ -n $image ]] || return 1
        "$APPLE_FIRMWARE_IMPORTER" --internal-disk "$image" --model MacBookPro16,1 \
          --destination "$APPLE_FIRMWARE_STAGE" || return
        ;;
      files)
        [[ -n $image ]] || return 1
        "$APPLE_FIRMWARE_IMPORTER" --files "$image" --model MacBookPro16,1 \
          --destination "$APPLE_FIRMWARE_STAGE" || return
        ;;
      *) return 2 ;;
    esac
  fi
  # The ISO root is read-only. Union-mount a small live filesystem at the
  # kernel's fixed firmware path so the ISO's own firmware stays visible to
  # later signed-manifest checks, then attach the radio once the files exist.
  [[ -d /boot/firmware ]] || { echo '/boot/firmware is absent from the live ISO' >&2; return 1; }
  local current
  current=$(mount | grep ' on /boot/firmware ' || true)
  if [[ -n $current && $current != *union* ]]; then
    # An earlier attempt hid the ISO firmware; replace that mount.
    umount /boot/firmware || return
    current=
  fi
  if [[ -z $current ]]; then
    mount -t tmpfs -o union,size=8m tmpfs /boot/firmware || {
      echo 'Could not make live firmware available to the kernel' >&2
      return 1
    }
  fi
  for name in "${APPLE_FIRMWARE_NAMES[@]}"; do
    install -m 0444 "$APPLE_FIRMWARE_STAGE/$name" "/boot/firmware/$name" || return
  done
  apple_firmware_verify_live || return
  if kldstat -n if_brcmfmac >/dev/null 2>&1; then
    kldunload if_brcmfmac || return
  fi
  kldload /boot/modules/if_brcmfmac.ko || return
  for ((attempt=0; attempt<10; attempt++)); do
    apple_firmware_radio_attached && return 0
    sleep 1
  done
  echo 'BCM4364 driver loaded, but its wireless interface did not attach' >&2
  return 1
}

# Offline sources: no Ethernet required. Every candidate ends in the same
# importer verification and provenance record as the Apple download.
apple_firmware_devices() {
  local disk device
  for disk in $(sysctl -n kern.disks 2>/dev/null); do
    for device in "/dev/$disk" "/dev/$disk"p* "/dev/$disk"s*; do
      [[ -c $device ]] && printf '%s\n' "$device"
    done
  done
}

apple_firmware_mounted() {
  mount -p 2>/dev/null | awk -v device="$1" '$1 == device { found=1 } END { exit !found }'
}

# The Mac's internal APFS partitions, read through 7-Zip without mounting.
apple_firmware_internal_devices() {
  local device
  while read -r device; do
    [[ $(fstyp "$device" 2>/dev/null) == apfs ]] && printf '%s\n' "$device"
  done < <(apple_firmware_devices)
}

apple_firmware_prepare_internal() {
  local device
  while read -r device; do
    echo "Reading Apple recovery firmware from $device (read-only)"
    apple_firmware_prepare internal "$device" && return 0
  done < <(apple_firmware_internal_devices)
  echo 'No internal macOS recovery or system volume supplied the verified board files.' >&2
  return 1
}

# Search one read-only mounted volume for a recovery image or the four files.
apple_firmware_import_from_tree() {
  local root=$1 candidate
  while IFS= read -r candidate; do
    apple_firmware_prepare files "${candidate%/*}" && return 0
  done < <(find "$root" -maxdepth 4 -type f -name brcmfmac4364b3-pcie.bin 2>/dev/null)
  while IFS= read -r candidate; do
    apple_firmware_prepare image "$candidate" && return 0
  done < <(find "$root" -maxdepth 4 -type f -name BaseSystem.dmg 2>/dev/null)
  return 1
}

# A second USB stick (FAT or UFS) carrying BaseSystem.dmg or verified files.
# Each unmounted volume is mounted read-only in a private directory, searched,
# then unmounted again. Disks holding APFS (the Mac's internal disk) are skipped.
apple_firmware_prepare_media() {
  local device type mountpoint status internal=" "
  while read -r device; do
    internal+="${device%%[ps][0-9]*} "
  done < <(apple_firmware_internal_devices)
  while read -r device; do
    [[ $internal == *" ${device%%[ps][0-9]*} "* ]] && continue
    apple_firmware_mounted "$device" && continue
    type=$(fstyp "$device" 2>/dev/null) || continue
    case $type in msdosfs|ufs|cd9660) ;; *) continue ;; esac
    mountpoint=$(mktemp -d /tmp/daemonarchy-firmware-media.XXXXXXXX) || return
    if ! mount -r -t "$type" "$device" "$mountpoint" 2>/dev/null; then
      rmdir "$mountpoint"
      continue
    fi
    echo "Searching $device for Apple recovery firmware (read-only)"
    apple_firmware_import_from_tree "$mountpoint"
    status=$?
    umount "$mountpoint" && rmdir "$mountpoint"
    ((status == 0)) && return 0
  done < <(apple_firmware_devices)
  echo 'No attached FAT or UFS volume supplied a verified recovery image or board files.' >&2
  return 1
}
