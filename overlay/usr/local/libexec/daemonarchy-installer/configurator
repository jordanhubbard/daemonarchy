#!/usr/local/bin/bash

# The Daemonarchy installer: the Omarchy ISO configurator's screens
# (greeter, keyboard, account, hostname, timezone) with a FreeBSD disk step.
# It writes its answers to $DAEMONARCHY_INSTALL_CONF and hands off to
# daemonarchy-installer/install, which does the actual installation.
#
# The account and machine questions come from Omarchy's own setup form
# (install/provisioning/setup-form.sh), vendored into the image, so this asks
# exactly what the Arch installer asks and checks answers the same way.

ISO_SHARE=/usr/local/share/daemonarchy-installer
DAEMONARCHY_INSTALL_CONF=${DAEMONARCHY_INSTALL_CONF:-/tmp/daemonarchy-install.conf}
LOGO_PATH="$ISO_SHARE/logo.txt"

# timedatectl for the setup form's timezone list.
export PATH="$ISO_SHARE/compat:$PATH"

source "$ISO_SHARE/setup-form.sh"
source "$(dirname "$0")/disk-layout"
source "$(dirname "$0")/checkout-options"
source "$(dirname "$0")/gpu-config"
source "$(dirname "$0")/cuda-options"
source "$(dirname "$0")/network-addresses"
source "$(dirname "$0")/apple-firmware"

# The setup form's reserved names are Linux's. On FreeBSD a name is taken if
# the base system has it (the live system's accounts are the base system's)
# or a package the install brings creates it (listed at build time).
omarchy_username_taken() {
  pw usershow "$1" >/dev/null 2>&1 && return 0
  grep -qx -- "$1" "$ISO_SHARE/reserved-users" 2>/dev/null
}

LOGO_WIDTH=$(awk '{ if (length > max) max = length } END { print max+0 }' "$LOGO_PATH")

export GUM_CONFIRM_PROMPT_FOREGROUND="6"
export GUM_CONFIRM_SELECTED_FOREGROUND="0"
export GUM_CONFIRM_SELECTED_BACKGROUND="2"
export GUM_CONFIRM_UNSELECTED_FOREGROUND="7"
export GUM_CONFIRM_UNSELECTED_BACKGROUND="0"

# The console can grow after boot (the framebuffer settles late, especially in
# VMs), so remeasure at every redraw rather than trusting startup geometry.
measure_terminal() {
  TERM_WIDTH=$(stty size 2>/dev/null </dev/tty | awk '{print $2}')
  ((TERM_WIDTH > 0)) || TERM_WIDTH=${COLUMNS:-80}

  PADDING_LEFT=$(((TERM_WIDTH - LOGO_WIDTH) / 2))
  ((PADDING_LEFT < 0)) && PADDING_LEFT=0
  PADDING_LEFT_SPACES=$(printf "%*s" "$PADDING_LEFT" "")

  PADDING="0 0 0 $PADDING_LEFT"
  export GUM_CHOOSE_PADDING="$PADDING"
  export GUM_FILTER_PADDING="$PADDING"
  export GUM_INPUT_PADDING="$PADDING"
  export GUM_SPIN_PADDING="$PADDING"
  export GUM_TABLE_PADDING="$PADDING"
  export GUM_CONFIRM_PADDING="$PADDING"
}
measure_terminal

clear_logo() {
  measure_terminal
  printf "\033[H\033[2J"
  gum style --foreground 1 --padding "1 0 0 $PADDING_LEFT" "$(<"$LOGO_PATH")"
}

# The same welcome frame the Arch ISO opens on: logo, tagline, one button.
greeter() {
  measure_terminal

  local rows logo_h content_h top cols logo_row tagline_row hint_row
  local tagline hint tpad hpad anim
  cols=$TERM_WIDTH
  rows=$(stty size 2>/dev/null </dev/tty | awk '{print $1}')
  [[ $rows =~ ^[0-9]+$ ]] || rows=${LINES:-24}
  logo_h=$(wc -l <"$LOGO_PATH")

  content_h=$((logo_h + 4))
  top=$(((rows - content_h) / 2))
  ((top < 0)) && top=0
  logo_row=$((top + 1))
  tagline_row=$((top + logo_h + 2))
  hint_row=$((top + logo_h + 4))

  printf '\033[?25l\033[H\033[2J'

  printf '\033[%d;1H' "$logo_row"
  gum style --foreground 1 --padding "0 0 0 $PADDING_LEFT" "$(<"$LOGO_PATH")"

  tagline="Omarchy's desktop spliced onto FreeBSD's daemon"
  [[ -r $ISO_SHARE/version ]] && tagline="$tagline · $(<"$ISO_SHARE/version")"
  tpad=$(((cols - ${#tagline}) / 2)); ((tpad < 0)) && tpad=0
  printf '\033[%d;%dH%s' "$tagline_row" "$((tpad + 1))" "$tagline"

  hint="Press Return for installer options"
  hpad=$(((cols - ${#hint}) / 2)); ((hpad < 0)) && hpad=0
  printf '\033[%d;%dH\033[2m%s\033[0m' "$hint_row" "$((hpad + 1))" "$hint"

  # The Arch ISO's colorshift on the logo, if ttfx is on the image.
  anim=""
  if command -v ttfx >/dev/null; then
    printf '\033[%d;1H\0337' "$((logo_row + logo_h))"
    ttfx -i "$LOGO_PATH" \
      --canvas-width "$((cols > 2 ? cols - 2 : cols))" \
      --anchor-text c \
      --frame-rate 60 \
      --reuse-canvas \
      --xterm-colors \
      colorshift \
      --gradient-stops 1 9 3 9 \
      --gradient-frames 3 \
      --cycles 1000 \
      --final-gradient-stops 1 \
      </dev/null >/dev/tty 2>/dev/null &
    anim=$!
  fi

  IFS= read -r _ </dev/tty || true
  if [[ -n $anim ]]; then
    kill "$anim" 2>/dev/null
    wait "$anim" 2>/dev/null || true
  fi
  stty sane </dev/tty 2>/dev/null || true
  printf '\033[0m\033[H\033[2J\033[?25h'
}

abort() {
  gum style "${1:-Aborted installation}"
  echo
  gum style "You can retry by running: /usr/local/libexec/daemonarchy-installer/launch"
  exit 1
}

step() {
  clear_logo
  echo
  gum style --padding "0 0 0 $PADDING_LEFT" "$1"
  echo
}

say() {
  gum style --padding "0 0 0 $PADDING_LEFT" "$@"
}

notice() {
  clear_logo
  echo
  gum spin --spinner "pulse" --title "$1" -- sleep "${2:-2}"
  echo
}

# STEP 1: KEYBOARD LAYOUT

keyboard_form() {
  local status

  while true; do
    clear_logo
    echo
    say "Let's setup your machine..."
    echo

    omarchy_prompt_keyboard && status=0 || status=$?
    ((status == 0)) && break
    ((status == OMARCHY_FORM_BACK)) && continue
    abort
  done

  # Switch the console keymap now, so the password is typed on the layout
  # the user just picked.
  local vt_map
  vt_map=$("$ISO_SHARE/keymap" vt "$keyboard")
  [[ -n $vt_map ]] && kbdcontrol -l "$vt_map" </dev/tty 2>/dev/null
}

# STEP 2: ACCOUNT, HOSTNAME, TIMEZONE

user_form() {
  step "Let's setup your user account..."

  omarchy_prompt_username || return $?
  omarchy_prompt_password || return $?

  password_hash=$(printf '%s' "$password" | openssl passwd -6 -stdin)

  omarchy_prompt_identity || return $?
  omarchy_prompt_hostname || return $?
  omarchy_prompt_timezone || return $?
}

user_step() {
  local status

  while true; do
    user_form && status=0 || status=$?
    if ((status != 0)); then
      ((status == OMARCHY_FORM_BACK)) || abort
      keyboard_form
      continue
    fi

    echo -e "Field,Value
Username,$username
Password,$(printf "%${#password}s" | tr ' ' '*')
Full name,${full_name:-[Skipped]}
Email address,${email_address:-[Skipped]}
Hostname,$hostname
Timezone,$timezone
Keyboard,$keyboard_label" |
      gum table -s "," -p | sed "s/^/${PADDING_LEFT_SPACES}/"

    echo
    if gum confirm --negative "No, change it" "Does this look right?"; then
      break
    else
      keyboard_form
    fi
  done
}

# STEP 3: NETWORK
#
# Unlike the Arch ISO, which carries every package, this installer downloads
# most of the desktop from pkg.FreeBSD.org, so it needs a network before the disk
# is touched. Every Ethernet port asked for DHCP at boot; this step shows what
# came of it and lets the user pick a different port, join Wi-Fi on any
# wireless adapter, or set an address by hand. Whatever is chosen here is what
# the installed system uses. Wi-Fi is optional. An empty adapter list is a
# normal Ethernet machine: the probe succeeds with no output, and the screen
# does not mention Wi-Fi unless a wireless adapter is present.

net_mode=dhcp net_if="" net_addr="" net_gw="" net_dns=""
wifi_ssid="" wifi_psk="" wifi_hidden=false
wifi_enterprise_profile=""

online() {
  local status=0
  # Preserve fetch's diagnostic: DNS, TLS, HTTP and timeouts all used to be
  # flattened into "not connected", even with a working DHCP lease and route.
  # fetch's I/O timeout does not bound the resolver's retries against a dead DNS
  # server. Keep the interactive form responsive even before fetch connects.
  network_probe_error=$(LC_ALL=C timeout 8 fetch -q -T 5 -o /dev/null https://pkg.FreeBSD.org/ 2>&1) || status=$?
  if ((status == 124)); then
    network_probe_error='DNS lookup or package repository connection timed out after 8 seconds.'
  fi
  return "$status"
}

network_failure() {
  local error=${network_probe_error:-No diagnostic returned.} year line
  say --foreground 3 "Could not reach the package repository securely (https://pkg.FreeBSD.org/)."
  year=$(date -u +%Y)
  # A clearly invalid clock is actionable evidence; a plausible year alone
  # cannot establish that the clock is correct or explain a TLS failure.
  if [[ $year =~ ^[0-9]+$ ]] && ((10#$year < 2025)); then
    say --foreground 3 "The system clock is incorrect. HTTPS certificates cannot be checked reliably."
    say "Choose Set date and time, or Synchronize time over network, then Check again."
  else
    case $error in
      *"certificate verification failed"*|*"Certificate verification failed"*|*"certificate verify failed"*)
        say --foreground 3 "TLS certificate verification failed."
        say "Check the system date and time. If correct, check certificate trust or network interception."
        ;;
      *"No address record"*|*"Name does not resolve"*|*"Name or service not known"*|*"hostname nor servname"*|*"Temporary failure in name resolution"*)
        say --foreground 3 "DNS could not resolve the package server. Check the DHCP-provided DNS servers."
        ;;
      *"Network is unreachable"*|*"No route to host"*)
        say --foreground 3 "The package server is unreachable. Check the interface and default gateway."
        ;;
      *"timed out"*|*"Timeout"*)
        say --foreground 3 "The package request timed out. The server or network may be unavailable; try again."
        ;;
      *)
        say "The package request failed; this does not necessarily mean the network is disconnected."
        ;;
    esac
  fi
  say "System time: $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
  # Show the underlying error even when it does not match a known category.
  while IFS= read -r line; do
    say --foreground 8 "$line"
  done <<< "$error"
}

# Round-trip parsing rejects dates BSD date would otherwise normalize.
valid_clock_time() {
  local value=$1 parsed
  [[ $value =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}:[0-9]{2}$ ]] || return 1
  parsed=$(date -j -u -f '%Y-%m-%d %H:%M:%S' "$value" '+%Y-%m-%d %H:%M:%S' 2>/dev/null) || return 1
  [[ $parsed == "$value" ]]
}

set_clock_manually() {
  local value
  step "Set date and time"
  say "Enter UTC time (not local time). No network connection is needed."
  say "Format: YYYY-MM-DD HH:MM:SS. This does not change your selected desktop timezone."
  value=$(date -u '+%Y-%m-%d %H:%M:%S')
  while true; do
    value=$(gum input --value "$value" --prompt "UTC date and time> ") || return 0
    if valid_clock_time "$value"; then break; fi
    say --foreground 3 "Enter a valid date and time, for example 2026-10-15 17:30:00."
  done
  gum confirm "Set the system clock to $value UTC?" || return 0
  # Stop automatic adjustment while applying the user's chosen time. The
  # network-sync action can re-enable it; installed systems still enable NTP.
  if service ntpd onestatus >/dev/null 2>&1 && ! service ntpd onestop >/dev/null 2>&1; then
    notice "Could not stop network time synchronization; the clock was not changed." 3
    return 0
  fi
  if date -u -f '%Y-%m-%d %H:%M:%S' "$value" >/dev/null 2>&1; then
    notice "System clock set to $value UTC."
  else
    notice "Could not set the system clock. Try again or open the debug shell." 3
  fi
}

wait_for_clock_sync() {
  while true; do
    if ntpq -c rv 2>/dev/null | grep -Eq 'leap=00([,[:space:]]|$)'; then return 0; fi
    sleep 1
  done
}

sync_clock_network() {
  step "Synchronize time"
  say "Network time needs a working connection to an NTP server."
  say "This waits up to 30 seconds. You can also set the date and time manually."
  if ! service ntpd onestatus >/dev/null 2>&1 && ! service ntpd onestart >/dev/null 2>&1; then
    notice "Could not start network time synchronization. Set the date and time manually." 3
    return 0
  fi
  if gum spin --spinner pulse --title "Waiting for network time (up to 30 seconds)..." -- \
      timeout 30 bash -c "$(declare -f wait_for_clock_sync); wait_for_clock_sync"; then
    notice "Network time synchronized: $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
  else
    notice "Time synchronization did not complete. Check the network or set the date and time manually." 3
  fi
}

ether_ports() {
  local ifc
  for ifc in $(ifconfig -l ether); do
    [[ $ifc == wlan* ]] || echo "$ifc"
  done
}

# Success with no output when FreeBSD has no wireless devices. `sysctl` fails
# if the oid is absent, and a search that rejects blank lines also fails; either
# status would abort a `set -e` caller before Ethernet DHCP is offered.
wifi_adapters() {
  local devices device
  devices=$(sysctl -n net.wlan.devices 2>/dev/null) || true
  # sysctl prints one space-separated list.
  # shellcheck disable=SC2086
  for device in $devices; do
    printf '%s\n' "$device"
  done
}

port_address() {
  ifconfig "$1" inet 2>/dev/null | awk '/inet / { print $2; exit }'
}

port_state() {
  local status
  status=$(ifconfig "$1" 2>/dev/null | awk '/status:/ { sub(/.*status: /, ""); print; exit }')
  case $status in
    active | associated) echo connected ;;
    "no carrier") echo "no cable" ;;
    *) echo "${status:-down}" ;;
  esac
}

default_port() {
  route -n get default 2>/dev/null | awk '/interface:/ { print $2 }'
}

# Kernel device descriptions identify the hardware without guessing from its MAC.
adapter_description() {
  local dev=$1 driver unit description
  driver=${dev%%[0-9]*}
  unit=${dev#"$driver"}
  description=$(sysctl -n "dev.$driver.$unit.%desc" 2>/dev/null)
  [[ -n $description ]] || description=$(ifconfig "$dev" 2>/dev/null |
    awk '/description:/ { sub(/.*description: /, ""); print; exit }')
  printf '%s' "${description:-Hardware description unavailable}"
}

adapter_kind() {
  case $1 in
    wlan*) echo 'Wi-Fi' ;;
    ue*) echo 'USB network' ;;
    tap*|tun*|bridge*|epair*|vtnet*) echo 'Virtual' ;;
    *) echo 'Network' ;;
  esac
}

# One line per adapter plus the kernel's hardware description.
network_summary() {
  local ifc addr state dot wireless wired=false
  for ifc in $(ether_ports); do
    wired=true
    addr=$(port_address "$ifc")
    state=$(port_state "$ifc")
    if [[ -n $addr ]]; then dot=$'\033[32m●\033[0m'; else dot=$'\033[90m○\033[0m'; fi
    printf '%s%s  %-8s %-9s %-10s %s\n' "$PADDING_LEFT_SPACES" "$dot" "$ifc" "$(adapter_kind "$ifc")" "$state" "$addr"
    say --foreground 8 "  $(adapter_description "$ifc")"
  done
  wireless=$(wifi_adapters)
  for ifc in $wireless; do
    addr="" state=""
    if [[ $(sysctl -n net.wlan.0.%parent 2>/dev/null) == "$ifc" ]]; then
      addr=$(port_address wlan0)
      state=$(port_state wlan0)
    fi
    if [[ -n $addr ]]; then dot=$'\033[32m●\033[0m'; else dot=$'\033[90m○\033[0m'; fi
    printf '%s%s  %-8s %-9s %-10s %s\n' "$PADDING_LEFT_SPACES" "$dot" "$ifc" "Wi-Fi" "$state" "$addr"
    say --foreground 8 "  $(adapter_description "$ifc")"
  done
  if [[ -n $wireless ]]; then
    say --foreground 8 'Choose "Join Wi-Fi" below to select a network and enter its password.'
  elif [[ $wired == false ]]; then
    say --foreground 8 "No network adapter detected. A USB Ethernet adapter is enough to install."
  fi
}

valid_cidr() {
  [[ $1 =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$ ]]
}

valid_ip() {
  [[ $1 =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]
}

use_dhcp() {
  local ifc=$1
  gum spin --spinner pulse --title "Asking for an address on $ifc..." -- \
    bash -c "dhclient '$ifc' >/dev/null 2>&1; sleep 2"
  net_mode=dhcp net_if=$ifc wifi_enterprise_profile=''
}

use_static() {
  local ifc=$1 addr gw dns
  step "Set up $ifc by hand"
  addr=$(gum input --placeholder "192.168.1.50/24" --prompt.foreground="#845DF9" --prompt "Address> ") || return 1
  until valid_cidr "$addr"; do
    addr=$(gum input --value "$addr" --placeholder "Address with prefix length, like 192.168.1.50/24" \
      --prompt.foreground="#845DF9" --prompt "Address> ") || return 1
  done
  gw=$(gum input --placeholder "192.168.1.1" --prompt.foreground="#845DF9" --prompt "Gateway> ") || return 1
  until valid_ip "$gw"; do
    gw=$(gum input --value "$gw" --placeholder "Gateway address, like 192.168.1.1" \
      --prompt.foreground="#845DF9" --prompt "Gateway> ") || return 1
  done
  dns=$(gum input --value "1.1.1.1" --prompt.foreground="#845DF9" --prompt "DNS servers> ") || return 1

  pkill -f "dhclient: $ifc" 2>/dev/null
  pkill -f "dhclient.*$ifc" 2>/dev/null
  ifconfig "$ifc" inet "$addr" up
  route -q delete default >/dev/null 2>&1
  route -q add default "$gw" >/dev/null
  printf 'nameserver %s\n' ${dns//,/ } >/etc/resolv.conf
  net_mode=static net_if=$ifc net_addr=$addr net_gw=$gw net_dns=$dns wifi_enterprise_profile=''
}

# Scan for networks and print one SSID per line, strongest first. ifconfig's
# scan list pads the SSID column to the widest name, so cut it at the BSSID
# column rather than at whitespace.
wifi_scan() {
  local attempt
  # A newly attached radio can return only its first BSSID from one scan.
  # Keep results from several scans so a later response does not hide an AP.
  for attempt in 1 2 3 4; do
    ifconfig wlan0 up scan >/dev/null 2>&1
    ifconfig -v wlan0 list scan 2>/dev/null
    [[ $attempt == 4 ]] || sleep 3
  done | awk '
    index($0, "SSID") && index($0, "BSSID") { width = index($0, "BSSID") - 1; next }
    width < 1 { next }
    {
      ssid = substr($0, 1, width); sub(/[[:space:]]+$/, "", ssid)
      rest = substr($0, width + 1); split(rest, f, " ")
      split(f[4], sn, ":")
      if (ssid != "") print sn[1] "\t" ssid
    }' | sort -k1,1nr | awk -F '\t' '!seen[$2]++ { print $2 }'
}

wifi_connect() {
  local ssid=$1 psk=$2 hidden=$3 tries state gateway_if dhcp_pid dhcp_command
  local stale_addr wired_pidfile router lease_file
  local wifi_conf=${WIFI_CONF:-/tmp/wpa_supplicant.conf}
  local error_file=${WIFI_ERROR_FILE:-/tmp/daemonarchy-wifi-connect-error}
  local dhcp_pidfile=${WIFI_DHCLIENT_PIDFILE:-/var/run/dhclient/dhclient.wlan0.pid}
  rm -f "$error_file"
  # ifconfig_DEFAULT=DHCP may have started a background client before this
  # radio had an authenticated link. Own the wireless lease after WPA instead
  # of competing with that early client; leave wired DHCP clients untouched.
  if [[ -r $dhcp_pidfile ]]; then
    read -r dhcp_pid <"$dhcp_pidfile"
    if [[ $dhcp_pid =~ ^[1-9][0-9]*$ ]]; then
      dhcp_command=$(ps -p "$dhcp_pid" -o command= 2>/dev/null || true)
      if [[ $dhcp_command == *'dhclient: wlan0'* ||
            $dhcp_command == *'dhclient wlan0'* ]]; then
        kill "$dhcp_pid" 2>/dev/null || true
      fi
    fi
  fi
  {
    echo 'ctrl_interface=/var/run/wpa_supplicant'
    if [[ -n $psk ]]; then
      wpa_passphrase "$ssid" "$psk" | grep -v '^[[:space:]]*#psk='
    else
      printf 'network={\n\tssid="%s"\n\tkey_mgmt=NONE\n}\n' "$ssid"
    fi | if [[ $hidden == true ]]; then awk '/^}$/ { print "\tscan_ssid=1" } { print }'; else cat; fi
  } >"$wifi_conf"
  chmod 600 "$wifi_conf"

  pkill -f "wpa_supplicant.*wlan0" 2>/dev/null
  wpa_supplicant -B -i wlan0 -c "$wifi_conf" >/dev/null 2>&1 || {
    printf '%s\n' 'Could not start the Wi-Fi authenticator.' >"$error_file"
    return 1
  }
  # A radio may need to try several BSSIDs for the same SSID. Wait for the
  # completed key exchange before starting DHCP, not just 802.11 association.
  for ((tries=0; tries<120; tries++)); do
    state=$(wpa_cli -i wlan0 status 2>/dev/null | awk -F= '$1 == "wpa_state" { print $2; exit }')
    [[ $state == COMPLETED ]] && break
    sleep 1
  done
  if ((tries == 120)); then
    printf 'Wi-Fi authentication timed out after 120 seconds (last state: %s).\n' "${state:-unknown}" >"$error_file"
    return 1
  fi
  timeout 60 dhclient wlan0 >/dev/null 2>&1 || {
    printf '%s\n' 'Wi-Fi authenticated, but DHCP did not assign an address within 60 seconds.' >"$error_file"
    return 1
  }
  # A transient lease or a link-only association is not usable for an online
  # install. Let the new route settle, then check the selected Wi-Fi path.
  sleep 5
  if [[ -z $(port_address wlan0) ]]; then
    printf '%s\n' 'Wi-Fi authenticated, but no IP address is available.' >"$error_file"
    return 1
  fi
  gateway_if=$(route -n get default 2>/dev/null | awk '/interface:/ { print $2; exit }')
  if [[ $gateway_if != wlan0 ]]; then
    # A wired adapter may own the default route even after Wi-Fi obtains a
    # lease. Keep a live wired address for the debugger while selecting the
    # wireless gateway for package downloads. Release a stale wired lease only
    # when its cable has no carrier.
    lease_file=${WIFI_DHCLIENT_LEASEFILE:-/var/db/dhclient.leases.wlan0}
    router=$(awk '$1 == "option" && $2 == "routers" {
      gsub(/[;,]/, "", $3); value = $3
    } END { print value }' "$lease_file" 2>/dev/null || true)
    if [[ $gateway_if =~ ^[[:alnum:]_.-]+$ && $gateway_if != wlan* &&
          $router =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] &&
       ifconfig "$gateway_if" 2>/dev/null | grep -Eq '^[[:space:]]*ether '; then
      if ifconfig "$gateway_if" 2>/dev/null | grep -Eq 'status: (no carrier|inactive)'; then
        wired_pidfile=${WIFI_WIRED_DHCLIENT_PIDFILE:-/var/run/dhclient/dhclient.$gateway_if.pid}
        if [[ -r $wired_pidfile ]]; then
          read -r dhcp_pid <"$wired_pidfile"
          if [[ $dhcp_pid =~ ^[1-9][0-9]*$ ]]; then
            dhcp_command=$(ps -p "$dhcp_pid" -o command= 2>/dev/null || true)
            if [[ $dhcp_command == *"dhclient: $gateway_if"* ||
                  $dhcp_command == *"dhclient $gateway_if"* ]]; then
              kill "$dhcp_pid" 2>/dev/null || true
            fi
          fi
        fi
        stale_addr=$(port_address "$gateway_if")
        if [[ -n $stale_addr ]]; then
          ifconfig "$gateway_if" inet "$stale_addr" delete >/dev/null 2>&1 || true
        fi
        route -q delete default >/dev/null 2>&1 || true
        route -q add default "$router" -ifp wlan0 >/dev/null 2>&1 || true
      else
        route -q change default "$router" -ifp wlan0 >/dev/null 2>&1 || true
      fi
      gateway_if=$(route -n get default 2>/dev/null | awk '/interface:/ { print $2; exit }')
    fi
  fi
  if [[ $gateway_if != wlan0 ]]; then
    if [[ -n $gateway_if ]]; then
      printf 'Wi-Fi has an IP address, but %s owns the default route. Disconnect that interface and retry Wi-Fi to install over Wi-Fi.\n' "$gateway_if" >"$error_file"
    else
      printf '%s\n' 'Wi-Fi has an IP address, but no default route. Check the DHCP gateway and retry.' >"$error_file"
    fi
    return 1
  fi
}

use_wifi() {
  local dev=$1 ssid psk hidden=false status authentication enterprise_args
  # wlan0 is the one wireless interface; move it to the adapter chosen.
  if [[ $(sysctl -n net.wlan.0.%parent 2>/dev/null) != "$dev" ]]; then
    ifconfig wlan0 destroy >/dev/null 2>&1
    ifconfig wlan0 create wlandev "$dev" >/dev/null 2>&1 || { notice "Could not use $dev" 3; return 1; }
  fi

  step "Connect to Wi-Fi"
  ssid=$( { gum spin --show-output --spinner pulse --title "Scanning for networks..." -- \
      bash -c "$(declare -f wifi_scan); wifi_scan"; echo "Other network..."; } |
    gum choose --height 12 --header "Wi-Fi network on $dev") && status=0 || status=$?
  ((status == 0)) && [[ -n $ssid ]] || return 1
  if [[ $ssid == "Other network..." ]]; then
    ssid=$(gum input --placeholder "Network name" --prompt.foreground="#845DF9" --prompt "Name> ") || return 1
    [[ -n $ssid ]] || return 1
    hidden=true
  fi

  authentication=$(gum choose --header 'Wi-Fi authentication' 'Personal or open network' 'Enterprise (802.1X)') || return 1
  if [[ $authentication == 'Enterprise (802.1X)' ]]; then
    enterprise_args=(--live wlan0 "$ssid")
    [[ $hidden != true ]] || enterprise_args+=(--hidden)
    if "$ISO_SHARE/omarchy-wifi-enterprise" "${enterprise_args[@]}"; then
      net_mode=wifi net_if=$dev wifi_ssid=$ssid wifi_psk='' wifi_hidden=$hidden
      wifi_enterprise_profile=/tmp/daemonarchy-enterprise-profile.json
      return 0
    fi
    notice 'Enterprise Wi-Fi did not connect. Check the CA, server domain and credentials.' 3
    return 1
  fi

  psk=$(gum input --password --placeholder "Leave empty for an open network" \
    --prompt.foreground="#845DF9" --prompt "Password> ") || return 1

  if gum spin --spinner pulse --title "Connecting to $ssid..." -- \
    bash -c "$(declare -f port_address wifi_connect); wifi_connect \"\$1\" \"\$2\" \"\$3\"" _ "$ssid" "$psk" "$hidden"; then
    net_mode=wifi net_if=$dev wifi_ssid=$ssid wifi_psk=$psk wifi_hidden=$hidden
    wifi_enterprise_profile=''
    notice "Wi-Fi connected; DHCP address on wlan0: $(port_address wlan0)."
  else
    notice "$(cat /tmp/daemonarchy-wifi-connect-error 2>/dev/null || echo "Could not connect to $ssid")" 3
    return 1
  fi
}

network_step() {
  local choice status ifc via connected options wifi_addr
  local mode=${1:-install}
  while true; do
    step "Network"
    if [[ $mode == remote-debug ]]; then
      say "Configure a network address so your agent can reach this machine."
      say --foreground 8 "Internet access is not required for remote debug."
    else
      say --foreground 8 "Daemonarchy downloads most of its packages during the install."
    fi
    echo
    network_summary
    if [[ $net_mode == wifi ]]; then
      wifi_addr=$(port_address wlan0)
      via=$(default_port)
      say "wlan0 IPv4: ${wifi_addr:-none}; default route: ${via:-none}"
    fi
    echo

    connected=false
    if [[ $mode == remote-debug ]]; then
      if network_has_address; then
        connected=true
        say "Network address ready for remote debug."
      else
        say --foreground 3 "Choose DHCP, Wi-Fi, or manual setup to obtain an address."
      fi
    elif online; then
      connected=true
      via=$(default_port)
      [[ $net_mode == wifi ]] && via="$via ($wifi_ssid)"
      say "Package repository reachable securely through $via."
    else
      network_failure
    fi
    echo

    options=()
    if $connected || [[ ${1:-} == allow-offline ]]; then options+=("Continue"); fi
    for ifc in $(ether_ports); do
      options+=("Use DHCP on $ifc" "Set up $ifc by hand")
    done
    for ifc in $(wifi_adapters); do options+=("Join Wi-Fi with $ifc"); done
    options+=("Set date and time" "Synchronize time over network" "Open debug shell" "Check again")
    [[ $mode == remote-debug ]] && options+=("Back to installer menu")

    choice=$(gum choose --height 12 --header "Network" "${options[@]}") && status=0 || status=$?
    if ((status != 0)); then
      [[ $mode == remote-debug ]] && return 1
      ((status == OMARCHY_FORM_BACK)) && continue
      abort
    fi

    case $choice in
      "Set date and time") set_clock_manually ;;
      "Synchronize time over network") sync_clock_network ;;
      "Open debug shell") "$(dirname "$0")/remote-debug" shell ;;
      "Back to installer menu") return 1 ;;
      Continue)
        if [[ $mode == remote-debug ]] && ! network_has_address; then continue; fi
        # Keep what was chosen; a connection DHCP made at boot is just DHCP.
        if [[ $net_mode == dhcp ]]; then net_if=$(default_port); fi
        return 0
        ;;
      "Join Wi-Fi with "*) use_wifi "${choice#Join Wi-Fi with }" ;;
      "Use DHCP on "*) use_dhcp "${choice#Use DHCP on }" ;;
      "Set up "*" by hand") ifc=${choice#Set up }; use_static "${ifc% by hand}" ;;
    esac
  done
}

apple_firmware_step() {
  local choice image previous_stage mode=${1:-required}
  local options=("Download Apple's recovery image using Ethernet"
    "Use BaseSystem.dmg from mounted media"
    "Use an existing verified private stage"
    "Configure wired network" "Open debug shell" "Stop installation")
  [[ $(kenv smbios.system.product 2>/dev/null || true) == MacBookPro16,1 ]] || return 0
  if ! apple_firmware_hardware; then
    notice 'The expected BCM4364 B3 board was not detected. This firmware profile cannot be used.' 4
    return 1
  fi
  if [[ -d $APPLE_FIRMWARE_STAGE ]] && apple_firmware_verify_live &&
     apple_firmware_radio_attached; then
    return 0
  fi
  if apple_firmware_preloaded && apple_firmware_radio_attached; then
    return 0
  fi
  [[ $mode != optional ]] || options+=("Back to installer menu")
  while true; do
    step "MacBook Wi-Fi firmware"
    say "This MacBook needs four Apple board files before its Wi-Fi radio can attach."
    say --foreground 8 "The installer verifies the recovery image and files; no firmware ships in the public ISO."
    echo
    choice=$(gum choose --header "Choose a firmware source" "${options[@]}") || abort
    case $choice in
      "Download Apple's recovery image using Ethernet")
        step "Downloading and verifying Apple recovery firmware"
        if apple_firmware_prepare download; then break; fi
        notice "Firmware download or radio attachment failed. Check the network and retry." 4
        ;;
      "Use BaseSystem.dmg from mounted media")
        image=$(gum input --placeholder "/media/usb/BaseSystem.dmg" \
          --prompt.foreground="#845DF9" --prompt "Image path> ") || continue
        step "Verifying the selected Apple recovery image"
        if apple_firmware_prepare image "$image"; then break; fi
        notice "The image, firmware or radio attachment failed verification. Check the path and retry." 4
        ;;
      "Use an existing verified private stage")
        image=$(gum input --placeholder "/tmp/daemonarchy-firmware-stage" \
          --prompt.foreground="#845DF9" --prompt "Stage path> ") || continue
        previous_stage=$APPLE_FIRMWARE_STAGE
        APPLE_FIRMWARE_STAGE=$image
        if apple_firmware_prepare existing; then break; fi
        APPLE_FIRMWARE_STAGE=$previous_stage
        notice "The private stage or radio attachment failed verification." 4
        ;;
      "Configure wired network") network_step allow-offline ;;
      "Open debug shell") "$(dirname "$0")/remote-debug" shell ;;
      "Back to installer menu") return 0 ;;
      "Stop installation") abort ;;
    esac
  done
}

