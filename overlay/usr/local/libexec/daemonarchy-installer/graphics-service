#!/bin/sh
# PROVIDE: daemonarchy_graphics
# REQUIRE: LOGIN sshd
# BEFORE: sddm
# KEYWORD: nojail
# Desktop drivers load after an explicitly enabled SSH service, so a display
# failure cannot prevent its startup merely through rc ordering.
. /etc/rc.subr
name=daemonarchy_graphics
rcvar=daemonarchy_graphics_enable
start_cmd=daemonarchy_graphics_start
stop_cmd=:

daemonarchy_graphics_start()
{
    ready=/var/run/daemonarchy-graphics.ready
    nodriver=/var/run/daemonarchy-graphics.nodriver
    log=/var/log/daemonarchy-graphics.log
    rm -f "$ready" "$nodriver"
    if [ "$(kenv -q boot_safe 2>/dev/null)" = YES ] ||
        [ "$(kenv -q daemonarchy_rescue 2>/dev/null)" = YES ] ||
        ! checkyesno sddm_enable; then
        echo 'Graphical startup disabled; desktop drivers were not loaded.' >>"$log"
        return 0
    fi
    if checkyesno sshd_enable && ! service sshd onestatus >/dev/null 2>&1; then
        echo 'SSH was requested but is unavailable; leaving graphical startup disabled.' >>"$log"
        return 1
    fi
    drm_drivers=
    for module in $daemonarchy_graphics_modules; do
        case "$module" in
            linux|linux64) ;;
            amdgpu|radeonkms|i915kms) drm_drivers="$drm_drivers drmn" ;;
            nvidia-drm) drm_drivers="$drm_drivers nvidia" ;;
            virtio_gpu_drm) drm_drivers="$drm_drivers virtio_gpu_drm" ;;
            *) echo "Unsupported graphics module: $module" >>"$log"; return 1 ;;
        esac
        echo "Loading $module after SSH startup" >>"$log"
        kldstat -q -n "$module.ko" || kldload "$module" >>"$log" 2>&1 || return 1
    done
    case "$drm_drivers" in
        *virtio_gpu_drm*)
            # The loader preloads the driver so it outranks the kernel's vtgpu(4), but its first
            # attach fails (the DRM core initialises after devices attach). Attach it again now.
            if ! /usr/sbin/devinfo 2>>"$log" | /usr/bin/awk '$1 ~ /^virtio_gpu_drm[0-9]+$/ { found = 1 } END { exit !found }'; then
                gpu=$(/usr/sbin/pciconf -l 2>>"$log" | /usr/bin/awk '/vendor=0x1af4 device=0x1050/ { split($1, a, "@"); sub(/:$/, "", a[2]); print a[1], a[2]; exit }')
                set -- $gpu
                if [ -z "${2:-}" ]; then
                    echo 'No VirtIO GPU PCI device to attach; leaving graphics unready.' >>"$log"
                    return 1
                fi
                echo "Attaching $2 to virtio_gpu_drm (was $1)" >>"$log"
                /usr/sbin/devctl detach "$1" >>"$log" 2>&1 || true
                /usr/sbin/devctl attach "$2" >>"$log" 2>&1 || { echo "Cannot attach $2." >>"$log"; return 1; }
            fi ;;
    esac
    if [ -z "$drm_drivers" ]; then
        # The desktop (Hyprland under SDDM) needs a DRM/KMS device. Without a
        # supported driver (VirtualBox, QEMU standard VGA or QXL) SDDM would
        # hold a black screen; stay on the ttyv0 rescue console, which says why.
        echo 'No supported desktop graphics driver for this display; staying on the console.' >>"$log"
        touch "$nodriver"
        return 0
    fi
    if [ -n "$drm_drivers" ]; then
        # kldload can succeed after device_attach failed. DRM may even leave
        # character nodes behind. Non-verbose devinfo lists attached devices;
        # reject disabled/suspended devices too. Do not query DRM sysctls here.
        if ! devices=$(/usr/sbin/devinfo 2>>"$log"); then
            echo 'Cannot inspect attached graphics devices; leaving graphics unready.' >>"$log"
            return 1
        fi
        for driver in $drm_drivers; do
            if ! printf '%s\n' "$devices" | /usr/bin/awk -v driver="$driver" '
                $1 ~ "^" driver "[0-9]+$" && NF == 1 { attached = 1 }
                END { exit !attached }
            '; then
                echo "No attached active $driver device after graphics module loading; leaving graphics unready." >>"$log"
                return 1
            fi
        done
        card=NO render=NO
        for node in /dev/dri/card[0-9]*; do
            [ ! -c "$node" ] || card=YES
        done
        for node in /dev/dri/renderD[0-9]*; do
            [ ! -c "$node" ] || render=YES
        done
        if [ "$card" != YES ] || [ "$render" != YES ]; then
            echo 'Missing DRM card/render character devices; leaving graphics unready.' >>"$log"
            return 1
        fi
    fi
    # These are startup prerequisites, not proof that a compositor can render.
    touch "$ready"
}
load_rc_config "$name"
: "${daemonarchy_graphics_enable:=NO}"
: "${daemonarchy_graphics_modules:=}"
run_rc_command "$1"
