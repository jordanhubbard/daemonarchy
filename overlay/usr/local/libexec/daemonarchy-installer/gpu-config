#!/usr/local/bin/bash
# Sourced by install and tests. No module is loaded on the live system.
# gpu_arch is the image architecture (amd64 or aarch64). NVIDIA is amd64-only.
# The DRM port builds on aarch64 too, but only the core and the VirtIO GPU driver
# (a KMS device for QEMU and UTM guests): an aarch64 image selects drm-612-kmod for
# a VirtIO GPU (1af4:1050) and no driver for any other GPU.
gpu_arch=${gpu_arch:-amd64}

gpu_kms_packages() {
  case "$gpu_arch" in
    amd64|aarch64) echo drm-612-kmod gpu-firmware-kmod ;;
    *) echo "Unsupported GPU image architecture: $gpu_arch" >&2; return 1 ;;
  esac
}

gpu_select() {
  local inventory=$1 ids=$2 vendor device subvendor subdevice module family
  [[ -r $inventory && -s $ids ]] || { echo 'Missing GPU inventory or selection table' >&2; return 1; }
  gpu_modules=() gpu_packages=() gpu_userspace_packages=()
  gpu_nvidia=false gpu_other=false gpu_navi14=false gpu_vulkan=false gpu_virtio=false gpu_intel_guc=false
  gpu_kms_packages >/dev/null || return 1
  while read -r vendor device subvendor subdevice; do
    module='' family=''
    if [[ $gpu_arch != amd64 && ! ( $vendor == 1af4 && $device == 1050 ) ]]; then
      printf 'GPU %s:%s: no %s KMS driver is packaged in this image.\n' "$vendor" "$device" "$gpu_arch" >&2
      continue
    fi
    case "$vendor" in
      8086) module=i915kms ;;
      1af4) [[ $device != 1050 ]] || module=virtio_gpu_drm ;;
      1002|10de)
        read -r module family < <(awk -v v="$vendor" -v d="$device" -v sv="$subvendor" -v sd="$subdevice" '
          $1 == v && $2 == d && ($3 == "*" || $3 == sv) && ($4 == "*" || $4 == sd) { print $5, $6; exit }
        ' "$ids") || true
        if [[ $vendor == 1002 && -z $module ]]; then
          # amdgpu also uses IP discovery for newer devices, not just PCI IDs.
          module=amdgpu
        fi
        ;;
    esac
    # Meteor Lake and Arrow Lake graphics cannot start without the GuC. The
    # driver's automatic setting resolves to off here, which leaves the GPU
    # wedged, so Hyprland cannot create an EGL context and the screen stays
    # black. Mask 3 loads the GuC and HuC (verified on a MSI Raider 18 HX).
    if [[ $vendor == 8086 && $device =~ ^(7d40|7d41|7d45|7d51|7d55|7d60|7d67|7dd1|7dd5)$ ]]; then
      gpu_intel_guc=true
    fi
    case "$module" in
      nvidia-drm) gpu_nvidia=true; gpu_vulkan=true ;;
      amdgpu|i915kms) gpu_other=true; gpu_vulkan=true ;;
      radeonkms) gpu_other=true ;;
      virtio_gpu_drm)
        gpu_other=true; gpu_virtio=true
        printf 'VirtIO graphics: Hyprland requires a host display with VirGL 3D enabled.\n' >&2
        ;;
      *) printf 'GPU %s:%s: no supported desktop driver in this image.\n' "$vendor" "$device" >&2; continue ;;
    esac
    if [[ $module == radeonkms ]]; then
      printf 'GPU %s:%s: legacy Radeon (%s); KMS selection is not Hyprland qualification.\n' "$vendor" "$device" "$family" >&2
    fi
    [[ " ${gpu_modules[*]} " == *" $module "* ]] || gpu_modules+=("$module")
    if [[ $vendor == 1002 && $device =~ ^(7340|7341|7347|734f)$ ]]; then
      gpu_navi14=true
    fi
  done < <(awk '
    /class=0x03/ {
      v=d=sv=sd=""
      for (i=1; i<=NF; i++) {
        split($i,a,"="); val=tolower(a[2]); sub(/^0x/,"",val)
        if(a[1]=="vendor") v=val
        if(a[1]=="device") d=val
        if(a[1]=="subvendor") sv=val
        if(a[1]=="subdevice") sd=val
      }
      if(v!="" && d!="") print v,d,(sv=="" ? "-" : sv),(sd=="" ? "-" : sd)
    }' "$inventory")
  if $gpu_nvidia; then
    # linux.ko must be loaded before nvidia.ko so the Linuxulator can open the GPU.
    gpu_packages=(nvidia-driver nvidia-kmod nvidia-drm-612-kmod linux-nvidia-libs)
    gpu_modules=(linux linux64 "${gpu_modules[@]}")
  fi
  if $gpu_navi14; then
    gpu_packages+=(gpu-firmware-amd-kmod-navi14)
  fi
  # Vulkan is the common graphics layer. Mesa supplies RADV for amdgpu and ANV
  # for i915; nvidia-driver supplies NVIDIA's own ICD. Legacy radeonkms has no
  # Vulkan driver here. CUDA remains a separate NVIDIA extra.
  if $gpu_vulkan; then
    gpu_userspace_packages=(vulkan-loader mesa-dri)
  elif $gpu_virtio; then
    # Classic VirGL provides OpenGL; this driver does not implement Venus/Vulkan.
    gpu_userspace_packages=(mesa-dri)
  fi
  kld_list="${gpu_modules[*]}"
}

# Resolve exact image package versions before the installer writes any disk.
gpu_resolve_packages() {
  local manifest=$1 repo=$2 name version required kms
  [[ -s $manifest ]] || { echo 'Missing GPU package manifest' >&2; return 1; }
  kms=$(gpu_kms_packages) || return 1
  gpu_exact_packages=() gpu_lock_packages=()
  for required in $kms "${gpu_packages[@]}"; do
    [[ $(awk -v n="$required" '$1 == n { count++ } END { print count+0 }' "$manifest") == 1 ]] || {
      echo "Missing or duplicate GPU package: $required" >&2; return 1;
    }
  done
  while read -r name version; do
    case "$name" in
      drm-612-kmod) ;;
      gpu-firmware-*) ;;
      nvidia-driver|nvidia-kmod|nvidia-drm-612-kmod|linux-nvidia-libs) $gpu_nvidia || continue ;;
      *) echo "Unexpected GPU manifest entry: $name" >&2; return 1 ;;
    esac
    [[ $name =~ ^[a-zA-Z0-9_-]+$ && $version =~ ^[a-zA-Z0-9._,+-]+$ && -f $repo/All/$name-$version.pkg ]] || {
      echo "Missing or invalid GPU payload: $name-$version" >&2; return 1;
    }
    gpu_exact_packages+=("$name-$version")
    gpu_lock_packages+=("$name")
  done <"$manifest"
}

gpu_prepare_live_compat() {
  $gpu_nvidia || return 0
  # linux_base's pre-install hook checks the running kernel, even with pkg -r.
  # Load only ABI support here; GPU attachment remains deferred until boot.
  local module
  for module in linux linux64; do
    if ! kldstat -q -n "$module.ko"; then
      kldload "$module" || {
        echo "Cannot enable $module compatibility for NVIDIA package installation." >&2
        return 1
      }
    fi
  done
  [[ $(sysctl -n kern.features.linux64 2>/dev/null) == 1 ]] || {
    echo 'The live kernel has no active 64-bit Linux support; installation has not changed any disks.' >&2
    return 1
  }
}

gpu_write_config() {
  local target=$1 helper_dir
  helper_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
  mkdir -p "$target/usr/local/etc/rc.d" "$target/etc/rc.conf.d"
  install -m 0755 "$helper_dir/graphics-service" "$target/usr/local/etc/rc.d/daemonarchy-graphics"
  {
    printf '\ndaemonarchy_graphics_enable="YES"\n'
    printf 'daemonarchy_graphics_modules="%s"\n' "${gpu_modules[*]}"
    # Prevent automatic GPU attachment before the ordered graphics service.
    printf 'devmatch_blocklist="amdgpu radeonkms i915kms nvidia nvidia-modeset nvidia-drm virtio_gpu_drm"\n'
  } >>"$target/etc/rc.conf"
  cat >"$target/etc/rc.conf.d/sddm" <<'EOF_SDDM'
# Safe Mode and the recovery loader setting must preserve console/SSH access.
if [ "$(kenv -q boot_safe 2>/dev/null)" = YES ] ||
    [ "$(kenv -q daemonarchy_rescue 2>/dev/null)" = YES ] ||
    [ ! -e /var/run/daemonarchy-graphics.ready ]; then
    sddm_enable=NO
fi
EOF_SDDM
  if $gpu_intel_guc; then
    printf '\ncompat.linuxkpi.i915_enable_guc="3"\n' >>"$target/boot/loader.conf"
  fi
  if $gpu_nvidia; then
    printf '\nhw.nvidiadrm.modeset="1"\n' >>"$target/boot/loader.conf"
    # The ports disable fbdev by default; do not copy Linux fbdev/GSP options.
    if ! $gpu_other; then
      mkdir -p "$target/usr/local/share/uwsm/env.d"
      cat >"$target/usr/local/share/uwsm/env.d/90-daemonarchy-nvidia" <<'EOF'
# Single-vendor NVIDIA install. Mixed GPUs keep automatic EGL/GBM selection.
export GBM_BACKEND=nvidia-drm
export __GLX_VENDOR_LIBRARY_NAME=nvidia
EOF
    fi
    if [[ -f $target/etc/rc.conf ]] && ! grep -q '^linux_enable=' "$target/etc/rc.conf"; then
      printf '\nlinux_enable="YES"\n' >>"$target/etc/rc.conf"
    fi
  fi
}
