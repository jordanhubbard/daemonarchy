#!/usr/local/bin/bash

# Started from root's login on the live system's first console.
#
# With a drive labeled CIDATA that holds daemonarchy-install.conf (the cloud-init
# NoCloud label the Arch ISO uses for the same purpose), the install runs
# unattended from that file and the machine powers off when it is done.
# Otherwise the configurator asks its questions first.

# The install runs through tee for its log; report the install's own status.
set -o pipefail

ISO_LIBEXEC=/usr/local/libexec/daemonarchy-installer
export DAEMONARCHY_INSTALL_CONF=/tmp/daemonarchy-install.conf
# A privately prepared rescue image never enters either installation path,
# including when an old unattended-install CIDATA drive is still attached.
if [[ -s /usr/local/share/daemonarchy-installer/headless/authorized_keys ]]; then
  echo 'Headless rescue boot: installation is disabled; SSH listens on port 2222.'
  exec /bin/sh
fi
log=/tmp/daemonarchy-install.log
status_file=/tmp/daemonarchy-install.status

find_cidata() {
  local dev mnt=/tmp/cidata
  for dev in /dev/msdosfs/CIDATA /dev/iso9660/CIDATA /dev/ufs/CIDATA; do
    [[ -e $dev ]] || continue
    mkdir -p "$mnt"
    case "$dev" in
      */msdosfs/*) mount -t msdosfs -o ro "$dev" "$mnt" ;;
      */iso9660/*) mount -t cd9660 -o ro "$dev" "$mnt" ;;
      *) mount -o ro "$dev" "$mnt" ;;
    esac 2>/dev/null || continue
    if [[ -f $mnt/daemonarchy-install.conf ]]; then
      install -m 0600 "$mnt/daemonarchy-install.conf" "$DAEMONARCHY_INSTALL_CONF"
      umount "$mnt"
      return 0
    fi
    umount "$mnt"
  done
  return 1
}

# The log also goes to the first serial port when there is one, for installs
# nobody is watching. When it is a console, a getty already holds ttyu0 open
# (3-wire, so a second open does not wait for a carrier) and the callout device
# is busy; otherwise use the callout device, which never waits.
serial=()
if pgrep -qf "getty.* ttyu0" && [[ -c /dev/ttyu0 ]]; then
  serial=(/dev/ttyu0)
elif [[ -c /dev/cuau0 ]]; then
  serial=(/dev/cuau0)
fi

# Linux fbcon selects Terminus 16x32 when the pixel grid would otherwise be a
# huge character cell count. FreeBSD vt stays on 8x16, so the 16-inch MacBook's
# 3584x2240 console is 448 columns and unreadable. terminus-b32 is that same
# Terminus face and is already in the base system. A lower mode would only blur
# the panel; the graphics driver modesets back to native anyway.
console_font() {
  local cols dev term
  dev=$(tty 2>/dev/null || true)
  [[ $dev == /dev/ttyv0 ]] || return 0
  term=${DAEMONARCHY_CONSOLE_TTY:-/dev/tty}
  [[ -r $term && -w $term ]] || return 0
  IFS=' ' read -r _ cols < <(stty size <"$term" 2>/dev/null) || return 0
  [[ ${cols:-0} -gt 200 ]] || return 0
  [[ -r ${DAEMONARCHY_CONSOLE_FONT:-/usr/share/vt/fonts/terminus-b32.fnt} ]] || return 0
  vidcontrol -f terminus-b32 <"$term" >"$term" 2>&1 || true
}
console_font

# Run the install in the background with everything it prints going to the
# log, and draw the install screen from that log until it finishes.
run_install() {
  rm -f "$status_file"
  : >"$log"
  (
    "$ISO_LIBEXEC/install" 2>&1 | tee "${serial[@]}" >>"$log"
    echo "$?" >"$status_file"
  ) &
  "$ISO_LIBEXEC/dashboard" "$log" "$status_file"
}

if find_cidata; then
  echo "Daemonarchy autoinstall: using daemonarchy-install.conf from the CIDATA drive."
  # Configs may give the password in clear text only; hash it as the
  # configurator would.
  # shellcheck disable=SC1090
  source "$DAEMONARCHY_INSTALL_CONF"
  if [[ -z ${password_hash:-} ]]; then
    printf 'password_hash=%q\n' "$(printf '%s' "$password" | openssl passwd -6 -stdin)" >>"$DAEMONARCHY_INSTALL_CONF"
  fi
  # The same network check as the configurator, without questions: it honors
  # net_* and wifi_* answers and records the chosen interface and DNS.
  echo "Daemonarchy autoinstall: checking the network."
  if ! "$ISO_LIBEXEC/network-bringup" auto "$DAEMONARCHY_INSTALL_CONF" 2>&1 | tee "${serial[@]}"; then
    echo "Daemonarchy autoinstall FAILED before any disk change: no usable network."
    echo "See /tmp/daemonarchy-network/log, fix the network or daemonarchy-install.conf, and reboot."
    exec /bin/sh
  fi
  if run_install; then
    echo "Daemonarchy autoinstall finished; powering off."
    shutdown -p now
  else
    echo "Daemonarchy autoinstall FAILED; see $log"
  fi
  exec /bin/sh
fi

"$ISO_LIBEXEC/configurator" || exec /bin/sh

if run_install; then
  echo
  if gum confirm --affirmative "Reboot now" --negative "Stay in the installer" "Reboot into Daemonarchy?"; then
    shutdown -r now
  fi
fi
exec /bin/sh
