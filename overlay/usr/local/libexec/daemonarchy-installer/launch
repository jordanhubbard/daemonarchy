#!/usr/local/bin/bash

# Started from root's login on the live system's first console.
#
# With a drive labeled CIDATA that holds daemonarchy-install.conf (the cloud-init
# NoCloud label the Arch ISO uses for the same purpose), the install runs
# unattended from that file and the machine powers off when it is done.
# Otherwise the configurator asks its questions first.
#
# The installer's own exit status (its status file) decides what happens next,
# never the progress screen's: a progress display problem is reported in the
# summary and does not turn a finished installation into a failure. A failure
# stays on the screen with an explanation and a menu (install-failed). An
# unattended install never waits for a key: it prints the same explanation and
# opens a shell, as before.

# The install runs through tee for its log; report the install's own status.
set -o pipefail

ISO_LIBEXEC=/usr/local/libexec/daemonarchy-installer
export DAEMONARCHY_INSTALL_CONF=/tmp/daemonarchy-install.conf
# A privately prepared rescue image never enters either installation path,
# including when an old unattended-install CIDATA drive is still attached.
if [[ -s /usr/local/share/daemonarchy-installer/headless/authorized_keys ]]; then
  echo 'Headless rescue boot: installation is disabled; SSH listens on port 2222.'
  exec /bin/sh
fi
log=/tmp/daemonarchy-install.log
status_file=/tmp/daemonarchy-install.status
# The progress screen's final summary, printed here after its tmux session ends.
summary_file=/tmp/daemonarchy-install.summary

# The root filesystem is the install stick. Keep the reboot tools in memory so the
# final reboot or power-off does not need the stick (see live-power).
"$ISO_LIBEXEC/live-power" prepare || true

# Sound (sound.py through the sound wrapper) never blocks or fails anything
# here. The player starts only where sound is allowed: a local console with an
# audio device, not a serial console, and not an unattended install unless
# its daemonarchy-install.conf or the loader asks (sound=on|quiet|off,
# daemonarchy.sound=on|quiet|off).
sound() { "$ISO_LIBEXEC/sound" "$@" >/dev/null 2>&1 </dev/null || true; }
# The vt(4) console: 16 colors for every screen, and a console that may make sound.
[[ $(tty 2>/dev/null) == /dev/ttyv* ]] && export DAEMONARCHY_CONSOLE=vt

find_cidata() {
  local dev mnt=/tmp/cidata
  for dev in /dev/msdosfs/CIDATA /dev/iso9660/CIDATA /dev/ufs/CIDATA; do
    [[ -e $dev ]] || continue
    mkdir -p "$mnt"
    case "$dev" in
      */msdosfs/*) mount -t msdosfs -o ro "$dev" "$mnt" ;;
      */iso9660/*) mount -t cd9660 -o ro "$dev" "$mnt" ;;
      *) mount -o ro "$dev" "$mnt" ;;
    esac 2>/dev/null || continue
    if [[ -f $mnt/daemonarchy-install.conf ]]; then
      install -m 0600 "$mnt/daemonarchy-install.conf" "$DAEMONARCHY_INSTALL_CONF"
      umount "$mnt"
      return 0
    fi
    umount "$mnt"
  done
  return 1
}

# The log also goes to the first serial port when there is one, for installs
# nobody is watching. When it is a console, a getty already holds ttyu0 open
# (3-wire, so a second open does not wait for a carrier) and the callout device
# is busy; otherwise use the callout device, which never waits.
serial=()
if pgrep -qf "getty.* ttyu0" && [[ -c /dev/ttyu0 ]]; then
  serial=(/dev/ttyu0)
elif [[ -c /dev/cuau0 ]]; then
  serial=(/dev/cuau0)
fi

# Linux fbcon selects Terminus 16x32 when the pixel grid would otherwise be a
# huge character cell count. FreeBSD vt stays on 8x16, so the 16-inch MacBook's
# 3584x2240 console is 448 columns and unreadable. terminus-b32 is that same
# Terminus face and is already in the base system. A lower mode would only blur
# the panel; the graphics driver modesets back to native anyway.
console_font() {
  local cols dev term
  dev=$(tty 2>/dev/null || true)
  [[ $dev == /dev/ttyv0 ]] || return 0
  term=${DAEMONARCHY_CONSOLE_TTY:-/dev/tty}
  [[ -r $term && -w $term ]] || return 0
  IFS=' ' read -r _ cols < <(stty size <"$term" 2>/dev/null) || return 0
  [[ ${cols:-0} -gt 200 ]] || return 0
  [[ -r ${DAEMONARCHY_CONSOLE_FONT:-/usr/share/vt/fonts/terminus-b32.fnt} ]] || return 0
  vidcontrol -f terminus-b32 <"$term" >"$term" 2>&1 || true
}
console_font

# Run the install in the background with everything it prints going to the
# log, and draw the install screen from that log until it finishes. Succeeds
# only when the installer itself exited 0; install_result is its status, or
# empty when the screen was left while the installer still runs.
run_install() {
  rm -f "$status_file" "$summary_file"
  : >"$log"
  (
    "$ISO_LIBEXEC/install" 2>&1 | tee "${serial[@]}" >>"$log"
    echo "$?" >"$status_file"
  ) &
  "$ISO_LIBEXEC/dashboard" "$log" "$status_file" --summary-file "$summary_file" || true
  install_result=
  [[ -s $status_file ]] || return 1
  install_result=$(<"$status_file")
  [[ $install_result =~ ^[0-9]{1,3}$ ]] && ((10#$install_result <= 255)) || install_result=1
  ((10#$install_result == 0)) || return 1
  if [[ -s $summary_file ]]; then cat "$summary_file"; fi
}

# Why the installation stopped, where its logs are and, at a console, a menu.
install_failed() {
  if [[ -z $install_result ]]; then
    echo "The install screen was closed while the installation is still running."
    echo "Follow it with: tail -f $log"
    return
  fi
  "$ISO_LIBEXEC/install-failed" "$install_result" "$log" "$summary_file"
}

# The live desktop entry promises no disk changes until the operator confirms,
# so its text-installer fallback never starts an unattended CIDATA install.
if [[ ${DAEMONARCHY_LIVE:-} != 1 ]] && find_cidata; then
  echo "Daemonarchy autoinstall: using daemonarchy-install.conf from the CIDATA drive."
  # Configs may give the password in clear text only; hash it as the
  # configurator would.
  # shellcheck disable=SC1090
  source "$DAEMONARCHY_INSTALL_CONF"
  export DAEMONARCHY_UNATTENDED=1
  [[ ${sound:-} =~ ^(on|quiet|off)$ ]] && export DAEMONARCHY_SOUND=$sound
  sound ensure
  sound play boot
  if [[ -z ${password_hash:-} ]]; then
    printf 'password_hash=%q\n' "$(printf '%s' "$password" | openssl passwd -6 -stdin)" >>"$DAEMONARCHY_INSTALL_CONF"
  fi
  # The same network check as the configurator, without questions: it honors
  # net_* and wifi_* answers and records the chosen interface and DNS.
  echo "Daemonarchy autoinstall: checking the network."
  if ! "$ISO_LIBEXEC/network-bringup" auto "$DAEMONARCHY_INSTALL_CONF" 2>&1 | tee "${serial[@]}"; then
    echo "Daemonarchy autoinstall FAILED before any disk change: no usable network."
    echo "See /tmp/daemonarchy-network/log, fix the network or daemonarchy-install.conf, and reboot."
    exec /bin/sh
  fi
  if run_install; then
    echo "Daemonarchy autoinstall finished; powering off."
    "$ISO_LIBEXEC/live-power" poweroff
  else
    # DAEMONARCHY_UNATTENDED: the explanation only, no menu and no key to wait for.
    install_failed 2>&1 | tee "${serial[@]}"
    echo "Daemonarchy autoinstall FAILED; see $log"
  fi
  exec /bin/sh
fi

sound ensure
"$ISO_LIBEXEC/configurator" || exec /bin/sh

if run_install; then
  echo
  echo "The installation is finished. Do not remove the USB stick while this screen is up:"
  echo "the installer runs from it. Power off first, then remove it."
  case $(gum choose --header "What next?" \
         "Power off (then remove the USB stick and power on)" "Reboot now" "Stay in the installer") in
    Power*) "$ISO_LIBEXEC/live-power" poweroff ;;
    Reboot*) "$ISO_LIBEXEC/live-power" reboot ;;
  esac
else
  install_failed
fi
exec /bin/sh
