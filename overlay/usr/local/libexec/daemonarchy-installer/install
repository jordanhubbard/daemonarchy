#!/usr/local/bin/bash

# Install Daemonarchy (Omarchy on FreeBSD) from the answers the configurator (or an
# autoinstall config) left in $DAEMONARCHY_INSTALL_CONF.
#
# Whole-disk mode creates the following layout. Shared-disk modes replace only
# the selected OS/data partition or allocate one in the selected free extent:
# Whole-disk layout:
#   p1  EFI system partition (FreeBSD loader, also as the fallback BOOTX64.EFI,
#       or BOOTAA64.EFI on aarch64)
#   p2  swap
#   p3  ZFS pool "zroot" (GELI-encrypted with the user's password if asked),
#       laid out as bsdinstall does so bectl boot environments work
#   p4  BIOS boot code, in the alignment gap before p1 (amd64; left empty on
#       aarch64, which boots by UEFI only)
#
# The base system and kernel come from the release sets on the ISO. The
# Omarchy ports, the GPU and Wi-Fi kernel modules, and the matching Linux NVIDIA
# libraries come from the package repository on the ISO,
# everything else from pkg.FreeBSD.org.

set -euo pipefail

DAEMONARCHY_INSTALL_CONF=${DAEMONARCHY_INSTALL_CONF:-/tmp/daemonarchy-install.conf}
ISO_SHARE=/usr/local/share/daemonarchy-installer
DIST=/usr/freebsd-dist
REPO=$ISO_SHARE/repo
TARGET=/mnt
POOL=zroot
ABI=$(cat "$ISO_SHARE/ABI")
case "$ABI" in
  FreeBSD:16:amd64) image_arch=amd64 efi_boot_file=BOOTX64.EFI ;;
  FreeBSD:16:aarch64) image_arch=aarch64 efi_boot_file=BOOTAA64.EFI ;;
  *) echo "Unsupported image ABI: $ABI" >&2; exit 1 ;;
esac
gpu_arch=$image_arch

# shellcheck disable=SC1090
source "$DAEMONARCHY_INSTALL_CONF"
source "$(dirname "$0")/disk-layout"
source "$(dirname "$0")/gpu-config"
source "$(dirname "$0")/checkout-options"
source "$(dirname "$0")/cuda-options"
source "$(dirname "$0")/install-diagnostics"
source "$(dirname "$0")/install-integrity"
source "$(dirname "$0")/rescue-setup"
source "$(dirname "$0")/secureboot-options"
source "$(dirname "$0")/package-repository"
source "$(dirname "$0")/apple-firmware"
source "$(dirname "$0")/sound-setup"
package_repository_prepare "$ISO_SHARE"
package_cache_validate
if [[ -n ${package_cache_url:-} && $package_repository_tag == "$package_repository_stable_tag" ]]; then
  echo "An iterative cache requires an explicitly versioned signed package feed." >&2
  exit 1
fi
package_cache_check_metadata
macbook_bcm4364=false
# The BCM4364 driver package exists only for the amd64 (Intel Mac) image.
if [[ $image_arch == amd64 && $(kenv smbios.system.product 2>/dev/null || true) == MacBookPro16,1 ]]; then
  macbook_bcm4364=true
fi
checkout_options_prepare "$ISO_SHARE/checkouts.json"
if [[ -n ${wifi_enterprise_profile:-} ]]; then
  [[ ${net_mode:-} == wifi ]] || { echo 'An enterprise profile requires Wi-Fi mode' >&2; exit 1; }
  "$ISO_SHARE/omarchy-wifi-enterprise" --validate "$wifi_enterprise_profile"
fi

log() { printf '\033[32m==>\033[0m %s\n' "$*"; }

# A wpa_supplicant.conf for one network. wpa_passphrase hashes the password, so
# no character in it can break the file.
# The control socket belongs to wheel and the file may be rewritten, so the
# desktop's Wi-Fi panel (omarchy-wifi, through wpa_cli) can join and forget
# networks without root.
wpa_network() {
  local ssid=$1 psk=$2 hidden=$3
  echo 'ctrl_interface=DIR=/var/run/wpa_supplicant GROUP=wheel'
  echo 'update_config=1'
  if [[ -n $psk ]]; then
    wpa_passphrase "$ssid" "$psk" | grep -v '^[[:space:]]*#psk='
  else
    printf 'network={\n\tssid="%s"\n\tkey_mgmt=NONE\n}\n' "$ssid"
  fi | if [[ $hidden == true ]]; then awk '/^}$/ { print "\tscan_ssid=1" } { print }'; else cat; fi
}

# Mark the start of a stage for the install screen (daemonarchy-installer/
# dashboard), which follows this log. @@step carries the wall-clock start so a
# screen that reads the log late still shows each stage's real elapsed time.
step() {
  printf '@@step %s %s\n' "$1" "$(date +%s)"
}

phase() {
  diagnostics_phase "$1"
  printf '@@phase %s\n' "$1"
  case $1 in
    disk) step partition ;;
    install) step packages ;;
    user) step account ;;
    *) step "$1" ;;
  esac
  log "$2"
}

# Name the target disk and pool so the screen's activity meters measure them.
# Device and pool names only; never a path, label or credential.
target() {
  [[ $2 =~ ^[A-Za-z][A-Za-z0-9_.:-]{0,63}$ ]] || return 0
  printf '@@target %s %s\n' "$1" "$2"
}

# Only report completed operations. Labels and phases are fixed protocol values;
# no account, path or credential is interpolated into JSON.
progress_count() {
  local current=$2 total=$3 label unit
  case $1 in
    disk) label='Storage preparation milestones'; unit=milestones ;;
    base) label='Release archives expanded'; unit=archives ;;
    *) return 1 ;;
  esac
  [[ $current =~ ^[0-9]+$ && $total =~ ^[0-9]+$ ]] || return 1
  printf '@@progress {"schema":"daemonarchy/installer-progress@1","phase":"%s","label":"%s","current":%s,"total":%s,"unit":"%s"}\n' "$1" "$label" "$current" "$total" "$unit"
}

cuda_setup_started=false
geli_debug_saved=
cleanup() {
  local status=$?
  if [[ -n ${fetch_events_pid:-} ]]; then kill "$fetch_events_pid" 2>/dev/null || true; fi
  if [[ -n ${fetch_events_dir:-} ]]; then rm -rf "$fetch_events_dir"; fi
  if [[ -n $geli_debug_saved ]]; then
    sysctl kern.geom.eli.debug="$geli_debug_saved" >/dev/null 2>&1 || true
  fi
  if $diagnostics_ready; then
    if ((status != 0)); then
      printf 'Installation exited with status %s.\n' "$status"
      diagnostics_result failed "$status" || true
    fi
    diagnostics_stop || true
  fi
  if $cuda_setup_started; then cuda_unmount_target "$TARGET" || true; fi
  umount "$TARGET/dev" 2>/dev/null || true
  umount "$TARGET/boot/efi" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

# An account name FreeBSD or a package already uses would fail at the very end,
# after the disk is erased; refuse it first (autoinstall configs skip the
# configurator's check).
if pw usershow "$username" >/dev/null 2>&1 || grep -qx -- "$username" "$ISO_SHARE/reserved-users" 2>/dev/null; then
  echo "The username '$username' is already used by FreeBSD or a package; choose another." >&2
  exit 1
fi

# ---------------------------------------------------------------- disk

# Selection and payload admission happen before partition writes. Detect only
# display-class PCI functions (never NVIDIA/AMD HDMI audio controllers).
gpu_inventory=$(mktemp)
pciconf -l >"$gpu_inventory"
gpu_select "$gpu_inventory" "$ISO_SHARE/gpu-ids"
rm -f "$gpu_inventory"
gpu_resolve_packages "$ISO_SHARE/gpu-packages" "$REPO"
gpu_prepare_live_compat
cuda_options_prepare
if $macbook_bcm4364; then
  apple_firmware_hardware || { echo 'The expected BCM4364 B3 board was not detected.' >&2; exit 1; }
  [[ -f /boot/modules/if_brcmfmac.ko ]] || {
    echo 'The live ISO lacks the kernel-matched BCM4364 driver.' >&2
    exit 1
  }
  ls "$REPO"/All/if_brcmfmac-kmod-*.pkg >/dev/null 2>&1 || {
    echo 'The ISO lacks the BCM4364 driver package for the installed system.' >&2
    exit 1
  }
  if [[ -d $APPLE_FIRMWARE_STAGE ]]; then
    apple_firmware_prepare download || { echo 'The imported MacBook firmware changed or could not attach.' >&2; exit 1; }
  elif ! apple_firmware_preloaded; then
    # An unattended install may provide an Apple image path. Otherwise use
    # Apple's pinned recovery download over its already configured network.
    # Offline sources come first so an install needs no Ethernet.
    if [[ -n ${apple_firmware_image:-} ]]; then
      apple_firmware_prepare image "$apple_firmware_image"
    else
      apple_firmware_prepare_internal || apple_firmware_prepare_media ||
        apple_firmware_prepare download
    fi || { echo 'MacBook firmware acquisition failed before disk changes.' >&2; exit 1; }
  fi
  apple_firmware_preloaded || { echo 'Verified BCM4364 board firmware is unavailable.' >&2; exit 1; }
  apple_firmware_radio_attached || { echo 'The BCM4364 wireless interface did not attach.' >&2; exit 1; }
  if [[ -d $APPLE_FIRMWARE_STAGE ]]; then
    apple_firmware_stage=$APPLE_FIRMWARE_STAGE
  fi
fi
secureboot_payload_prepare

install_mode=${install_mode:-whole_disk}
shared_install=false
if [[ $install_mode != whole_disk ]]; then
  shared_install=true
  POOL="daemonarchy-$(uuidgen | tr '[:upper:]' '[:lower:]' | cut -c1-8)"
fi
if zpool list -H -o name | grep -qxF "$POOL"; then
  echo "Pool $POOL is already imported. Refusing to export or overwrite it." >&2
  exit 1
fi
validate_install_layout
layout_backup=$(mktemp)
gpart backup "$disk" >"$layout_backup" 2>/dev/null || : >"$layout_backup"
phase disk "Preparing the selected installation space on $disk"
target disk "${disk#/dev/}"
progress_count disk 0 3
apply_install_layout
progress_count disk 1 3
if [[ $encrypt_installation == true ]]; then
  step encrypt
  log "Encrypting the ZFS partition"
  passfile=$(mktemp)
  printf '%s' "$password" >"$passfile"
  # GEOM_ELI announces each provider on the kernel console, which is the
  # installer's ttyv0. Silence its level-0 notices for this run only.
  if kldload -n geom_eli 2>/dev/null &&
     geli_debug_saved=$(sysctl -n kern.geom.eli.debug 2>/dev/null); then
    sysctl kern.geom.eli.debug=-1 >/dev/null 2>&1 || geli_debug_saved=
  fi
  # -g: the loader asks for the passphrase and hands the key to the kernel.
  geli init -b -g -e AES-XTS -l 256 -s 4096 -J "$passfile" "$zfs_dev"
  geli attach -j "$passfile" "$zfs_dev"
  rm -P -f "$passfile"
  zfs_dev=$zfs_dev.eli
fi

step pool
target pool "$POOL"
log "Creating the ZFS pool"
zpool create -f -o altroot="$TARGET" -O compress=lz4 -O atime=off -m none "$POOL" "$zfs_dev"
zfs create -o mountpoint=none "$POOL/ROOT"
# Inactive boot environments must never auto-mount over the selected root.
zfs create -o mountpoint=/ -o canmount=noauto "$POOL/ROOT/default"
zfs mount "$POOL/ROOT/default"
zfs create -o mountpoint=/home "$POOL/home"
zfs create -o mountpoint=/tmp -o exec=on -o setuid=off "$POOL/tmp"
zfs create -o mountpoint=/usr -o canmount=off "$POOL/usr"
zfs create -o setuid=off "$POOL/usr/ports"
zfs create "$POOL/usr/src"
zfs create -o mountpoint=/var -o canmount=off "$POOL/var"
for ds in audit crash log mail; do
  zfs create -o exec=off -o setuid=off "$POOL/var/$ds"
done
zfs create -o setuid=off "$POOL/var/tmp"
zpool set bootfs="$POOL/ROOT/default" "$POOL"
chmod 1777 "$TARGET/tmp" "$TARGET/var/tmp"
progress_count disk 2 3
diagnostics_begin "$TARGET" "$username" "${ssh_enable:-false}" /tmp/daemonarchy-install.log
progress_count disk 3 3

# ---------------------------------------------------------------- base system

phase base "Installing the FreeBSD base system"
expanded_sets=0
progress_count base 0 3
for set in base kernel lib32; do
  tar -xpf "$DIST/$set.txz" -C "$TARGET"
  expanded_sets=$((expanded_sets + 1))
  progress_count base "$expanded_sets" 3
done

# The signed firmware handoff below copies the verified private stage into
# the target. The driver enters through the ISO's kernel-bound package later.

# A private MacBook preview may carry a separately qualified EFI timer loader.
# Preserve it on the installed system only when its declared identity matches
# the live EFI loader; an ordinary image has no selection file.
timer_loader_identity=$ISO_SHARE/macbook-efi-timer-loader.sha256
if [[ $(kenv smbios.system.product 2>/dev/null || true) == MacBookPro16,1 &&
      -f $timer_loader_identity ]]; then
  read -r timer_loader_hash <"$timer_loader_identity"
  [[ $timer_loader_hash =~ ^[0-9a-f]{64}$ ]] &&
      [[ $(sha256 -q /boot/loader.efi) == "$timer_loader_hash" ]] || {
    echo 'The MacBook EFI timer loader differs from the staged selection.' >&2
    exit 1
  }
  install -m 0555 /boot/loader.efi "$TARGET/boot/loader.efi"
fi

# Recovery must work before the large desktop transaction. Create the selected
# account with the base shell; switch it to bash after packages are installed.
create_recovery_accounts "$TARGET" "$username" "${full_name:-$username}" <<<"$password_hash"
install_rescue_support "$TARGET" "$(dirname "$0")" /usr/local/sbin
secureboot_install_firmware "$TARGET"
secureboot_install_profile "$TARGET"
sync

phase loader "Installing the boot loader"
if ! $shared_install; then
  if [[ $image_arch == amd64 ]]; then
    install_bios_bootcode "$disk" "$TARGET"
  fi
  newfs_msdos -F 32 -c 1 -L DAEMONARCHY "$efi_dev" >/dev/null
fi
mkdir -p "$TARGET/boot/efi"
mount -t msdosfs "$efi_dev" "$TARGET/boot/efi"
write_efi_loader "$TARGET" "$POOL" "$shared_install" "$efi_boot_file"
if [[ $(sysctl -n machdep.bootmethod) == UEFI ]]; then
  # The qualified loader follows the pool's active BE; older loaders need the
  # existing explicit dataset selection, including on shared disks.
  efi_environment=$(efi_root_environment "$POOL" "$efi_pool_selector")
  if ! efibootmgr -a -c -l "$efi_loader" -L Daemonarchy -e "$efi_environment"; then
    if $shared_install; then
      echo "Could not register the Daemonarchy EFI entry. Existing boot loaders are preserved; installation cannot finish." >&2
      exit 1
    fi
    log "No EFI boot entry created; the firmware falls back to EFI/BOOT/$efi_boot_file"
  fi
fi
mkdir -p "$TARGET/var/db/daemonarchy"
cp "$layout_backup" "$TARGET/var/db/daemonarchy/partition-table.before"
rm -f "$layout_backup"
cp "$ISO_SHARE/brand-daemonarchy.lua" "$TARGET/boot/lua/"

# ---------------------------------------------------------------- configuration

phase config "Configuring the system"

# gpu_select has chosen the modules for the installed kernel, not the live one.

vt_keymap=$("$ISO_SHARE/keymap" vt "$keyboard")
read -r xkb_layout xkb_variant <<<"$("$ISO_SHARE/keymap" xkb "$keyboard")"

cat >"$TARGET/boot/loader.conf" <<EOF
zfs_load="YES"
autoboot_delay="3"
loader_logo="none"
loader_brand="daemonarchy"
kern.vty="vt"
kern.geom.label.gptid.enable="1"
EOF
if $macbook_bcm4364; then
  echo 'hw.hid.hkbd.no_leds="1"' >>"$TARGET/boot/loader.conf"
fi
[[ $encrypt_installation == true ]] && echo 'geom_eli_load="YES"' >>"$TARGET/boot/loader.conf"
# The boot chime and first-boot welcome; the sound choice carries over.
sound_install_target "$TARGET"

cat >"$TARGET/etc/rc.conf" <<EOF
hostname="$hostname"
zfs_enable="YES"
ntpd_enable="YES"
ntpd_sync_on_start="YES"
powerd_enable="YES"
dumpdev="AUTO"
clear_tmp_enable="YES"

# Omarchy's session: D-Bus, seat access, and the SDDM login.
dbus_enable="YES"
seatd_enable="YES"
sddm_enable="YES"
EOF
if $macbook_bcm4364; then
  echo 'kld_list="if_brcmfmac"' >>"$TARGET/etc/rc.conf"
fi
# A clock floor: T2 MacBooks reload the hardware clock from the T2 at every
# power-on (January 1970) and ignore what the system writes to it.
install -d -m 0755 "$TARGET/usr/local/etc/rc.d" "$TARGET/usr/local/etc/cron.d" "$TARGET/var/db/daemonarchy"
install -m 0555 "$ISO_SHARE/clock/daemonarchy_clock" "$TARGET/usr/local/etc/rc.d/daemonarchy_clock"
printf '# Record the time for daemonarchy_clock'"'"'s boot-time floor.\n*/15\t*\t*\t*\t*\troot\t/usr/local/etc/rc.d/daemonarchy_clock save\n' \
  >"$TARGET/usr/local/etc/cron.d/daemonarchy-clock"
touch "$TARGET/var/db/daemonarchy/clock"
# GPU modules are loaded by daemonarchy-graphics after SSH, not early kld.
[[ -n $vt_keymap ]] && echo "keymap=\"${vt_keymap%.kbd}\"" >>"$TARGET/etc/rc.conf"

[[ -n $swap_dev && $encrypt_installation == true ]] && swap_dev=$swap_dev.eli
cat >"$TARGET/etc/fstab" <<EOF
# Device               Mountpoint  FStype     Options  Dump  Pass
$efi_fstab             /boot/efi   msdosfs    rw       2     2
fdesc                  /dev/fd     fdescfs    rw       0     0
proc                   /proc       linprocfs  rw       0     0
EOF

if [[ -n $swap_dev ]]; then
  printf '%s none swap sw 0 0\n' "$swap_dev" >>"$TARGET/etc/fstab"
else
  # A shared-disk install does not borrow another OS's swap partition.
  sed -i '' 's/dumpdev="AUTO"/dumpdev="NO"/' "$TARGET/etc/rc.conf"
fi

# Omarchy's Hyprland input config reads the layout from /etc/vconsole.conf.
cat >"$TARGET/etc/vconsole.conf" <<EOF
XKBLAYOUT=$xkb_layout
XKBVARIANT=$xkb_variant
EOF

cp "$TARGET/usr/share/zoneinfo/$timezone" "$TARGET/etc/localtime"
echo "$timezone" >"$TARGET/var/db/zoneinfo"

# DNS servers the network check proved with a direct lookup. When the
# network's own DHCP servers did not answer, keep the working ones on the
# installed system too: DHCP renewals would otherwise restore the broken ones.
installed_resolver() {
  local server servers=()
  for server in ${net_dns//,/ }; do
    [[ $server =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] && servers+=("$server")
  done
  case ${net_dns_source:-} in
    public|user|configured)
      if ((${#servers[@]})); then
        printf 'nameserver %s\n' "${servers[@]}" >"$TARGET/etc/resolv.conf"
        local IFS=,
        printf 'supersede domain-name-servers %s;\n' "${servers[*]}" >>"$TARGET/etc/dhclient.conf"
        return 0
      fi
      ;;
  esac
  cp /etc/resolv.conf "$TARGET/etc/resolv.conf"
}

# DHCP at boot (NET-002): every dhclient runs in the background, so a port
# with a link but no DHCP server no longer holds devd(8) (which runs its
# actions one at a time) and delays the other interfaces' clients. Boot waits
# at most 10 seconds for the first usable connection, or 5 seconds when no
# DHCP interface has a carrier; a later lease or link still comes up after
# login. daemonarchy-netselect is the single owner of the default route and
# resolv.conf: the first interface whose gateway answers (and, if possible,
# whose DNS server answers) keeps them, and losing leases cannot overwrite it.
installed_boot_dhcp() {
  local src=$ISO_SHARE/netselect
  {
    echo
    echo '# Bounded boot with the first usable connection (daemonarchy-netselect).'
    echo 'background_dhclient="YES"'
    echo 'defaultroute_delay="10"'
    echo 'defaultroute_carrier_delay="5"'
  } >>"$TARGET/etc/rc.conf"
  install -d -m 0755 "$TARGET/usr/local/libexec" "$TARGET/usr/local/etc/devd" "$TARGET/usr/local/etc/newsyslog.conf.d"
  install -m 0555 "$src/daemonarchy-netselect" "$TARGET/usr/local/libexec/daemonarchy-netselect"
  install -m 0444 "$src/dhclient-enter-hooks" "$TARGET/etc/dhclient-enter-hooks"
  install -m 0444 "$src/dhclient-exit-hooks" "$TARGET/etc/dhclient-exit-hooks"
  install -m 0444 "$src/daemonarchy-netselect.conf" "$TARGET/usr/local/etc/devd/daemonarchy-netselect.conf"
  printf '/var/log/daemonarchy-net.log\t644\t3\t100\t*\tJC\n' >"$TARGET/usr/local/etc/newsyslog.conf.d/daemonarchy-net.conf"
}

# The Apple T2 controller's internal USB link (cdce on USB 05ac:8233, NET-001
# and NET-002) is never DHCP, a route or DNS: IPv6 link-local only, for the
# Touch ID bridge. Installed for every network mode; it does nothing on a
# machine without a T2.
installed_t2_link() {
  local src=$ISO_SHARE/netselect
  install -d -m 0755 "$TARGET/usr/local/libexec" "$TARGET/usr/local/etc/devd" "$TARGET/usr/local/etc/rc.conf.d/network"
  install -m 0555 "$src/daemonarchy-t2link" "$TARGET/usr/local/libexec/daemonarchy-t2link"
  install -m 0444 "$src/daemonarchy-t2link.conf" "$TARGET/usr/local/etc/devd/daemonarchy-t2link.conf"
  install -m 0444 "$src/daemonarchy-t2link.rc.conf" "$TARGET/usr/local/etc/rc.conf.d/network/daemonarchy-t2link"
}

installed_t2_link

# The network the installer used carries over. Wired DHCP (the default, and
# what an autoinstall without network settings gets) covers every Ethernet port,
# so a cable plugged in later just works; a static address stays on the port
# it was set on; Wi-Fi keeps the network that was joined.
case ${net_mode:-dhcp} in
  static)
    {
      echo
      echo "# Set by hand in the installer."
      printf 'ifconfig_%s="inet %s"\n' "$net_if" "$net_addr"
      printf 'defaultrouter="%s"\n' "$net_gw"
    } >>"$TARGET/etc/rc.conf"
    printf 'nameserver %s\n' ${net_dns//,/ } >"$TARGET/etc/resolv.conf"
    ;;
  wifi)
    {
      echo
      echo 'ifconfig_DEFAULT="DHCP"'
      printf 'wlans_%s="wlan0"\n' "$net_if"
      echo 'ifconfig_wlan0="WPA DHCP"'
    } >>"$TARGET/etc/rc.conf"
    installed_boot_dhcp
    umask 077
    if [[ -n ${wifi_enterprise_profile:-} ]]; then
      "$ISO_SHARE/omarchy-wifi-enterprise" --install "$TARGET" "$wifi_enterprise_profile"
    else
      wpa_network "$wifi_ssid" "${wifi_psk:-}" "${wifi_hidden:-false}" >"$TARGET/etc/wpa_supplicant.conf"
    fi
    umask 022
    installed_resolver
    ;;
  *)
    printf '\nifconfig_DEFAULT="DHCP"\n' >>"$TARGET/etc/rc.conf"
    installed_boot_dhcp
    installed_resolver
    ;;
esac

# ---------------------------------------------------------------- packages

phase fetch "Downloading Daemonarchy packages from pkg.FreeBSD.org"
# Restore the DNS servers the network check proved if a lease renewal on the
# live system replaced them.
"$(dirname "$0")/network-bringup" dns-ensure || true
mount -t devfs devfs "$TARGET/dev"

# Packages from the ISO take precedence: they carry the Omarchy ports and the
# GPU modules built for this kernel.
repos=$(mktemp -d)
cat >"$repos/repos.conf" <<EOF
FreeBSD: {
  url: "pkg+https://pkg.FreeBSD.org/\${ABI}/latest",
  mirror_type: "srv",
  signature_type: "fingerprints",
  fingerprints: "/usr/share/keys/pkg",
  enabled: yes
}
Daemonarchy: {
  url: "file://$REPO",
  signature_type: "none",
  priority: 10,
  enabled: yes
}
EOF
package_repository_write_dependencies "$repos/dependencies.conf" "$ISO_SHARE/daemonarchy.pub"
pkg_target() {
  ASSUME_ALWAYS_YES=yes IGNORE_OSVERSION=yes \
    pkg -r "$TARGET" -o REPOS_DIR="$repos" -o ABI="$ABI" "$@"
}
packages=(pkg bash sudo daemonarchy chromium octopkg wifi-firmware-kmod "${gpu_exact_packages[@]}" "${gpu_userspace_packages[@]}")
if $macbook_bcm4364; then
  packages+=(if_brcmfmac-kmod)
fi
pkg_target update -f
if [[ $package_repository_tag != "$package_repository_stable_tag" ]]; then
  pkg_target rquery -r Daemonarchy-Dependencies '%n' omarchy | grep -qx omarchy || {
    echo 'The signed candidate package repository is unavailable or invalid.' >&2
    exit 1
  }
fi

# A small first transaction makes console-approved remote rescue available
# even if the later desktop fetch/install is interrupted.
pkg_target install -y bash

# pkg's non-terminal output prints only dots while it downloads. Its event
# pipe reports the bytes received, which pkg-events turns into @@fetch lines in
# this log for the install screens. Without Python the fetch runs as before.
fetch_events_dir='' fetch_events_pid=''
fetch_events_start() {
  local python
  fetch_events_dir='' fetch_events_pid=''
  python=$(command -v python3.12 || command -v python3) || return 0
  fetch_events_dir=$(mktemp -d) || return 0
  mkfifo "$fetch_events_dir/pipe" || { rm -rf "$fetch_events_dir"; fetch_events_dir=''; return 0; }
  "$python" "$(dirname "$0")/pkg-events" "$fetch_events_dir/pipe" "$fetch_events_dir/ready" &
  fetch_events_pid=$!
  local tries
  for ((tries=0; tries<50; tries++)); do
    [[ -e $fetch_events_dir/ready ]] && return 0
    sleep 0.1
  done
  fetch_events_stop
}
fetch_events_stop() {
  if [[ -n $fetch_events_pid ]]; then
    if [[ -p $fetch_events_dir/pipe ]] && kill -0 "$fetch_events_pid" 2>/dev/null; then
      printf '{"type":"DAEMONARCHY_END"}\n' >"$fetch_events_dir/pipe" || kill "$fetch_events_pid" 2>/dev/null || true
    fi
    wait "$fetch_events_pid" 2>/dev/null || true
  fi
  [[ -z $fetch_events_dir ]] || rm -rf "$fetch_events_dir"
  fetch_events_dir='' fetch_events_pid=''
}
pkg_fetch_measured() {
  local status=0
  fetch_events_start
  if [[ -n $fetch_events_dir ]]; then
    pkg_target -o EVENT_PIPE="$fetch_events_dir/pipe" "$@" || status=$?
  else
    pkg_target "$@" || status=$?
  fi
  fetch_events_stop
  return "$status"
}

# A thousand downloads over a home connection will see the odd one fail.
# Fetch everything first, retrying: packages already in the cache are kept, so
# each attempt picks up where the last one stopped. Then install from the cache.
for attempt in 1 2 3 4 5; do
  if pkg_fetch_measured -o FETCH_TIMEOUT=60 fetch -d -y "${packages[@]}"; then
    break
  fi
  if (( attempt == 5 )); then
    echo "Downloading packages failed five times; check the network and try again." >&2
    exit 1
  fi
  log "Download interrupted; retrying ($((attempt + 1)) of 5)"
  sleep 10
done
phase install "Installing Daemonarchy packages"
pkg_target install -y "${packages[@]}"
if $macbook_bcm4364; then
  pkg_target info -e if_brcmfmac-kmod || { echo 'The BCM4364 driver package is missing.' >&2; exit 1; }
  [[ -f $TARGET/boot/modules/if_brcmfmac.ko &&
     $(sha256 -q "$TARGET/boot/modules/if_brcmfmac.ko") == $(sha256 -q /boot/modules/if_brcmfmac.ko) ]] || {
    echo 'The installed BCM4364 module differs from the live kernel-matched package.' >&2
    exit 1
  }
fi
if [[ $package_repository_tag != "$package_repository_stable_tag" ]]; then
  package_repository_finalize_dependencies pkg_target
fi

# Refuse resolver drift and keep kernel-bound packages together until a
# coordinated kernel/driver update, rather than taking a moving CURRENT kmod.
for gpu_package in "${gpu_exact_packages[@]}"; do
  pkg_target info -e "$gpu_package" || { echo "GPU package mismatch: $gpu_package" >&2; exit 1; }
done
pkg_target lock -y "${gpu_lock_packages[@]}"
if $macbook_bcm4364; then pkg_target lock -y if_brcmfmac-kmod; fi
secureboot_lock_modules
gpu_write_config "$TARGET"

# Scripts written for Omarchy (and most found online) start with #!/bin/bash.
# FreeBSD keeps bash in /usr/local, which is part of the root file system and
# of every boot environment, so a link in /bin is always good.
[[ -e $TARGET/bin/bash ]] || ln -s /usr/local/bin/bash "$TARGET/bin/bash"

# pkg -r gave files owned by accounts the packages create (messagebus,
# polkitd, cups, ...) to root:wheel, since the live system has none of them.
/usr/local/libexec/daemonarchy-installer/fix-ownership "$TARGET"

# pkg -r also ran the packages' triggers on the live system, which lacks the
# tools they call; rebuild their caches (GSettings schemas, GIO modules, ...)
# inside the target.
/usr/local/libexec/daemonarchy-installer/rebuild-caches "$TARGET"

# Updates to Daemonarchy's own packages come from its signed online
# repository (pkg-repo.sh), ahead of the base system's FreeBSD-ports
# repository (already "latest" on -CURRENT). The ISO's packages stay on the
# installed system as a fallback below it: the GPU and Wi-Fi modules built
# for this kernel are only there.
mkdir -p "$TARGET/var/db/daemonarchy" "$TARGET/usr/local/etc/pkg/repos" "$TARGET/usr/local/etc/pkg/keys"
cp -R "$REPO" "$TARGET/var/db/daemonarchy/repo"
cp "$ISO_SHARE/daemonarchy.pub" "$TARGET/usr/local/etc/pkg/keys/daemonarchy.pub"
cat >"$TARGET/usr/local/etc/pkg/repos/Daemonarchy.conf" <<EOF
Daemonarchy: {
  url: "https://github.com/jordanhubbard/daemonarchy/releases/download/$package_repository_tag",
  signature_type: "pubkey",
  pubkey: "/usr/local/etc/pkg/keys/daemonarchy.pub",
  priority: 10,
  enabled: yes
}
Daemonarchy-ISO: {
  url: "file:///var/db/daemonarchy/repo",
  signature_type: "none",
  priority: 5,
  enabled: yes
}
EOF

# Keep a release-pinned checkout catalogue and command for optional runtime use.
mkdir -p "$TARGET/usr/local/share/daemonarchy-installer"
cp "$ISO_SHARE/checkouts.json" "$TARGET/usr/local/share/daemonarchy-installer/checkouts.json"
install -m 0755 /usr/local/sbin/daemonarchy-checkouts "$TARGET/usr/local/sbin/daemonarchy-checkouts"
ln -sf ../sbin/daemonarchy-checkouts "$TARGET/usr/local/bin/daemonarchy-checkouts"
cuda_install_support "$TARGET" "$ISO_SHARE"
checkout_url=$(jq -er '.repository_url' "$ISO_SHARE/checkouts.json")
[[ $checkout_url =~ ^https://github.com/jordanhubbard/daemonarchy/releases/download/[a-zA-Z0-9._-]+$ ]] || { echo 'Invalid checkout repository URL' >&2; exit 1; }
cat >"$TARGET/usr/local/etc/pkg/repos/Daemonarchy-Checkouts.conf" <<EOF
Daemonarchy-Checkouts: {
  url: "$checkout_url",
  signature_type: "pubkey",
  pubkey: "/usr/local/etc/pkg/keys/daemonarchy.pub",
  enabled: yes
}
EOF

# ---------------------------------------------------------------- users

phase user "Configuring $username"
pw -R "$TARGET" usermod "$username" -s /usr/local/bin/bash

mkdir -p "$TARGET/usr/local/etc/sudoers.d"
echo '%wheel ALL=(ALL:ALL) ALL' >"$TARGET/usr/local/etc/sudoers.d/wheel"
chmod 0440 "$TARGET/usr/local/etc/sudoers.d/wheel"

home=$TARGET/home/$username
if [[ -n $full_name || -n $email_address ]]; then
  {
    echo "[user]"
    [[ -n $full_name ]] && printf '\tname = %s\n' "$full_name"
    [[ -n $email_address ]] && printf '\temail = %s\n' "$email_address"
  } >"$home/.gitconfig"
  chroot "$TARGET" chown "$username:$username" "/home/$username/.gitconfig"
fi

# As on the Arch ISO: an encrypted disk already asked for the password at
# boot, so log straight into Omarchy; otherwise SDDM asks.
if [[ $encrypt_installation == true ]]; then
  cat >"$TARGET/usr/local/etc/sddm.conf.d/20-daemonarchy-autologin.conf" <<EOF
[Autologin]
User=$username
Session=omarchy.desktop
Relogin=false
EOF
fi

# Omarchy's login theme has no user list: it signs in as the user SDDM last
# saw. On a fresh system there is none, so name the new user, as Omarchy's
# own first-boot setup does on Arch. FreeBSD's SDDM matches the session by its
# full path; a bare name falls back to the first session, plain Hyprland.
mkdir -p "$TARGET/var/lib/sddm"
printf '[Last]\nSession=/usr/local/share/wayland-sessions/omarchy.desktop\nUser=%s\n' "$username" >"$TARGET/var/lib/sddm/state.conf"
chroot "$TARGET" chown -R sddm:sddm /var/lib/sddm

# The working checkout belongs to the selected user. Seed packages own only
# immutable payloads; updates and removals cannot replace local source edits.
for checkout_kind in ports src; do
  [[ $checkout_kind == ports && $install_ports == true || $checkout_kind == src && $install_src == true ]] || continue
  phase checkouts "Installing the $checkout_kind Git checkout"
  chroot "$TARGET" /usr/local/sbin/daemonarchy-checkouts "$checkout_kind" "$username"
done

# ---------------------------------------------------------------- network services

if [[ $install_cuda == true ]]; then
  phase cuda "Installing CUDA and building cudalab"
  cuda_setup_started=true
  chroot "$TARGET" /usr/local/sbin/daemonarchy-linux-cuda setup
  chroot "$TARGET" /usr/local/sbin/daemonarchy-linux-cuda prepare-cudalab "$username"
  cuda_unmount_target "$TARGET"
  cuda_setup_started=false
fi

# Avahi comes with the printing tools; with it running the machine answers as
# <hostname>.local, and nss_mdns lets it find other .local machines.
if [[ -x $TARGET/usr/local/sbin/avahi-daemon ]]; then
  echo 'avahi_daemon_enable="YES"' >>"$TARGET/etc/rc.conf"
  if [[ -e $TARGET/usr/local/lib/nss_mdns.so ]]; then
    sed -i '' -E 's/^hosts:.*/hosts: files mdns dns/' "$TARGET/etc/nsswitch.conf"
  fi
fi

# Avahi's own package already advertises SSH; sshd itself runs only if asked.
if [[ ${ssh_enable:-false} == true ]]; then
  echo 'sshd_enable="YES"' >>"$TARGET/etc/rc.conf"
  # A reverse lookup of every client stalls logins when the DNS servers DHCP
  # hands out are slow or unreachable; a desktop has no use for it.
  echo 'UseDNS no' >>"$TARGET/etc/ssh/sshd_config"
fi

# ---------------------------------------------------------------- done

phase finish "Finishing up"
chroot "$TARGET" pw usershow "$username" >/dev/null
for package in daemonarchy omarchy sddm hyprland; do
  pkg_target info -e "$package" || { echo "Missing required desktop package: $package" >&2; exit 1; }
done
[[ -f $TARGET/var/lib/sddm/state.conf && -x $TARGET/usr/local/bin/bash ]]
secureboot_verify_target "$TARGET"
log "Checking installed package files and committing the target pool."
install_record_verified_completion "$POOL" "$diagnostics_dir/package-integrity.log" pkg_target
log "Installation configuration complete; exporting the target pool."
diagnostics_stop
umount "$TARGET/dev"
umount "$TARGET/boot/efi"
zpool export "$POOL"
diagnostics_ready=false
log "Daemonarchy is installed."
