#!/usr/bin/env python3
"""Turn pkg's event pipe into measured download lines for the install log.

  pkg-events FIFO [READY-FILE]

install starts this before `pkg -o EVENT_PIPE=FIFO fetch`; after pkg exits it
writes {"type":"DAEMONARCHY_END"} to the FIFO, and this exits once every
earlier event is read. pkg writes JSON events to the FIFO: INFO_FETCH_BEGIN/FINISHED with
the URL, and INFO_PROGRESS_TICK with the bytes received of the current file.
pkg's non-terminal output prints only dots, so these events are the measured
byte counts. Only package archives (URLs under /All/) are counted; repository
catalogues are not. Each line written is

  @@fetch {"schema":"daemonarchy/pkg-fetch@1","archives":N,"bytes":B,
           "file":NAME,"file_bytes":b,"file_total":t}

where archives and bytes cover archives pkg finished in this run, plus the
bytes of the one in progress. Lines are rate-limited to about four a second,
and every finished archive writes one.
"""
import json
import os
from pathlib import Path
import re
import sys
import time

SCHEMA = 'daemonarchy/pkg-fetch@1'


def archive_name(url):
    """tmux-3.8~2$tj6676a5.pkg -> tmux-3.8; None for anything but a package archive."""
    if not isinstance(url, str) or '/All/' not in url:
        return None
    base = url.rsplit('/', 1)[-1]
    if not base.endswith(('.pkg', '.txz', '.tzst')):
        return None
    name = re.sub(r'\.(pkg|txz|tzst)$', '', base).split('~', 1)[0]
    return ''.join(c for c in name if c.isascii() and c.isprintable())[:80] or None


class Converter:
    def __init__(self, write, clock=time.monotonic, interval=0.25):
        self.write, self.clock, self.interval = write, clock, interval
        self.archives = 0
        self.done_bytes = 0
        self.file = None
        self.file_bytes = 0
        self.file_total = 0
        self.last = float('-inf')

    def emit(self, force=False):
        now = self.clock()
        if not force and now - self.last < self.interval:
            return
        self.last = now
        row = dict(schema=SCHEMA, archives=self.archives, bytes=self.done_bytes + self.file_bytes,
                   file=self.file or '', file_bytes=self.file_bytes, file_total=self.file_total)
        self.write('@@fetch ' + json.dumps(row, separators=(',', ':')) + '\n')

    def event(self, event):
        if not isinstance(event, dict):
            return
        kind, data = event.get('type'), event.get('data') or {}
        if kind == 'INFO_FETCH_BEGIN':
            self.file = archive_name(data.get('url'))
            self.file_bytes = self.file_total = 0
            if self.file:
                self.emit(force=True)
        elif kind == 'INFO_PROGRESS_TICK' and self.file:
            current, total = data.get('current'), data.get('total')
            if type(current) is int and type(total) is int and 0 <= current <= total and current >= self.file_bytes:
                self.file_bytes, self.file_total = current, total
                self.emit()
        elif kind == 'INFO_FETCH_FINISHED':
            if self.file and archive_name(data.get('url')) == self.file:
                self.archives += 1
                self.done_bytes += self.file_total or self.file_bytes
                self.file, self.file_bytes, self.file_total = None, 0, 0
                self.emit(force=True)
            self.file = None


def events(chunks):
    """JSON objects from a byte stream. pkg's messages may hold raw newlines."""
    decoder = json.JSONDecoder(strict=False)
    buffer = ''
    for chunk in chunks:
        buffer += chunk.decode('utf-8', 'replace')
        while True:
            start = buffer.find('{')
            if start < 0:
                buffer = ''
                break
            try:
                value, end = decoder.raw_decode(buffer, start)
            except json.JSONDecodeError:
                if len(buffer) - start > 1 << 20:
                    buffer = buffer[start + 1:]  # Skip a damaged event.
                    continue
                buffer = buffer[start:]
                break
            buffer = buffer[end:]
            yield value


def main(argv):
    if len(argv) not in (2, 3):
        print(__doc__, file=sys.stderr)
        return 2
    # Read and write: pkg may open and close the FIFO; reading never sees an
    # end of file, and install stops this process when pkg is done.
    fd = os.open(argv[1], os.O_RDWR)
    if len(argv) == 3:
        Path(argv[2]).touch()

    def chunks():
        while True:
            data = os.read(fd, 65536)
            if not data:
                return
            yield data

    def write(text):
        sys.stdout.write(text)
        sys.stdout.flush()
    converter = Converter(write)
    try:
        for event in events(chunks()):
            if isinstance(event, dict) and event.get('type') == 'DAEMONARCHY_END':
                break  # install's marker after pkg exited: every earlier event is read.
            converter.event(event)
    except (KeyboardInterrupt, BrokenPipeError):
        pass
    return 0


if __name__ == '__main__':
    import signal
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    raise SystemExit(main(sys.argv))
