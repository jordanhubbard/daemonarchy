#!/usr/local/bin/bash
# Console-approved SSH pairing for the live installer and installed systems.
set -euo pipefail
source "$(dirname "$0")/network-addresses"
state=/var/run/daemonarchy-remote-debug
self=/usr/local/libexec/daemonarchy-installer/remote-debug

fail() { echo "Remote debug: $*" >&2; exit 1; }

write_progress() {
  local message=$1 temporary
  [[ $(id -u) == 0 && -f $state/active ]] || fail 'No active remote debug session.'
  temporary=$(mktemp "$state/.progress.XXXXXX")
  printf '%s\n' "$message" >"$temporary"
  mv "$temporary" "$state/progress"
}

debug_activity() {
  local message
  # Keep terminal escapes, control characters and long command output off the console.
  message=$(printf '%s' "$*" | LC_ALL=C tr '\n\r\t' '   ' | LC_ALL=C tr -cd '\040-\176' | cut -c 1-160)
  [[ -n ${message// /} ]] || fail 'Describe the current activity.'
  write_progress "Activity: $message"
}

debug_session() {
  [[ -f $state/active ]] || fail 'Remote access has stopped.'
  start_observer
  # ForceCommand runs only after successful authentication, including reconnects.
  if mkdir "$state/connected" 2>/dev/null; then
    write_progress 'Agent connected successfully. Remote debugging is under way.'
  fi
  case ${SSH_ORIGINAL_COMMAND:-} in
    '') exec /bin/sh -l ;;
    internal-sftp) exec /usr/libexec/sftp-server ;;
    *) exec /bin/sh -c "$SSH_ORIGINAL_COMMAND" ;;
  esac
}

start_observer() {
  local observer=${self%/*}/debug-observe generation
  [[ -x $observer ]] || return 0
  generation=$(cat "$state/generation")
  if ! lockf -k -s -t 5 "$state/observer.lock" "$self" _observe-start "$generation"; then
    echo 'Remote debug: diagnostics collector failed; inspect observer-startup.log or run snapshot.' >&2
  fi
}

create_observer() {
  local expected=$1 observer=${self%/*}/debug-observe pid='' command=''
  [[ -f $state/active && -f $state/generation && $(cat "$state/generation") == "$expected" ]] || return 1
  if [[ -f $state/observer.pid ]]; then IFS= read -r pid <"$state/observer.pid" || true; fi
  if [[ $pid =~ ^[0-9]+$ ]] && ((pid > 1)); then
    command=$(ps -p "$pid" -o command= 2>/dev/null) || command=''
    if [[ $command == *"$observer collect $state $expected" ]] && kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
  fi
  # A dead collector can be restarted; a reused PID is never signaled.
  umask 077
  nohup "$observer" collect "$state" "$expected" </dev/null >>"$state/observer-startup.log" 2>&1 &
  pid=$!
  printf '%s\n' "$pid" >"$state/observer.pid"
  sleep 1
  kill -0 "$pid" 2>/dev/null
}

show_progress() {
  local progress
  if [[ -f $state/progress ]]; then
    progress=$(cat "$state/progress")
    if [[ $progress != "${last_progress:-}" ]]; then
      printf '\n%s\n' "$progress"
      last_progress=$progress
    fi
  fi
}

authorize() {
  local type=$1 key=$2 fingerprint=$3 request temporary i
  [[ -d $state/requests && -f $state/active ]] || exit 1
  request=$(printf '%s %s' "$type" "$key" | sha256 -q)
  if [[ ! -f $state/requests/$request ]]; then
    temporary=$(mktemp "$state/requests/.pending.XXXXXX")
    printf '%s\n%s %s\n' "$fingerprint" "$type" "$key" >"$temporary"
    mv "$temporary" "$state/requests/$request"
  fi
  for ((i=0; i<120; i++)); do
    [[ -f $state/active ]] || exit 1
    [[ ! -f $state/$request.denied ]] || exit 1
    if [[ -f $state/$request.approved ]]; then
      printf '%s %s\n' "$type" "$key"
      return
    fi
    sleep 1
  done
  return 1
}

session_transition() {
  local operation=$1 result
  shift
  [[ $(id -u) == 0 && $(uname -s) == FreeBSD ]] || fail 'Requires a FreeBSD root console.'
  [[ ! -L $state.lock ]] || fail 'Refusing a symlinked session lock.'
  if lockf -k -s -t 5 "$state.lock" "$self" "_$operation" "$@"; then
    return 0
  else
    result=$?
    ((result != 75)) || fail 'Another debug session operation is in progress. Try again.'
    return "$result"
  fi
}

stop_session() {
  local expected=$1 pid='' command=''
  [[ -e $state || -L $state ]] || return 0
  [[ -d $state && ! -L $state && -O $state ]] || fail 'Refusing unsafe debug session state.'
  if [[ $expected != any ]]; then
    [[ -f $state/generation && $(cat "$state/generation") == "$expected" ]] || return 0
  fi
  if [[ -f $state/sshd.pid && ! -L $state/sshd.pid ]]; then
    IFS= read -r pid <"$state/sshd.pid" || true
  fi
  if [[ $pid =~ ^[0-9]+$ ]] && ((pid > 1)); then
    command=$(ps -p "$pid" -o command= 2>/dev/null) || command=''
  fi
  # A reboot can leave a PID file whose number now belongs to another process.
  # Only our exact listener configuration grants permission to signal it.
  [[ $command == *"/usr/sbin/sshd -D -E $state/sshd.log -f $state/sshd_config"* ]] || pid=''
  # Revocation must complete even when this command disconnects its own SSH.
  trap '' HUP INT TERM
  rm -rf "$state"
  if [[ -n $pid ]]; then
    pkill -TERM -P "$pid" 2>/dev/null || true
    kill -TERM "$pid" 2>/dev/null || true
  fi
}

stop_server() {
  [[ -n ${session_generation:-} ]] || return 0
  session_transition stop "$session_generation" >/dev/null 2>&1 || true
}

validate_server_start() {
  local port=$1
  [[ $(id -u) == 0 && $(uname -s) == FreeBSD ]] || fail 'Requires a FreeBSD root console.'
  if [[ ! $port =~ ^[0-9]{1,5}$ ]] || ((10#$port < 1 || 10#$port > 65535)); then
    fail 'Port must be 1–65535.'
  fi
  port=$((10#$port))
  network_has_address || fail 'No usable IPv4 address. Configure the network from the debug shell, then retry remote-debug listen.'
}

create_server() {
  local port=$1
  validate_server_start "$port"
  port=$((10#$port))
  [[ ! -e $state ]] || fail 'Another debug session is already active.'
  # A locked root account also prevents public-key authentication.
  [[ $(awk -F: '$1 == "root" {print $2}' /etc/master.passwd) != '*' ]] || fail 'Root account is locked.'
  umask 077
  mkdir -p "$state/requests"
  session_generation=$BASHPID-$RANDOM-$RANDOM
  printf '%s\n' "$session_generation" >"$state/generation"
  trap 'result=$?; if ((result != 0)); then stop_session "$session_generation"; fi' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM HUP
  ssh-keygen -q -t ed25519 -N '' -f "$state/host_key"
  cat >"$state/sshd_config" <<EOF
Port $port
HostKey $state/host_key
PidFile $state/sshd.pid
AuthorizedKeysFile none
AuthorizedKeysCommand $self authorize %t %k %f
AuthorizedKeysCommandUser root
PermitRootLogin prohibit-password
AllowUsers root
AuthenticationMethods publickey
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM no
StrictModes yes
UseDNS no
LoginGraceTime 150
MaxStartups 3:30:10
AllowAgentForwarding no
AllowTcpForwarding no
X11Forwarding no
Subsystem sftp internal-sftp
ForceCommand $self session
EOF
  /usr/sbin/sshd -t -f "$state/sshd_config"
  touch "$state/active"
  /usr/sbin/sshd -D -E "$state/sshd.log" -f "$state/sshd_config" </dev/null >>"$state/sshd.log" 2>&1 &
  server_pid=$!
  sleep 1
  if ! kill -0 "$server_pid" 2>/dev/null; then
    cat "$state/sshd.log" >&2
    fail "Cannot listen on port $port; choose another port."
  fi
  printf '%s\n%s\n' "$session_generation" "$server_pid"
}

start_server() {
  local result
  validate_server_start "$1"
  result=$(session_transition start "$1") || return
  # Carry this session's identity out of the locked startup. Reading it from
  # the shared path later could pick up a freshly paired replacement instead.
  session_generation=${result%%$'\n'*}
  server_pid=${result#*$'\n'}
  trap stop_server EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM HUP
}

debug_unpair() {
  session_transition stop any || return
  echo 'Remote debugging agent unpaired. Remote access and pairing state have been cleared.'
}

show_status() {
  echo 'Daemonarchy remote debug mode'
  echo
  echo 'Pairing does not start an installation. Approved agents get a root shell.'
  echo 'Tell your agent this IP address and port:'
  network_addresses | awk -v port="$port" '{print "  ssh -p " port " root@" $1}'
  echo
  echo 'Server fingerprint:'
  ssh-keygen -l -f "$state/host_key.pub"
  echo
  echo 'The agent should use a temporary SSH key and tell you its fingerprint.'
  echo 'Approve only the matching fingerprint when the pairing request appears.'
  echo 'Waiting for an authenticated agent. Connection and progress will appear here.'
  echo 'Press Enter to stop remote access and return to the debug shell.'
}

debug_listen() {
  local port=${1:-2222} request fingerprint answer last_progress=''
  echo "Pairing grants the approved agent root access until you stop this listener."
  printf 'Enable remote access on port %s? [y/N] ' "$port"
  IFS= read -r answer || return 0
  [[ $answer == y || $answer == Y ]] || return 0
  start_server "$port"
  show_status
  while kill -0 "$server_pid" 2>/dev/null; do
    show_progress
    for request in "$state"/requests/*; do
      [[ -f $request ]] || continue
      [[ ! -e $state/${request##*/}.approved && ! -e $state/${request##*/}.denied ]] || continue
      fingerprint=$(head -n 1 "$request")
      printf '\nAgent pairing request: %s\n' "$fingerprint"
      printf 'Does this match the fingerprint your agent gave you? [y/N] '
      answer=""
      IFS= read -r answer || return 0
      if [[ $answer == y || $answer == Y ]]; then
        touch "$state/${request##*/}.approved"
      else
        touch "$state/${request##*/}.denied"
      fi
      show_status
    done
    if IFS= read -r -t 1; then
      break
    fi
  done
}

debug_help() {
  cat <<'HELP'
Daemonarchy debug shell (root). Networking is not required to use this shell.
Opening this shell does not start an installation or remote listener.

Inspect hardware and networking:
  ifconfig -a
  usbconfig
  pciconf -lv
  sysctl net.wlan.devices
  dmesg | less

Request an address (replace ue0 with the correct interface):
  dhclient ue0

For Wi-Fi, use ifconfig to create wlan0 on a supported wireless adapter,
configure /tmp/wpa_supplicant.conf, then run:
  wpa_supplicant -B -i wlan0 -c /tmp/wpa_supplicant.conf
  dhclient wlan0

Start console-approved remote access after networking works:
  remote-debug listen          # port 2222
  remote-debug listen 2207     # custom port
  remote-debug unpair          # revoke access, including a stale session

From an approved SSH connection, report brief progress and explicit completion:
  daemonarchy-debug activity 'Checking Wi-Fi connectivity'
  daemonarchy-debug observe    # stream kernel, process and system diagnostics
  daemonarchy-debug snapshot   # one bounded read-only system snapshot
  daemonarchy-debug done

Disconnecting SSH does not mark the debugging task complete. Completion leaves
access enabled until the console operator stops the listener.

The listener asks before enabling access and before pairing each new key.
Press Enter or Ctrl-C in the listener to stop it and return to this shell.
Run help (or remote-debug help) to show these debugging instructions again.
Use help <builtin> for Bash help, for example: help cd.
The exit command returns to the invoking console or installer.
HELP
}

debug_shell() {
  debug_help
  PATH="$(dirname "$self"):$PATH"
  export PATH
  help() {
    if (($# == 0)); then
      remote-debug help
    else
      builtin help "$@"
    fi
  }
  export -f help
  PS1='daemonarchy-debug# ' /usr/local/bin/bash --noprofile --norc -i
}

case ${1:-shell} in
  _observe-start) [[ $# == 2 && $(id -u) == 0 ]] || exit 1; create_observer "$2" ;;
  _start) [[ $# == 2 ]] || exit 1; create_server "$2" ;;
  _stop) [[ $# == 2 && $(id -u) == 0 ]] || exit 1; stop_session "$2" ;;
  authorize) [[ $# == 4 ]] || exit 1; authorize "$2" "$3" "$4" ;;
  session) [[ $# == 1 ]] || exit 1; debug_session ;;
  activity) shift; debug_activity "$@" ;;
  observe|snapshot)
    [[ $# == 1 && $(id -u) == 0 && -f $state/active ]] || fail 'Requires an active root debug session.'
    start_observer
    action=stream; [[ $1 != snapshot ]] || action=snapshot
    exec "${self%/*}/debug-observe" "$action" "$state" ;;
  done) [[ $# == 1 ]] || fail 'Usage: remote-debug done'; write_progress 'Remote debugging complete. It is OK to stop this session (press Enter).' ;;
  shell|menu) debug_shell ;;
  listen) [[ $# -le 2 ]] || fail 'Usage: remote-debug listen [port]'; debug_listen "${2:-2222}" ;;
  unpair) [[ $# == 1 ]] || fail 'Usage: remote-debug unpair'; debug_unpair ;;
  help) debug_help ;;
  *) fail 'Usage: remote-debug [shell | listen [port] | unpair | observe | snapshot | activity DESCRIPTION | done | help]' ;;
esac
