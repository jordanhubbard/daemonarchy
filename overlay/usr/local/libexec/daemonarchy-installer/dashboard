#!/usr/local/bin/bash
# The viewer never installs packages or writes the install's result file.
set -u
# install-screen runs it as window 0 of the installer's tmux session when
# tmux and a capable terminal are present, and directly otherwise.
for python in python3.12 python3; do
  if command -v "$python" >/dev/null 2>&1; then
    DAEMONARCHY_PYTHON=$(command -v "$python") exec "$BASH" "$(dirname "$0")/install-screen" "$@"
  fi
done
# Keep the installer visible if the live image has lost its Python interpreter.
# Wait for the real owner result and preserve it; never invent a progress meter.
log=$1
status_file=$2
printf 'Installer progress (plain fallback; Python unavailable)\n'
tail -n +1 -f "$log" &
reader=$!
trap 'kill "$reader" 2>/dev/null || true; wait "$reader" 2>/dev/null || true' EXIT
while [[ ! -s $status_file ]]; do sleep 0.5; done
status=$(<"$status_file")
[[ $status =~ ^[0-9]{1,3}$ ]] && ((10#$status <= 255)) || status=1
printf '\nInstaller exited with status %s; full log: %s\n' "$status" "$log"
exit "$status"
