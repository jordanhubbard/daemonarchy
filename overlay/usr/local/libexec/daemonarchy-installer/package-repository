# The image selects its signed application feed. Candidate installations must
# keep using that feed without publishing over the stable repository. Each
# architecture has its own feed family, packages-16-<arch>; an image never
# selects another architecture's feed.
package_repository_architecture() { # FreeBSD package ABI
    case "$1" in
        FreeBSD:16:amd64) echo amd64 ;;
        FreeBSD:16:aarch64) echo aarch64 ;;
        *) echo 'Unsupported Daemonarchy package ABI' >&2; return 1 ;;
    esac
}

package_repository_tag_validate() { # tag [architecture, default amd64]
    case "$1" in
        packages-16-"${2:-amd64}"|packages-16-"${2:-amd64}"-?*) ;;
        *) echo 'Invalid Daemonarchy package repository tag' >&2; return 1 ;;
    esac
    case "$1" in
        *[!A-Za-z0-9._-]*) echo 'Invalid Daemonarchy package repository tag' >&2; return 1 ;;
    esac
}

package_repository_prepare() {
    package_repository_arch=amd64
    if [ -e "$1/ABI" ]; then
        package_repository_arch=$(package_repository_architecture "$(cat "$1/ABI")") || return 1
    fi
    package_repository_stable_tag=packages-16-$package_repository_arch
    package_repository_tag=$package_repository_stable_tag
    if [ -e "$1/package-repository-tag" ]; then
        package_repository_tag=$(cat "$1/package-repository-tag") || return 1
    fi
    package_repository_tag_validate "$package_repository_tag" "$package_repository_arch"
}

# A self-hosted, signed snapshot of the upstream packages (PKG-002): shards of a
# GitHub release feed, one URL per line in the image's package-mirror file. pkg.
# FreeBSD.org's `latest` moves under an image (it dropped a package one day after
# a release), so an image that carries a mirror list prefers the snapshot it was
# built against and keeps pkg.FreeBSD.org only as the fallback. A shard that does
# not answer is left out, never fatal. No list, no mirror, no change.
package_mirror_probe() { # URL: does the shard's catalogue answer? (three tries: one dropped connection is not "down")
    local try
    for try in 1 2 3; do
        fetch -q -T 20 -o /dev/null "$1/meta.conf" && return 0
        sleep 2
    done
    return 1
}

package_repository_write_mirror() { # conf-file public-key mirror-list-file [architecture, default amd64]
    [ -s "$3" ] || return 0
    local url number=0 arch=${4:-amd64}
    while IFS= read -r url; do
        [ -n "$url" ] || continue
        case "$url" in
            https://github.com/jordanhubbard/daemonarchy/releases/download/packages-16-"$arch"-?*) ;;
            *) echo 'Ignoring a package mirror URL that is not one of ours' >&2; continue ;;
        esac
        case "${url##*/}" in
            *[!A-Za-z0-9._-]*) echo 'Ignoring an invalid package mirror URL' >&2; continue ;;
        esac
        if ! package_mirror_probe "$url"; then
            echo "Package mirror ${url##*/} did not answer; using pkg.FreeBSD.org for its packages" >&2
            # Recorded in the file so package_repository_freebsd_enabled keeps pkg.FreeBSD.org on for what this shard carried.
            printf '# a package mirror shard did not answer\n' >>"$1"
            continue
        fi
        number=$((number + 1))
        cat >>"$1" <<EOF
Daemonarchy-Mirror-$number: {
  url: "$url",
  signature_type: "pubkey",
  pubkey: "$2",
  priority: 5,
  enabled: yes
}
EOF
    done <"$3"
    return 0
}

# Whether the install transaction may use pkg.FreeBSD.org: pkg takes the newest version of a
# package across repositories (priority breaks ties only), so with it enabled a snapshot shard
# that answered would lose packages to whatever `latest` carries that day. The mirror file the
# transaction writes names the shards that answered; none, and the upstream repository stays on.
# It stays on too when any shard did NOT answer: the packages that shard carries have no other
# source, and an install that loses one of two shards must fall back for those, not fail.
# Only the transaction's own repository directory is affected: the installed system keeps its
# default FreeBSD repository for updates.
package_repository_freebsd_enabled() { # mirror-conf-file
    if grep -q '^Daemonarchy-Mirror-' "$1" 2>/dev/null && ! grep -q '^# a package mirror shard did not answer' "$1"; then
        echo no
    else
        echo yes
    fi
}

package_repository_write_dependencies() {
    package_repository_tag_validate "$package_repository_tag" "${package_repository_arch:-amd64}" || return 1
    [ "$package_repository_tag" != "packages-16-${package_repository_arch:-amd64}" ] || return 0
    package_cache_validate || return 1
    package_dependency_url="https://github.com/jordanhubbard/daemonarchy/releases/download/$package_repository_tag"
    [ -z "${package_cache_url:-}" ] || package_dependency_url=$package_cache_url
    cat >"$1" <<EOF
Daemonarchy-Dependencies: {
  url: "$package_dependency_url",
  signature_type: "pubkey",
  pubkey: "$2",
  priority: 9,
  enabled: yes
}
EOF
}

package_repository_finalize_dependencies() {
    package_repository_installed=$("$@" query '%n %R') || return 1
    printf '%s\n' "$package_repository_installed" |
    while read -r package repository; do
        if [ "$repository" = Daemonarchy-Dependencies ]; then
            "$@" annotate -y -M "$package" repository Daemonarchy || exit 1
        fi
    done
}

# An explicitly selected iterative transport retains native public-key validation.
# Installed production configuration always uses the public versioned feed.
package_cache_validate() {
    case "${package_qa_mode:-iterative}" in
        iterative) ;;
        final-rc)
            # Any override field, even a pin without a URL, refuses: final QA
            # must use the public versioned feed and its native verification.
            [ -z "${package_cache_url:-}${package_cache_meta_sha256:-}${package_cache_packagesite_sha256:-}${package_cache_data_sha256:-}" ] || {
                echo 'Final RC QA rejects a local package cache override' >&2; return 1;
            } ;;
        *) echo 'Invalid package QA mode' >&2; return 1 ;;
    esac
    [ -n "${package_cache_url:-}" ] || return 0
    printf '%s\n' "$package_cache_url" | LC_ALL=C grep -Eq '^https?://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~-]+)*$' || {
        echo 'Invalid iterative package cache URL' >&2; return 1;
    }
    case "$package_cache_url" in *'/..'*|*'/.'|*'//'*'//'*) echo 'Unsafe cache URL path' >&2; return 1 ;; esac
    for cache_pin in "${package_cache_meta_sha256:-}" "${package_cache_packagesite_sha256:-}" "${package_cache_data_sha256:-}"; do
        [ "${#cache_pin}" = 64 ] || { echo 'Cache requires exact selected metadata SHA-256 pins' >&2; return 1; }
        case "$cache_pin" in *[!0-9a-f]*) echo 'Malformed cache metadata SHA-256' >&2; return 1 ;; esac
    done
}

package_cache_check_metadata() {
    package_cache_validate || return 1
    [ -n "${package_cache_url:-}" ] || return 0
    # Retain each attempt in a fresh directory, including failed/corrupt metadata.
    cache_metadata=$(mktemp -d /tmp/daemonarchy-cache-metadata.XXXXXXXX) || return 1
    for cache_file in meta.conf packagesite.pkg data.pkg; do
        case "$cache_file" in
            meta.conf) cache_expected=$package_cache_meta_sha256 ;;
            packagesite.pkg) cache_expected=$package_cache_packagesite_sha256 ;;
            data.pkg) cache_expected=$package_cache_data_sha256 ;;
        esac
        fetch -q -T 30 -o "$cache_metadata/$cache_file" "$package_cache_url/$cache_file" || return 1
        [ "$(sha256 -q "$cache_metadata/$cache_file")" = "$cache_expected" ] || {
            echo "Iterative cache selected metadata mismatch: $cache_file" >&2; return 1;
        }
    done
    printf '%s\n' 'Iterative package cache metadata pins verified; native signature verification follows.'
}
