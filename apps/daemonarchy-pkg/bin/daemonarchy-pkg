#!/usr/bin/env python3
import os
import sys

# The package installs the module next to the launcher in ../lib/daemonarchy-pkg; a checkout has it at ..
here = os.path.dirname(os.path.realpath(__file__))
for candidate in (os.path.join(here, '..'), os.path.join(here, '..', 'lib', 'daemonarchy-pkg')):
    if os.path.isdir(os.path.join(candidate, 'daemonarchy_pkg')):
        sys.path.insert(0, candidate)
        break

from daemonarchy_pkg import cli

if __name__ == '__main__':
    raise SystemExit(cli.main())
