#!/usr/bin/env python3
"""Runs an approved package plan as root; see daemonarchy_pkg/transaction.py."""
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
for candidate in (os.path.join(here, '..'), os.path.join(here, '..', 'lib', 'daemonarchy-pkg')):
    if os.path.isdir(os.path.join(candidate, 'daemonarchy_pkg')):
        sys.path.insert(0, candidate)
        break

from daemonarchy_pkg import transaction

if __name__ == '__main__':
    raise SystemExit(transaction.main())
