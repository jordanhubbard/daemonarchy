+#ifdef EFI_ZFS_BOOT
+	/* Select this pool's active BE, rather than pinning a dataset forever. */
+	rootdev = getenv("daemonarchy_rootpool");
+	if (rootdev != NULL) {
+		char *end;
+		uint64_t pool_guid;
+
+		errno = 0;
+		pool_guid = strtoull(rootdev, &end, 10);
+		if (*rootdev < '0' || *rootdev > '9' || *end != '\0' ||
+		    errno == ERANGE || pool_guid == 0 ||
+		    !probe_zfs_currdev(pool_guid)) {
+			printf("Configured Daemonarchy ZFS boot pool is unavailable\n");
+			return (ENXIO);
+		}
+		return (0);
+	}
+#endif
 
